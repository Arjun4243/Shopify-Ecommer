{% doc %}
Renders the product grid for the semi precious page.
@param {string} section_id - The parent section id.
@example
{% render 'semi-precious-products', section_id: section.id %}
{% enddoc %}

{% liquid
  assign semi_products_collection = collections.all
  assign semi_products_group = 'semi-precious'
  assign semi_products_limit = 8
  assign rendered_products_count = 0
  assign quick_add_enabled = false
  if settings.quick_add or settings.mobile_quick_add
    assign quick_add_enabled = true
  endif
%}

<script>
  console.log('Semi precious page handle:', {{ page.handle | json }});
  console.log('Semi precious product group filter:', {{ semi_products_group | json }});
  console.log('Semi precious product source collection:', {{ semi_products_collection.handle | json }});
</script>

{% render 'resource-list-styles' %}
{% render 'product-card-styles' %}
{% render 'product-badges-styles' %}

{% if semi_products_collection != blank and semi_products_collection.products_count > 0 %}
  <section class="semi-products section-resource-list" aria-label="Semi precious gemstone products">
    <div class="section-resource-list__header semi-products__header">
      <div>
        <p class="semi-products__eyebrow">Products</p>
        <h2>Semi-precious products</h2>
      </div>
      <a href="{{ routes.all_products_collection_url }}">View all</a>
    </div>

    <div
      class="resource-list resource-list--grid semi-products__grid"
      data-testid="semi-products-grid"
    >
      {% paginate semi_products_collection.products by 250 %}
        {% for product in semi_products_collection.products %}
          {% liquid
            assign product_group = product.metafields.custom.gemstone_group.value | default: product.metafields.custom.gemstone_group
            assign product_group_handle = product_group | handleize
          %}
          {% if product_group_handle == semi_products_group and rendered_products_count < semi_products_limit %}
            {% assign rendered_products_count = rendered_products_count | plus: 1 %}
            <div class="resource-list__item">
            <product-card class="product-card semi-product-card" data-product-id="{{ product.id }}">
              <div class="product-card__content product-grid__card semi-product-card__content">
                <div class="semi-product-card__media">
                  <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                    {% if product.featured_media.preview_image != blank %}
                      {{
                        product.featured_media.preview_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '300, 450, 600, 750, 900',
                          sizes: '(min-width: 1000px) 25vw, (min-width: 750px) 33vw, 50vw',
                          alt: product.title,
                          class: 'semi-product-card__image'
                      }}
                    {% else %}
                      {{ 'product-apparel-1' | placeholder_svg_tag: 'semi-product-card__placeholder' }}
                    {% endif %}
                  </a>

                  {% if product.available == false or product.compare_at_price > product.price %}
                    <div
                      class="product-badges product-badges--top-right"
                      style="
                        --badge-border-radius: {{ settings.badge_corner_radius }}px;
                        --badge-font-family: var(--font-{{ settings.badge_font_family }}--family);
                        --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight);
                        --badge-text-transform: {{ settings.badge_text_transform }};
                      "
                    >
                      <div class="product-badges__badge product-badges__badge--rectangle {% if product.available == false %}color-custom-badge-sold-out{% else %}color-custom-badge-sale{% endif %}">
                        {% if product.available == false %}
                          {{ 'content.product_badge_sold_out' | t }}
                        {% else %}
                          {{ 'content.product_badge_sale' | t }}
                        {% endif %}
                      </div>
                    </div>
                  {% endif %}

                  {% if product.available and quick_add_enabled %}
                    {% render 'quick-add', product: product, section_id: section_id %}
                  {% endif %}
                </div>

                <a class="semi-product-card__title" href="{{ product.url }}">
                  {{ product.title }}
                </a>
                <div class="semi-product-card__price">
                  {% render 'price', product_resource: product, show_sale_price_first: true %}
                </div>
              </div>
            </product-card>
            </div>
          {% endif %}
        {% endfor %}
      {% endpaginate %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .semi-products {
    width: min(100%, 1680px);
    margin: 0 auto;
    padding: 48px 6%;
    background: #fffdf9;
  }

  .semi-products__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 20px;
  }

  .semi-products__header h2,
  .semi-products__eyebrow {
    margin: 0;
  }

  .semi-products__eyebrow {
    color: #8a8175;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .semi-products__header h2 {
    margin-top: 6px;
    color: #1c1713;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(26px, 2.2vw, 40px);
    line-height: 1.12;
  }

  .semi-products__header > a {
    color: #b5802a;
    font-weight: 800;
    text-decoration: none;
  }

  .semi-products__grid {
    --resource-list-column-gap-desktop: 18px;
    --resource-list-row-gap-desktop: 28px;
    --resource-list-columns: repeat(4, minmax(0, 1fr));
    --resource-list-columns-mobile: repeat(2, minmax(0, 1fr));
  }

  .semi-product-card__content {
    gap: 10px;
  }

  .semi-product-card__media {
    position: relative;
    overflow: hidden;
    border: 1px solid #eee7dc;
    background: #fbfaf7;
  }

  .semi-product-card__media a {
    display: block;
  }

  .semi-product-card__image,
  .semi-product-card__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .semi-product-card__title {
    color: #302821;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
  }

  .semi-product-card__price {
    color: #5c554d;
    font-size: 14px;
    font-weight: 700;
  }

  @media screen and (max-width: 1000px) {
    .semi-products__grid {
      --resource-list-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 640px) {
    .semi-products {
      padding: 36px 18px;
    }

    .semi-products__header {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 14px;
    }

    .semi-products__grid {
      --resource-list-column-gap-desktop: 12px;
      --resource-list-row-gap-desktop: 22px;
      --resource-list-columns: repeat(2, minmax(0, 1fr));
      --resource-list-columns-mobile: repeat(2, minmax(0, 1fr));
    }

    .semi-product-card__title,
    .semi-product-card__price {
      font-size: 13px;
    }
  }
{% endstylesheet %}
