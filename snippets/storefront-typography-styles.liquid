{% doc %}
  Shared text-only typography for banners, product cards, and filter controls.
  Uses the Shopify body-font setting. Wishlist card selectors are intentionally excluded.
  @example
  {% render 'storefront-typography-styles' %}
{% enddoc %}

{% stylesheet %}
  :root {
    --storefront-text-family: var(--font-body--family);
    --storefront-card-title-size: 1rem;
    --storefront-card-detail-size: 0.8125rem;
    --storefront-card-price-size: 1.25rem;
    --storefront-card-compare-size: 0.875rem;
    --storefront-filter-title-size: 1.25rem;
    --storefront-filter-group-size: 1rem;
    --storefront-filter-option-size: 0.875rem;
  }

  /* Scoped priority is required by base.css's existing Jost !important override. */
  body :is(.hero,
    .hero-home-slideshow,
    .home-second-banner,
    .gem-editorial__hero,
    .about-raza__hero,
    .collection-hero,
    .faq-page__banner,
    .jewellery-banner,
    .semi-precious-page-banner,
    .privacy-policy-page-banner,
    .payment-methods__banner,
    .precious-page__hero,
    .privacy-policy-hero,
    .return-policy-banner,
    .sales-page__banner,
    .gem-search-hero,
    .support-banner,
    .terms-condition-page-banner,
    .gem-blog__banner,
    .gem-blog__hero,
    .gem-blog__promo,
    .gemstone-card__hero,
    .gemstone-fallback-card__hero,
    .gemstone-landing__title,
    .gemstone-landing__subtitle,
    .gemstone-fallback__title,
    .gemstone-fallback__subtitle,
    .precious-promo-grid,
    .article-toc-promo,
    .article-related-promo,
    .gemora-mobile-submenu-banner,
    .stone-listing__hero,
    .wishlist-page__hero,
    .layered-slideshow-section,
    .support-contact-design,
    :is(.product-card:not(.wishlist-card), .jewellery-product-card, .resource-card[data-resource-type='product']),
    .stone-listing__filters,
    .sales-page__filters,
    .jewellery-filters,
    .search-catalog__filters,
    .facets-block-wrapper,
    .facets-controls-wrapper,
    .facets-toggle,
    .stone-listing__toolbar,
    .sales-page__toolbar,
    .jewellery-products__toolbar,
    .search-catalog__toolbar,
    .gem-blog__topics,
    .gem-blog__search),
  body :is(.hero,
    .hero-home-slideshow,
    .home-second-banner,
    .gem-editorial__hero,
    .about-raza__hero,
    .collection-hero,
    .faq-page__banner,
    .jewellery-banner,
    .semi-precious-page-banner,
    .privacy-policy-page-banner,
    .payment-methods__banner,
    .precious-page__hero,
    .privacy-policy-hero,
    .return-policy-banner,
    .sales-page__banner,
    .gem-search-hero,
    .support-banner,
    .terms-condition-page-banner,
    .gem-blog__banner,
    .gem-blog__hero,
    .gem-blog__promo,
    .gemstone-card__hero,
    .gemstone-fallback-card__hero,
    .gemstone-landing__title,
    .gemstone-landing__subtitle,
    .gemstone-fallback__title,
    .gemstone-fallback__subtitle,
    .precious-promo-grid,
    .article-toc-promo,
    .article-related-promo,
    .gemora-mobile-submenu-banner,
    .stone-listing__hero,
    .wishlist-page__hero,
    .layered-slideshow-section,
    .support-contact-design,
    :is(.product-card:not(.wishlist-card), .jewellery-product-card, .resource-card[data-resource-type='product']),
    .stone-listing__filters,
    .sales-page__filters,
    .jewellery-filters,
    .search-catalog__filters,
    .facets-block-wrapper,
    .facets-controls-wrapper,
    .facets-toggle,
    .stone-listing__toolbar,
    .sales-page__toolbar,
    .jewellery-products__toolbar,
    .search-catalog__toolbar,
    .gem-blog__topics,
    .gem-blog__search) * {
    font-family: var(--storefront-text-family) !important;
  }

  :is(.product-card:not(.wishlist-card), .jewellery-product-card, .resource-card[data-resource-type='product']) {
    font-size: var(--storefront-card-detail-size);
    font-weight: 500;
    font-style: normal;
    line-height: 1.45;
    letter-spacing: normal;
    text-transform: none;
  }

  :is(.product-card:not(.wishlist-card), .jewellery-product-card, .resource-card[data-resource-type='product']) :is(
    .stone-product-card__title,
    .jewellery-product-card__content h3,
    .jewellery-product-card__content h3 a,
    [ref='productTitleLink'] .text-block,
    [ref='productTitleLink'] p,
    .product-grid-view-zoom-out--details h3,
    .resource-card__title
  ) {
    max-inline-size: 100%;
    overflow: hidden;
    font-size: var(--storefront-card-title-size);
    font-weight: 700;
    font-style: normal;
    line-height: 1.3;
    letter-spacing: normal;
    text-align: start;
    text-transform: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    -webkit-line-clamp: 1;
  }

  :is(.product-card:not(.wishlist-card), .jewellery-product-card, .resource-card[data-resource-type='product']) :is(
    .stone-product-card__details,
    .stone-product-card__details span,
    .product-card-gemstone-summary,
    .product-card-gemstone-summary span,
    .jewellery-product-card__details,
    .jewellery-product-card__details span,
    .volume-pricing-note,
    .unit-price
  ) {
    font-size: var(--storefront-card-detail-size);
    font-weight: 500;
    font-style: normal;
    line-height: 1.45;
    letter-spacing: normal;
    text-transform: none;
  }

  :is(.product-card:not(.wishlist-card), .jewellery-product-card, .resource-card[data-resource-type='product']) :is(
    .stone-product-card__price,
    .stone-product-card__price-current,
    .jewellery-product-card__price,
    .jewellery-product-card__price-current,
    .price
  ) {
    font-size: var(--storefront-card-price-size);
    font-weight: 700;
    font-style: normal;
    line-height: 1.3;
    letter-spacing: normal;
    text-transform: none;
  }

  :is(.product-card:not(.wishlist-card), .jewellery-product-card, .resource-card[data-resource-type='product']) :is(
    .stone-product-card__price-compare,
    .jewellery-product-card__price-compare,
    .compare-at-price
  ) {
    font-size: var(--storefront-card-compare-size);
    font-weight: 400;
    font-style: normal;
    line-height: 1.3;
    letter-spacing: normal;
  }

  :is(.product-card:not(.wishlist-card), .jewellery-product-card, .resource-card[data-resource-type='product']) :is(.stone-product-card__badge, .product-badges__badge) {
    font-size: 0.75rem;
    font-weight: 700;
    font-style: normal;
    line-height: 1;
    letter-spacing: normal;
  }

  :is(.product-card:not(.wishlist-card), .jewellery-product-card, .resource-card[data-resource-type='product']) :is(.quick-add__button, .quick-add__button-text) {
    font-size: 0.875rem;
    font-weight: 600;
    font-style: normal;
    line-height: 1.3;
    letter-spacing: normal;
    text-transform: none;
  }

  :is(.stone-listing__filters, .sales-page__filters, .jewellery-filters, .search-catalog__filters, .facets-block-wrapper, .facets-controls-wrapper, .facets-toggle, .stone-listing__toolbar, .sales-page__toolbar, .jewellery-products__toolbar, .search-catalog__toolbar, .gem-blog__topics, .gem-blog__search) {
    font-size: var(--storefront-filter-option-size);
    font-weight: 400;
    font-style: normal;
    line-height: 1.5;
    letter-spacing: normal;
    text-transform: none;
  }

  :is(.stone-listing__filters, .sales-page__filters, .jewellery-filters, .search-catalog__filters, .facets-block-wrapper, .facets-controls-wrapper, .facets-toggle, .stone-listing__toolbar, .sales-page__toolbar, .jewellery-products__toolbar, .search-catalog__toolbar, .gem-blog__topics, .gem-blog__search) :is(label, button, select, input, em, a, p, .facets__inputs-list, .checkbox__label) {
    font-size: var(--storefront-filter-option-size);
    font-weight: 400;
    font-style: normal;
    line-height: 1.5;
    letter-spacing: normal;
    text-transform: none;
  }

  :is(.stone-listing__filters, .sales-page__filters, .jewellery-filters, .search-catalog__filters, .facets-block-wrapper, .facets-controls-wrapper, .facets-toggle, .stone-listing__toolbar, .sales-page__toolbar, .jewellery-products__toolbar, .search-catalog__toolbar, .gem-blog__topics, .gem-blog__search) :is(summary, .facets__summary, .facets__label) {
    font-size: var(--storefront-filter-group-size);
    font-weight: 600;
    font-style: normal;
    line-height: 1.4;
    letter-spacing: normal;
    text-transform: none;
  }

  :is(.stone-listing__filters, .sales-page__filters, .jewellery-filters, .search-catalog__filters, .facets-block-wrapper, .facets-controls-wrapper, .facets-toggle, .stone-listing__toolbar, .sales-page__toolbar, .jewellery-products__toolbar, .search-catalog__toolbar, .gem-blog__topics, .gem-blog__search) :is(h2, h3, h4, .facets--filters-title),
  .search-catalog__filters[ref='filters'] > summary {
    font-size: var(--storefront-filter-title-size);
    font-weight: 700;
    font-style: normal;
    line-height: 1.3;
    letter-spacing: normal;
    text-transform: none;
  }

  :is(.stone-listing__filters, .sales-page__filters, .jewellery-filters, .search-catalog__filters, .facets-block-wrapper, .facets-controls-wrapper, .facets-toggle, .stone-listing__toolbar, .sales-page__toolbar, .jewellery-products__toolbar, .search-catalog__toolbar, .gem-blog__topics, .gem-blog__search) :is(
    .stone-price-range__label,
    .stone-price-range__values,
    .sales-price-range__label,
    .sales-price-range__values,
    .search-catalog__price-caption,
    .price-facet__range-value,
    .price-facet__range-bubble,
    .price-facet__highest-price,
    .facets__status
  ) {
    font-size: var(--storefront-filter-option-size);
    font-weight: 400;
    font-style: normal;
    line-height: 1.5;
    letter-spacing: normal;
  }
  .jewellery-filters .jewellery-filters__group h3 {
    font-size: var(--storefront-filter-group-size);
    font-weight: 600;
    font-style: normal;
    line-height: 1.4;
    letter-spacing: normal;
    text-transform: none;
  }
{% endstylesheet %}
