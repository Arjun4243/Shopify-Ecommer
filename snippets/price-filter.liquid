{%- doc -%}
  Renders a price filter.

  @param {object} filter - The filter object to render.
  @param {string} filter_style - The filter style, can be 'horizontal' or 'vertical'.
  @param {boolean} [should_render_clear] - Whether to render the clear button.
  @param {string} [id_prefix] - Unique prefix to avoid duplicate IDs when rendered multiple times.

  @example
  {% render 'price-filter', filter: filter, filter_style: 'vertical', id_prefix: 'dialog' %}
{%- enddoc -%}

{%- liquid
  assign is_horizontal = false
  assign is_vertical = false
  if filter_style == 'horizontal'
    assign is_horizontal = true
  elsif filter_style == 'vertical'
    assign is_vertical = true
  endif
-%}
{% capture accordion_children %}
  <details
    class="facets__panel"
    {% if filter_style == 'horizontal' %}
      data-auto-close-details="desktop"
    {% endif %}
    {% if filter_style == 'vertical' %}
      open
    {% endif %}
  >
    <summary
      class="facets__summary"
      data-testid="price-filter"
    >
      <span class="facets__label">{{ filter.label }}</span>
      <facet-status-component class="facets__status">
        <template ref="moneyFormat">{{ shop.money_format }}</template>

        <span
          class="hide-when-empty"
          ref="facetStatus"
          data-currency="{{ localization.country.currency.iso_code }}"
          data-range-max="{{ filter.range_max | money_without_currency }}"
        >
          {%- if filter.min_value.value != null or filter.max_value.value != null %}
            {%- if filter.min_value.value != null and filter.max_value.value != null %}
              {{- filter.min_value.value | money | strip_html -}}
              –
              {{- filter.max_value.value | money | strip_html -}}
            {%- elsif filter.min_value.value != null -%}
              {{ filter.min_value.value | money | strip_html }}–{{ filter.range_max | money | strip_html }}

            {%- elsif filter.max_value.value != null -%}
              {{- 0 | money | strip_html -}}
              –
              {{- filter.max_value.value | money | strip_html -}}
            {%- endif -%}
          {%- endif -%}
        </span>
      </facet-status-component>
      <span class="svg-wrapper icon-caret icon-animated">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </summary>
    <floating-panel-component
      {% unless filter_style == 'vertical' %}
        data-close-on-resize
      {% endunless %}
      class="facets__panel-content details-content{% if filter_style == 'horizontal' %} color-custom-popover{% endif %}"
    >
      {% assign min_input_max_value = filter.max_value.value | default: filter.range_max %}
      {% assign max_input_min_value = filter.min_value.value | default: 0 %}
      {% assign range_slider_max = filter.range_max | money_without_currency | replace: ',', '' %}
      {% assign range_slider_min_value = filter.min_value.value | default: 0 | money_without_currency | replace: ',', '' %}
      {% assign range_slider_max_value = filter.max_value.value | default: filter.range_max | money_without_currency | replace: ',', '' %}

      <price-facet-component
        class="
          price-facet
          {%- if filter_style == 'horizontal' %}
            price-facet--horizontal
          {%- endif %}
        "
        id="facet-inputs-{{ filter.param_name | escape | replace: '.', '-' }}"
        data-money-format="{{ shop.money_format | strip_html }}"
        data-currency="{{ localization.country.currency.iso_code }}"
        data-currency-symbol="{{ cart.currency.symbol }}"
        on:change="/updatePriceFilterAndResults"
      >
        <div class="facets__inputs-wrapper facets__inputs-wrapper--row">
          <div
            class="price-facet__inputs-wrapper"
          >
            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ filter.min_value.param_name }}"
                id="{{ filter.label | escape }}-GTE-{{ id_prefix }}"
                {%- if filter.min_value.value -%}
                  value="{{ filter.min_value.value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="0"
                data-min="0"
                data-max="{{ min_input_max_value | money_without_currency }}"
                ref="minInput"
                autocomplete="off"
                aria-label="{{ 'accessibility.price_filter_low' | t }}"
              >

              <label
                class="field__label price-facet__label"
                for="{{ filter.label | escape }}-GTE-{{ id_prefix }}"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>

            <div class="price-facet__separator">{{ 'fields.separator' | t }}</div>

            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ filter.max_value.param_name }}"
                id="{{ filter.label | escape }}-LTE-{{ id_prefix }}"
                {%- if filter.max_value.value -%}
                  value="{{ filter.max_value.value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="{{ filter.range_max | money_without_currency }}"
                data-min="{{ max_input_min_value | money_without_currency }}"
                data-max="{{ filter.range_max | money_without_currency }}"
                ref="maxInput"
                autocomplete="off"
                aria-label="{{ 'accessibility.price_filter_high' | t }}"
              >
              <label
                class="field__label price-facet__label"
                for="{{ filter.label | escape }}-LTE-{{ id_prefix }}"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>
          </div>
        </div>

        <div class="price-facet__range-readout">
          <span
            class="price-facet__range-value price-facet__range-value--min"
            ref="minRangeValue"
          >
            {{ cart.currency.symbol }} {{ range_slider_min_value }}
          </span>
          <span
            class="price-facet__range-bubble"
            ref="maxRangeBubble"
          >
            <span ref="maxRangeValue">{{ cart.currency.symbol }} {{ range_slider_max_value }}</span>
          </span>
        </div>

        <div
          class="price-facet__range-wrapper"
          ref="rangeWrapper"
        >
          <input
            type="range"
            class="price-facet__range price-facet__range--min"
            min="0"
            max="{{ range_slider_max }}"
            value="{{ range_slider_min_value }}"
            step="1"
            ref="minRange"
            aria-label="{{ 'accessibility.price_filter_low' | t }}"
          >
          <input
            type="range"
            class="price-facet__range price-facet__range--max"
            min="0"
            max="{{ range_slider_max }}"
            value="{{ range_slider_max_value }}"
            step="1"
            ref="maxRange"
            aria-label="{{ 'accessibility.price_filter_high' | t }}"
          >
        </div>

        <div
          class="
            price-facet__highest-price
            {%- if filter_style == 'horizontal' %}
              price-facet__highest-price--horizontal
            {%- endif %}
          "
        >
          {%- assign formatted_highest_price = filter.range_max | money -%}
          {{ 'content.price_filter_html' | t: price: formatted_highest_price }}
        </div>

        {% if filter.min_value.value != null or filter.max_value.value != null %}
          {% assign has_active_values = true %}
        {% endif %}

        {% if should_render_clear %}
          <facet-clear-component
            class="clear-filter"
            tabindex="{% if has_active_values %}0{% else %}-1{% endif %}"
            on:click="/clearFilter"
            on:keydown="/clearFilter"
          >
            <div
              class="facets__clear {% if has_active_values %}facets__clear--active{% endif %}"
              ref="clearButton"
            >
              {{- 'actions.clear' | t -}}
            </div>
          </facet-clear-component>
        {% endif %}
      </price-facet-component>
    </floating-panel-component>
  </details>
{% endcapture %}
{% render 'accordion-custom-component',
  children: accordion_children,
  class: 'facets__item',
  open: is_vertical,
  open_by_default_on_desktop: is_vertical,
  open_by_default_on_mobile: is_vertical,
  disable_animation_on_desktop: is_horizontal,
  close_with_escape: is_horizontal
%}

{% stylesheet %}
  /* Price filter */
  .price-facet {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
  }
  .price-facet--horizontal {
    min-width: 360px;
  }

  .price-facet__inputs-wrapper {
    display: flex;
    flex-direction: row;
    padding: var(--style-border-width-inputs);
    gap: calc(var(--gap-sm) + (var(--style-border-width-inputs) * 2));
  }

  @container (max-width: 199px) {
    .price-facet__inputs-wrapper {
      flex-wrap: wrap;
    }
  }

  .price-facet__input {
    width: 100%;
    text-align: right;
    padding-left: calc(2.5 * var(--input-padding-x));
  }

  .price-facet__input::placeholder {
    color: var(--facets-input-label-color);
  }

  .price-facet__separator {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-paragraph--size);
  }

  .price-facet__range-readout {
    --price-range-bubble-percent: 100%;

    position: relative;
    min-height: 34px;
    margin-block-start: var(--padding-xs);
  }

  .price-facet__range-value {
    color: #5c6678;
    font-size: 1.2rem;
    line-height: 1;
    white-space: nowrap;
  }

  .price-facet__range-bubble {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: var(--price-range-bubble-percent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: max-content;
    padding: 7px 10px;
    border-radius: 6px;
    background: #253046;
    color: #fff;
    font-size: 1.2rem;
    line-height: 1;
    white-space: nowrap;
    box-shadow: 0 6px 14px rgb(37 48 70 / 18%);
    transform: translateX(-100%);
  }

  .price-facet__range-bubble::after {
    content: '';
    position: absolute;
    inset-block-start: calc(100% - 1px);
    inset-inline-end: 16px;
    width: 12px;
    height: 12px;
    background: #253046;
    transform: rotate(45deg);
  }

  .price-facet__range-bubble > span {
    position: relative;
    z-index: 1;
  }

  .price-facet__range-wrapper {
    --price-range-track-height: 5px;
    --price-range-thumb-size: 24px;
    --price-range-min-percent: 0%;
    --price-range-max-percent: 100%;
    --price-range-active-color: #0b8df7;
    --price-range-active-color-dark: #0674dd;
    --price-range-track-color: #dbe7f5;

    position: relative;
    min-height: var(--price-range-thumb-size);
    margin-block: 0 var(--padding-sm);
  }

  .price-facet__range-wrapper::before,
  .price-facet__range-wrapper::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    height: var(--price-range-track-height);
    border-radius: 999px;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .price-facet__range-wrapper::before {
    inset-inline-start: var(--price-range-min-percent);
    inset-inline-end: calc(100% - var(--price-range-max-percent));
    background: linear-gradient(90deg, var(--price-range-active-color), var(--price-range-active-color-dark));
    z-index: 1;
  }

  .price-facet__range-wrapper::after {
    inset-inline: 0;
    background: var(--price-range-track-color);
    z-index: 0;
  }

  .price-facet__range {
    position: absolute;
    inset-block-start: 50%;
    inset-inline: 0;
    width: 100%;
    height: var(--price-range-track-height);
    margin: 0;
    padding: 0;
    background: transparent;
    color: var(--price-range-active-color);
    pointer-events: none;
    transform: translateY(-50%);
    -webkit-appearance: none;
    appearance: none;
    z-index: 2;
  }

  .price-facet__range::-webkit-slider-runnable-track {
    height: var(--price-range-track-height);
    border-radius: 999px;
    background: transparent;
  }

  .price-facet__range::-moz-range-track {
    height: var(--price-range-track-height);
    border-radius: 999px;
    background: transparent;
  }

  .price-facet__range::-webkit-slider-thumb {
    width: var(--price-range-thumb-size);
    height: var(--price-range-thumb-size);
    border: 4px solid #fff;
    border-radius: 50%;
    background: var(--price-range-active-color);
    box-shadow: 0 3px 10px rgb(11 141 247 / 24%);
    cursor: pointer;
    pointer-events: auto;
    -webkit-appearance: none;
    appearance: none;
    margin-top: calc((var(--price-range-thumb-size) - var(--price-range-track-height)) / -2);
  }

  .price-facet__range::-moz-range-thumb {
    width: var(--price-range-thumb-size);
    height: var(--price-range-thumb-size);
    border: 4px solid #fff;
    border-radius: 50%;
    background: var(--price-range-active-color);
    box-shadow: 0 3px 10px rgb(11 141 247 / 24%);
    cursor: pointer;
    pointer-events: auto;
  }

  .price-facet__range:focus-visible {
    outline: none;
  }

  .price-facet__range:focus-visible::-webkit-slider-thumb {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .price-facet__range:focus-visible::-moz-range-thumb {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .price-facet__highest-price {
    color: var(--color-foreground-muted);
    padding: var(--padding-xs) 0 var(--padding-sm);
  }

  .price-facet__highest-price--horizontal {
    padding: 0 var(--padding-md) var(--padding-xs);
  }

  .price-facet__label {
    top: 0;
    left: 0;
    color: var(--facets-input-label-color);
    padding: var(--input-padding-y) var(--input-padding-x);
    transform: none;
  }
{% endstylesheet %}
