{% doc %}
Renders a filterable gemstone product listing for a product gemstone group.
@param {string} group_handle - Product metafield group handle to show.
@param {string} heading - Page/listing heading.
@param {string} subtitle - Listing subtitle.
@param {string} section_id - Parent section id for quick-add.
@param {object} [source_collection] - Collection to list products from.
@param {boolean} [show_type_filter] - Whether to show gemstone type filter controls.
@example
{% render 'stone-product-listing', group_handle: 'precious', heading: 'Gemstones', subtitle: 'Discover natural gemstones', section_id: section.id %}
{% enddoc %}

{% liquid
  assign source_collection = source_collection | default: collections.all
  assign products_limit = 250
  assign rendered_products_count = 0
  assign quick_add_enabled = false
  if settings.quick_add or settings.mobile_quick_add
    assign quick_add_enabled = true
  endif
  unless show_type_filter == false
    assign show_type_filter = true
  endunless
%}

<section class="stone-listing" data-stone-listing data-group="{{ group_handle | escape }}">
  <div class="stone-listing__top">
    <nav class="stone-listing__breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">&gt;</span>
      <span>{{ heading | escape }}</span>
    </nav>
    <div class="stone-listing__hero">
      <div>
        <h2>{{ heading | escape }}</h2>
        {% if subtitle != blank %}
          <p>{{ subtitle | escape }}</p>
        {% endif %}
      </div>
      <label class="stone-listing__search">
        <span class="visually-hidden">Search gemstones</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M10.8 4a6.8 6.8 0 1 0 4.3 12.1l3.4 3.4 1.4-1.4-3.4-3.4A6.8 6.8 0 0 0 10.8 4Zm0 2a4.8 4.8 0 1 1 0 9.6 4.8 4.8 0 0 1 0-9.6Z" />
        </svg>
        <input type="search" placeholder="Search gemstones..." data-stone-search>
      </label>
    </div>
  </div>

  <div class="stone-listing__layout">
    <aside id="StoneFilters-{{ group_handle | handleize }}" class="stone-listing__filters" aria-label="Filters" data-stone-filter-drawer>
      <div class="stone-listing__filters-head">
        <h3>Filters</h3>
        <div class="stone-listing__filters-actions">
          <button type="button" data-stone-clear>Clear all</button>
          <button class="stone-listing__filter-close" type="button" aria-label="{{ 'actions.close' | t }}" data-stone-filter-close>X</button>
        </div>
      </div>

      {% if show_type_filter %}
        <details class="stone-filter" open>
          <summary>Gemstone Type</summary>
          <div class="stone-filter__options" data-filter-options="type"></div>
        </details>
      {% endif %}

      <details class="stone-filter" open>
        <summary>Price</summary>
        <div class="stone-price-range" data-price-range>
          <label class="stone-price-range__label" for="StonePriceRange-{{ group_handle | handleize }}">
            Up to <span data-price-range-selected-label></span>
          </label>
          <div class="stone-price-range__track" data-price-range-track>
            <input id="StonePriceRange-{{ group_handle | handleize }}" type="range" data-price-range-max aria-label="Maximum price">
          </div>
          <div class="stone-price-range__values">
            <span data-price-range-min-label></span>
            <span data-price-range-max-label></span>
          </div>
        </div>
      </details>

      <details class="stone-filter" open>
        <summary>Weight (Carats)</summary>
        <div class="stone-filter__options" data-filter-options="carat"></div>
      </details>

      <details class="stone-filter" open>
        <summary>Shape</summary>
        <div class="stone-filter__options" data-filter-options="shape"></div>
      </details>

      <details class="stone-filter" open>
        <summary>Color</summary>
        <div class="stone-filter__options" data-filter-options="color"></div>
      </details>
    </aside>
    <button class="stone-listing__scrim" type="button" aria-label="{{ 'actions.close' | t }}" data-stone-filter-close></button>

    <div class="stone-listing__main">
      <div class="stone-listing__toolbar">
        <button
          class="stone-listing__filter-toggle"
          type="button"
          aria-controls="StoneFilters-{{ group_handle | handleize }}"
          aria-expanded="false"
          data-stone-filter-toggle
        >
          {{ 'actions.show_filters' | t }}
        </button>

        <div class="stone-listing__status">
          <span data-stone-count>Showing products</span>
          <div class="stone-listing__chips" data-stone-chips></div>
        </div>
        <div class="stone-listing__tools">
          <label class="stone-listing__sort">
            <span>Sort by:</span>
            <select data-stone-sort>
              <option value="featured">Featured</option>
              <option value="price-asc">Price: low to high</option>
              <option value="price-desc">Price: high to low</option>
              <option value="title-asc">Name: A to Z</option>
            </select>
          </label>
          <button type="button" class="is-active" data-view-mode="grid" aria-label="Grid view">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h7v7H4V4Zm9 0h7v7h-7V4ZM4 13h7v7H4v-7Zm9 0h7v7h-7v-7Z" /></svg>
          </button>
        </div>
      </div>

      {% if show_type_filter %}
        <div class="stone-type-rail" data-type-rail></div>
      {% endif %}

      <div class="stone-listing__grid" data-stone-grid>
        {% if source_collection != blank and source_collection.products_count > 0 %}
          {% paginate source_collection.products by products_limit %}
            {% for product in source_collection.products %}
              {% liquid
                assign product_group = product.metafields.custom.gemstone_group.value | default: product.metafields.custom.gemstone_group
                assign product_group_handle = product_group | handleize
                assign should_render_product = false
                if group_handle == blank
                  assign should_render_product = true
                elsif product_group_handle == group_handle
                  assign should_render_product = true
                endif
              %}
              {% if should_render_product %}
                {% liquid
                  assign rendered_products_count = rendered_products_count | plus: 1
                  assign gemstone_type = product.metafields.custom.gemstone_type.value | default: product.metafields.custom.gemstone_type
                  assign shape = product.metafields.custom.shape.value | default: product.metafields.custom.shape
                  assign color = product.metafields.custom.color.value | default: product.metafields.custom.color
                  if color == blank
                    assign color_option = product.options_with_values | where: 'name', 'Color' | first
                    assign color = color_option.values | first
                  endif
                  assign carat_weight = product.metafields.custom.actual_carat_weight.value | default: product.metafields.custom.actual_carat_weight
                  assign card_image = ''
                  if product.featured_media.preview_image != blank
                    assign card_image = product.featured_media.preview_image | image_url: width: 240
                  endif
                %}
                <div
                  class="stone-listing__item"
                  data-stone-item
                  data-index="{{ rendered_products_count }}"
                  data-title="{{ product.title | escape }}"
                  data-price="{{ product.price }}"
                  data-type="{{ gemstone_type | escape }}"
                  data-type-key="{{ gemstone_type | handleize }}"
                  data-shape="{{ shape | escape }}"
                  data-shape-key="{{ shape | handleize }}"
                  data-color="{{ color | escape }}"
                  data-color-key="{{ color | handleize }}"
                  data-carat="{{ carat_weight | escape }}"
                  data-image="{{ card_image }}"
                >
                  {% render 'stone-product-card',
                    product: product,
                    card_class: 'stone-listing-card',
                    section_id: section_id,
                    quick_add_enabled: quick_add_enabled
                  %}
                </div>
              {% endif %}
            {% endfor %}
          {% endpaginate %}
        {% endif %}
      </div>

      <p class="stone-listing__empty" data-stone-empty hidden>No products match these filters.</p>
    </div>
  </div>
</section>

{% javascript %}
  const moneyFormat = new Intl.NumberFormat('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const parseCarat = (value) => {
    const match = String(value || '').match(/[\d.]+/);
    return match ? Number(match[0]) : NaN;
  };
  const normalize = (value) => String(value || '').trim().toLowerCase();
  const handle = (value) => normalize(value).replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

  const initStoneListing = (listing) => {
    if (listing.dataset.stoneListingInitialized === 'true') return;

    listing.dataset.stoneListingInitialized = 'true';

    const items = Array.from(listing.querySelectorAll('[data-stone-item]'));
    const searchInputs = Array.from(listing.querySelectorAll('[data-stone-search]'));
    const count = listing.querySelector('[data-stone-count]');
    const chips = listing.querySelector('[data-stone-chips]');
    const grid = listing.querySelector('[data-stone-grid]');
    const empty = listing.querySelector('[data-stone-empty]');
    const priceMaxRange = listing.querySelector('[data-price-range-max]');
    const priceRangeTrack = listing.querySelector('[data-price-range-track]');
    const priceRangeMinLabel = listing.querySelector('[data-price-range-min-label]');
    const priceRangeMaxLabel = listing.querySelector('[data-price-range-max-label]');
    const priceRangeSelectedLabel = listing.querySelector('[data-price-range-selected-label]');
    const sort = listing.querySelector('[data-stone-sort]');
    const clearButtons = listing.querySelectorAll('[data-stone-clear]');
    const typeRail = listing.querySelector('[data-type-rail]');
    const viewButtons = listing.querySelectorAll('[data-view-mode]');
    const filterDrawer = listing.querySelector('[data-stone-filter-drawer]');
    const filterToggle = listing.querySelector('[data-stone-filter-toggle]');
    const filterCloseButtons = listing.querySelectorAll('[data-stone-filter-close]');
    const mobileMedia = window.matchMedia('(max-width: 900px)');
    let filterToggleReturn = null;

    const state = {
      search: '',
      types: new Set(),
      shapes: new Set(),
      colors: new Set(),
      carats: new Set(),
      min: null,
      max: null,
      sort: 'featured',
    };

    const closeFilterDrawer = () => {
      listing.classList.remove('is-filter-drawer-open');
      filterToggle?.setAttribute('aria-expanded', 'false');

      if (filterDrawer) {
        filterDrawer.setAttribute('aria-hidden', mobileMedia.matches ? 'true' : 'false');
      }

      document.documentElement.classList.remove('stone-filter-drawer-open');

      if (filterToggleReturn instanceof HTMLElement) {
        filterToggleReturn.focus();
      }
    };

    const openFilterDrawer = () => {
      if (!mobileMedia.matches) return;

      filterToggleReturn = document.activeElement;
      listing.classList.add('is-filter-drawer-open');
      filterToggle?.setAttribute('aria-expanded', 'true');
      filterDrawer?.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('stone-filter-drawer-open');
      filterDrawer?.querySelector('[data-stone-filter-close]')?.focus();
    };

    const prices = items.map((item) => Number(item.dataset.price || 0) / 100).filter((price) => price > 0);
    const minPrice = prices.length ? Math.floor(Math.min(...prices)) : 0;
    const maxPrice = prices.length ? Math.ceil(Math.max(...prices)) : 0;
    const formatPrice = (price) => `Rs. ${moneyFormat.format(Math.round(Number(price) || 0))}`;

    const syncPriceRangeUi = (max) => {
      if (!priceMaxRange || !priceRangeTrack) return;
      const total = Math.max(maxPrice - minPrice, 1);
      const maxPercent = Math.max(0, Math.min(((max - minPrice) / total) * 100, 100));

      priceMaxRange.value = String(max);
      priceRangeTrack.style.setProperty('--stone-price-max', `${maxPercent}%`);
      if (priceRangeMinLabel) priceRangeMinLabel.textContent = formatPrice(minPrice);
      if (priceRangeMaxLabel) priceRangeMaxLabel.textContent = formatPrice(max);
      if (priceRangeSelectedLabel) priceRangeSelectedLabel.textContent = formatPrice(max);
    };

    if (priceMaxRange) {
      priceMaxRange.min = minPrice;
      priceMaxRange.max = maxPrice;
      priceMaxRange.step = 1;
      syncPriceRangeUi(maxPrice);
    }

    const makeMap = (attr, labelAttr = attr) => {
      const map = new Map();
      items.forEach((item) => {
        const key = item.dataset[attr];
        const label = item.dataset[labelAttr];
        if (!key || !label) return;
        const entry = map.get(key) || { key, label, count: 0, image: item.dataset.image || '' };
        entry.count += 1;
        if (!entry.image && item.dataset.image) entry.image = item.dataset.image;
        map.set(key, entry);
      });
      return Array.from(map.values()).sort((a, b) => a.label.localeCompare(b.label));
    };

    const typeOptions = makeMap('typeKey', 'type');
    const shapeOptions = makeMap('shapeKey', 'shape');
    const colorOptions = makeMap('colorKey', 'color');
    const caratRanges = [
      { key: '0-1', label: '0-1 Carat', min: 0, max: 1 },
      { key: '1-2', label: '1-2 Carats', min: 1, max: 2 },
      { key: '2-3', label: '2-3 Carats', min: 2, max: 3 },
      { key: '3-4', label: '3-4 Carats', min: 3, max: 4 },
      { key: '4-5', label: '4-5 Carats', min: 4, max: 5 },
      { key: '5-6', label: '5-6 Carats', min: 5, max: 6 },
      { key: '6-10', label: '6-10 Carats', min: 6, max: 10 },
      { key: '10-plus', label: '10+ Carats', min: 10, max: Infinity },
    ].map((range) => ({
      ...range,
      count: items.filter((item) => {
        const carat = parseCarat(item.dataset.carat);
        return !Number.isNaN(carat) && carat >= range.min && carat < range.max;
      }).length,
    }));

    const renderCheckboxes = (target, options, type) => {
      const container = listing.querySelector(`[data-filter-options="${target}"]`);
      if (!container) return;
      container.innerHTML = options.map((option) => `
        <label class="stone-filter__option" data-option-label="${option.label.toLowerCase()}">
          <input type="checkbox" value="${option.key}" data-filter-check="${type}">
          <span></span>
          <em>${option.label} (${option.count})</em>
        </label>
      `).join('');
    };

    renderCheckboxes('type', typeOptions, 'type');
    renderCheckboxes('shape', shapeOptions, 'shape');
    renderCheckboxes('color', colorOptions, 'color');
    renderCheckboxes('carat', caratRanges, 'carat');

    if (typeRail) {
      typeRail.innerHTML = [
        `<button type="button" class="is-active" data-type-tile="">All</button>`,
        ...typeOptions.map((option) => `
          <button type="button" data-type-tile="${option.key}">
            ${option.image ? `<img src="${option.image}" alt="">` : ''}
            <span>${option.label}</span>
          </button>
        `),
      ].join('');
    }

    const clampPrices = () => {
      let max = Number(priceMaxRange?.value || maxPrice);
      max = Math.max(minPrice, Math.min(max, maxPrice));
      state.min = minPrice;
      state.max = max;
      syncPriceRangeUi(max);
    };

    const matchesCarat = (item) => {
      if (!state.carats.size) return true;
      const carat = parseCarat(item.dataset.carat);
      if (Number.isNaN(carat)) return false;
      return Array.from(state.carats).some((key) => {
        const range = caratRanges.find((entry) => entry.key === key);
        return range && carat >= range.min && carat < range.max;
      });
    };

    const apply = () => {
      clampPrices();
      let visible = items.filter((item) => {
        const price = Number(item.dataset.price || 0) / 100;
        const title = normalize(item.dataset.title);
        return (!state.search || title.startsWith(state.search))
          && (!state.types.size || state.types.has(item.dataset.typeKey))
          && (!state.shapes.size || state.shapes.has(item.dataset.shapeKey))
          && (!state.colors.size || state.colors.has(item.dataset.colorKey))
          && matchesCarat(item)
          && price >= state.min
          && price <= state.max;
      });

      visible.sort((a, b) => {
        if (state.sort === 'price-asc') return Number(a.dataset.price) - Number(b.dataset.price);
        if (state.sort === 'price-desc') return Number(b.dataset.price) - Number(a.dataset.price);
        if (state.sort === 'title-asc') return a.dataset.title.localeCompare(b.dataset.title);
        return Number(a.dataset.index) - Number(b.dataset.index);
      });

      items.forEach((item) => { item.hidden = true; });
      visible.forEach((item) => {
        item.hidden = false;
        grid.appendChild(item);
      });

      count.textContent = `Showing ${visible.length} of ${items.length} products`;
      empty.hidden = visible.length > 0;

      const chipValues = [
        ...typeOptions.filter((option) => state.types.has(option.key)).map((option) => option.label),
        ...shapeOptions.filter((option) => state.shapes.has(option.key)).map((option) => option.label),
        ...colorOptions.filter((option) => state.colors.has(option.key)).map((option) => option.label),
        ...caratRanges.filter((option) => state.carats.has(option.key)).map((option) => option.label),
      ];
      chips.innerHTML = chipValues.map((label) => `<span>${label}</span>`).join('');
    };

    listing.addEventListener('change', (event) => {
      const checkbox = event.target.closest('[data-filter-check]');
      if (checkbox) {
        const targetSet = checkbox.dataset.filterCheck === 'type' ? state.types : checkbox.dataset.filterCheck === 'shape' ? state.shapes : checkbox.dataset.filterCheck === 'color' ? state.colors : state.carats;
        checkbox.checked ? targetSet.add(checkbox.value) : targetSet.delete(checkbox.value);
      }
      if (event.target === sort) state.sort = sort.value;
      apply();
    });

    listing.addEventListener('input', (event) => {
      const searchInput = event.target.closest('[data-stone-search]');
      if (searchInput) {
        state.search = normalize(searchInput.value);
        searchInputs.forEach((input) => {
          if (input !== searchInput) input.value = searchInput.value;
        });
      }
      if (event.target === priceMaxRange) syncPriceRangeUi(Number(priceMaxRange.value || maxPrice));
      apply();
    });

    typeRail?.addEventListener('click', (event) => {
      const button = event.target.closest('[data-type-tile]');
      if (!button) return;
      state.types.clear();
      if (button.dataset.typeTile) state.types.add(button.dataset.typeTile);
      listing.querySelectorAll('[data-type-tile]').forEach((tile) => tile.classList.toggle('is-active', tile === button));
      listing.querySelectorAll('[data-filter-check="type"]').forEach((checkbox) => {
        checkbox.checked = state.types.has(checkbox.value);
      });
      apply();
    });

    clearButtons.forEach((button) => {
      button.addEventListener('click', () => {
        state.search = '';
        state.types.clear();
        state.shapes.clear();
        state.colors.clear();
        state.carats.clear();
        state.sort = 'featured';
        searchInputs.forEach((input) => { input.value = ''; });
        sort.value = 'featured';
        if (priceMaxRange) priceMaxRange.value = maxPrice;
        syncPriceRangeUi(maxPrice);
        listing.querySelectorAll('[data-filter-check]').forEach((checkbox) => { checkbox.checked = false; });
        listing.querySelectorAll('[data-type-tile]').forEach((tile, index) => tile.classList.toggle('is-active', index === 0));
        apply();
      });
    });

    viewButtons.forEach((button) => {
      button.addEventListener('click', () => {
        viewButtons.forEach((control) => control.classList.toggle('is-active', control === button));
        grid.classList.toggle('stone-listing__grid--list', button.dataset.viewMode === 'list');
      });
    });

    filterToggle?.addEventListener('click', openFilterDrawer);
    filterCloseButtons.forEach((button) => button.addEventListener('click', closeFilterDrawer));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && listing.classList.contains('is-filter-drawer-open')) {
        closeFilterDrawer();
      }
    });

    mobileMedia.addEventListener('change', () => {
      if (mobileMedia.matches) {
        filterDrawer?.setAttribute('aria-hidden', listing.classList.contains('is-filter-drawer-open') ? 'false' : 'true');
      } else {
        closeFilterDrawer();
        filterDrawer?.setAttribute('aria-hidden', 'false');
      }
    });

    if (filterDrawer) {
      filterDrawer.setAttribute('aria-hidden', mobileMedia.matches ? 'true' : 'false');
    }

    apply();
  };

  const initStoneListings = (root = document) => {
    if (root.matches?.('[data-stone-listing]')) {
      initStoneListing(root);
    }

    root.querySelectorAll('[data-stone-listing]').forEach(initStoneListing);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initStoneListings(), { once: true });
  } else {
    initStoneListings();
  }

  document.addEventListener('shopify:section:load', (event) => {
    initStoneListings(event.target);
  });
{% endjavascript %}

{% stylesheet %}
  .stone-listing {
    padding: 30px 0 56px;
    background: #fffdf9;
    color: #111827;
    font-family: Inter, sans-serif;
  }

  .stone-listing__top,
  .stone-listing__layout {
    width: min(100%, 1600px);
    margin: 0 auto;
    padding: 0 6%;
  }

  .stone-listing__breadcrumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #a46f0a;
    font-size: 14px;
  }

  .stone-listing__breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .stone-listing__hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 28px;
    margin-top: 6px;
  }

  .stone-listing__hero h2 {
    margin: 0;
    font-family: Inter, sans-serif;
    font-size: clamp(40px, 4.2vw, 72px);
    line-height: 0.95;
  }

  .stone-listing__hero p {
    margin: 8px 0 0;
    color: #565b64;
    font-size: clamp(15px, 1.1vw, 20px);
  }

  .stone-listing__search {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 16px;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 6px 20px rgb(17 24 39 / 8%);
  }

  .stone-listing__search {
    width: min(100%, 430px);
  }

  .stone-listing__search svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .stone-listing input,
  .stone-listing select,
  .stone-listing button {
    font: inherit;
  }

  .stone-listing input,
  .stone-listing select {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: inherit;
  }

  .stone-listing__layout {
    display: grid;
    grid-template-columns: minmax(240px, 330px) minmax(0, 1fr);
    gap: 32px;
    margin-top: 34px;
  }

  .stone-listing__filters {
    position: sticky;
    top: 20px;
    align-self: start;
    max-block-size: calc(100dvh - 40px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 18px;
    border: 1px solid #ece7df;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 12px 34px rgb(17 24 39 / 7%);
    -webkit-overflow-scrolling: touch;
  }

  .stone-listing__filter-toggle,
  .stone-listing__filter-close,
  .stone-listing__scrim {
    display: none;
  }

  .stone-listing__filters-head,
  .stone-listing__toolbar,
  .stone-listing__tools,
  .stone-listing__status {
    display: flex;
    align-items: center;
  }

  .stone-listing__filters-head,
  .stone-listing__toolbar {
    justify-content: space-between;
    gap: 18px;
  }

  .stone-listing__filters-head h3 {
    margin: 0;
    font-size: 20px;
  }

  .stone-listing__filters-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .stone-listing__filters button,
  .stone-listing__toolbar button {
    cursor: pointer;
  }

  .stone-listing__filters-head button,
  .stone-listing__chips span,
  .stone-type-rail button.is-active {
    color: #a46f0a;
  }

  .stone-listing__filters-head button {
    border: 0;
    background: transparent;
    font-weight: 800;
  }

  .stone-filter {
    padding: 16px 0;
    border-top: 1px solid #ece7df;
  }

  .stone-filter summary {
    cursor: pointer;
    font-size: 18px;
    font-weight: 900;
  }

  .stone-filter__options {
    display: grid;
    gap: 10px;
    margin-top: 12px;
  }

  .stone-filter__option {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #2f3540;
    cursor: pointer;
    font-size: 15px;
  }

  .stone-filter__option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .stone-filter__option span {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 1px solid #b8bdc5;
    border-radius: 4px;
    background: #fff;
  }

  .stone-filter__option input:checked + span {
    border-color: #b47a00;
    background: #b47a00;
  }

  .stone-filter__option input:checked + span::after {
    content: "";
    width: 9px;
    height: 5px;
    border-left: 2px solid #fff;
    border-bottom: 2px solid #fff;
    transform: rotate(-45deg);
  }

  .stone-filter__option em {
    font-style: normal;
  }

  .stone-price-range {
    margin-top: 14px;
  }

  .stone-price-range__label,
  .stone-price-range__values {
    display: flex;
    justify-content: space-between;
    color: #4b5563;
    font-size: 13px;
    line-height: 1.35;
  }

  .stone-price-range__label {
    margin-bottom: 14px;
  }

  .stone-price-range__values {
    margin-top: 12px;
  }

  .stone-price-range__track {
    --stone-price-max: 100%;
    --stone-price-track-height: 5px;
    --stone-price-thumb-size: 24px;
    --stone-price-active: #0b8df7;
    --stone-price-active-dark: #0674dd;
    --stone-price-track: #dbe7f5;

    position: relative;
    min-height: var(--stone-price-thumb-size);
  }

  .stone-price-range__track::before,
  .stone-price-range__track::after {
    content: "";
    position: absolute;
    top: 50%;
    height: var(--stone-price-track-height);
    border-radius: 999px;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .stone-price-range__track::before {
    left: 0;
    right: calc(100% - var(--stone-price-max));
    z-index: 1;
    background: linear-gradient(90deg, var(--stone-price-active), var(--stone-price-active-dark));
  }

  .stone-price-range__track::after {
    left: 0;
    right: 0;
    z-index: 0;
    background: var(--stone-price-track);
  }

  .stone-price-range input[type="range"] {
    position: absolute;
    top: 50%;
    left: 0;
    z-index: 2;
    width: 100%;
    height: var(--stone-price-track-height);
    margin: 0;
    padding: 0;
    background: transparent;
    color: var(--stone-price-active);
    pointer-events: none;
    transform: translateY(-50%);
    -webkit-appearance: none;
    appearance: none;
  }

  .stone-price-range input[type="range"]::-webkit-slider-runnable-track {
    height: var(--stone-price-track-height);
    border-radius: 999px;
    background: transparent;
  }

  .stone-price-range input[type="range"]::-moz-range-track {
    height: var(--stone-price-track-height);
    border-radius: 999px;
    background: transparent;
  }

  .stone-price-range input[type="range"]::-webkit-slider-thumb {
    width: var(--stone-price-thumb-size);
    height: var(--stone-price-thumb-size);
    border: 4px solid #fff;
    border-radius: 50%;
    background: var(--stone-price-active);
    box-shadow: 0 3px 10px rgb(11 141 247 / 24%);
    cursor: pointer;
    pointer-events: auto;
    -webkit-appearance: none;
    appearance: none;
    margin-top: calc((var(--stone-price-thumb-size) - var(--stone-price-track-height)) / -2);
  }

  .stone-price-range input[type="range"]::-moz-range-thumb {
    width: var(--stone-price-thumb-size);
    height: var(--stone-price-thumb-size);
    border: 4px solid #fff;
    border-radius: 50%;
    background: var(--stone-price-active);
    box-shadow: 0 3px 10px rgb(11 141 247 / 24%);
    cursor: pointer;
    pointer-events: auto;
  }

  .stone-price-range input[type="range"]:focus-visible {
    outline: none;
  }

  .stone-price-range input[type="range"]:focus-visible::-webkit-slider-thumb {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .stone-price-range input[type="range"]:focus-visible::-moz-range-thumb {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .stone-listing__main {
    min-width: 0;
  }

  .stone-listing__status {
    flex-wrap: wrap;
    gap: 12px;
    color: #454b55;
  }

  .stone-listing__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stone-listing__chips span {
    padding: 9px 14px;
    border-radius: 999px;
    background: #f6eddc;
    font-size: 14px;
  }

  .stone-listing__tools {
    gap: 12px;
  }

  .stone-listing__sort {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
    min-height: 42px;
    padding: 0 14px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #fff;
    white-space: nowrap;
  }

  .stone-listing__sort select {
    width: auto;
    min-width: 150px;
  }

  .stone-listing__tools button {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #fff;
    color: #303640;
  }

  .stone-listing__tools button.is-active {
    border-color: #b47a00;
    background: #b47a00;
    color: #fff;
  }

  .stone-listing__tools svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .stone-type-rail {
    display: grid;
    grid-auto-columns: 76px;
    grid-auto-flow: column;
    gap: 10px;
    overflow-x: auto;
    margin: 18px 0 26px;
    padding-bottom: 4px;
    scrollbar-width: none;
  }

  .stone-type-rail::-webkit-scrollbar {
    display: none;
  }

  .stone-type-rail button {
    display: grid;
    grid-template-rows: 46px auto;
    align-items: center;
    gap: 6px;
    justify-items: center;
    width: 76px;
    min-height: 78px;
    padding: 7px 6px 8px;
    border: 1px solid transparent;
    border-radius: 10px;
    background: #f6f3ee;
    color: #303640;
    cursor: pointer;
  }

  .stone-type-rail button.is-active {
    border-color: #b47a00;
    background: #fff;
  }

  .stone-type-rail img {
    width: 44px;
    height: 44px;
    border-radius: 7px;
    object-fit: cover;
  }

  .stone-type-rail span {
    max-width: 68px;
    overflow: hidden;
    font-size: 11px;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stone-listing__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, 174px);
    gap: 28px 26px;
    justify-content: start;
  }

  .stone-listing__grid--list {
    grid-template-columns: 1fr;
  }

  .stone-listing__grid--list .stone-listing__item .stone-product-card__content {
    grid-template-columns: minmax(120px, 220px) minmax(0, 1fr);
    align-items: start;
  }

  .stone-listing__empty {
    margin: 30px 0 0;
    color: #747983;
    font-weight: 700;
  }

  @media screen and (max-width: 1180px) {
    .stone-listing__grid {
      grid-template-columns: repeat(auto-fill, 174px);
    }
  }

  @media screen and (max-width: 900px) {
    .stone-listing__hero,
    .stone-listing__toolbar {
      flex-direction: column;
      align-items: stretch;
    }

    .stone-listing__layout {
      grid-template-columns: 1fr;
    }

    .stone-listing__filters {
      position: fixed;
      z-index: 60;
      inset-block: 0;
      inset-inline-start: 0;
      block-size: 100dvh;
      max-block-size: 100dvh;
      width: min(86vw, 360px);
      max-width: 100%;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-bottom: max(18px, env(safe-area-inset-bottom));
      border-radius: 0;
      transform: translateX(-100%);
      transition: transform 220ms ease;
      -webkit-overflow-scrolling: touch;
    }

    [dir='rtl'] .stone-listing__filters {
      transform: translateX(100%);
    }

    html.stone-filter-drawer-open {
      overflow: hidden;
    }

    .stone-listing.is-filter-drawer-open .stone-listing__filters {
      transform: translateX(0);
    }

    .stone-listing__filter-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      width: max-content;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      background: #fff;
      color: #253046;
      padding-inline: 16px;
      font-weight: 800;
      box-shadow: 0 4px 12px rgb(17 24 39 / 8%);
    }

    .stone-listing__filter-close {
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      color: #111827;
      font-size: 18px;
      line-height: 1;
    }

    .stone-listing__scrim {
      position: fixed;
      z-index: 50;
      inset: 0;
      display: block;
      border: 0;
      background: rgb(17 24 39 / 44%);
      opacity: 0;
      pointer-events: none;
      transition: opacity 220ms ease;
    }

    .stone-listing.is-filter-drawer-open .stone-listing__scrim {
      opacity: 1;
      pointer-events: auto;
    }

    .stone-listing__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 14px;
    }
  }

  @media screen and (max-width: 560px) {
    .stone-listing__top,
    .stone-listing__layout {
      padding: 0 18px;
    }

    .stone-listing__grid {
      gap: 24px 14px;
    }

    .stone-listing__tools {
      flex-wrap: wrap;
    }
  }
{% endstylesheet %}
