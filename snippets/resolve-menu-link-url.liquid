{% doc %}
Returns a corrected URL for known menu items when the navigation link is configured incorrectly.

@param {object} link - The menu link object.

@example
{% render 'resolve-menu-link-url', link: link %}
{% enddoc %}

{% liquid
  assign resolved_url = link.url
  assign link_title = link.title | handleize

  case link_title
    when 'privacy-policy'
      assign resolved_url = '/pages/privacy-policy'
  endcase

  echo resolved_url
%}
