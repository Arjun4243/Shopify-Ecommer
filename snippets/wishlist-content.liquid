{% doc %}
  Renders the browser-based wishlist content.
  @param {string} [section_id] - Parent section id for quick-add forms.
  @example
  {% render 'wishlist-content', section_id: section.id %}
{% enddoc %}

{% liquid
  assign wishlist_section_id = section_id | default: 'wishlist-page'
%}

<section class="wishlist-page" data-wishlist-page>
  <div class="wishlist-page__hero">
    <div class="wishlist-page__hero-content">
      <nav class="wishlist-page__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        <span>{{ 'products.gemstone.wishlist' | t }}</span>
      </nav>

      <p class="wishlist-page__eyebrow">{{ 'products.gemstone.wishlist_saved_favourites' | t }}</p>
      <h1>{{ 'products.gemstone.wishlist_title' | t }}</h1>
      <p class="wishlist-page__intro">{{ 'products.gemstone.wishlist_intro' | t }}</p>
    </div>
  </div>

  <div class="wishlist-page__shell section section--page-width">
    <div class="wishlist-page__summary" data-wishlist-summary hidden>
      <p class="wishlist-page__count" data-wishlist-count></p>
      <button class="wishlist-page__share" type="button" data-wishlist-share>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M18 16.1c-1.1 0-2 .5-2.7 1.3L8.9 13.7c.1-.3.1-.5.1-.8s0-.5-.1-.8l6.3-3.7A3.2 3.2 0 1 0 14.5 7L8.2 10.7a3.2 3.2 0 1 0 0 4.6l6.4 3.8A3.2 3.2 0 1 0 18 16.1Zm0-12.2a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6ZM6 14.2a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Zm12 5.9a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Z" />
        </svg>
        <span>{{ 'products.gemstone.share_wishlist' | t }}</span>
      </button>
    </div>

    <div class="wishlist-page__empty" data-wishlist-empty>
      <span class="wishlist-page__empty-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M12 21.4 10.6 20.1C5.4 15.4 2 12.3 2 8.5 2 5.4 4.4 3 7.5 3c1.7 0 3.4.8 4.5 2.1C13.1 3.8 14.8 3 16.5 3 19.6 3 22 5.4 22 8.5c0 3.8-3.4 6.9-8.6 11.6L12 21.4Zm0-2.7.1-.1c4.8-4.3 7.9-7.2 7.9-10.1C20 6.5 18.5 5 16.5 5c-1.5 0-3 .9-3.6 2.1h-1.8C10.5 5.9 9 5 7.5 5 5.5 5 4 6.5 4 8.5c0 2.9 3.1 5.8 7.9 10.1l.1.1Z" />
        </svg>
      </span>
      <h2>{{ 'products.gemstone.wishlist_empty_title' | t }}</h2>
      <p>{{ 'products.gemstone.wishlist_empty_body' | t }}</p>
      <a href="{{ routes.collections_url }}" class="button">{{ 'actions.continue_shopping' | t }}</a>
    </div>

    <ul
      class="wishlist-page__grid"
      data-wishlist-grid
      data-count-one="{{ 'products.gemstone.wishlist_count.one' | t: count: 1 | escape }}"
      data-count-other="{{ 'products.gemstone.wishlist_count.other' | t: count: 'COUNT' | escape }}"
      hidden
      role="list"
    >
      {% paginate collections.all.products by 250 %}
        {% for wishlist_product in collections.all.products %}
          {% liquid
            assign selected_variant = wishlist_product.selected_or_first_available_variant
            assign gemstone_type = wishlist_product.metafields.custom.gemstone_type.value | default: wishlist_product.metafields.custom.gemstone_type
            assign gemstone_group = wishlist_product.metafields.custom.gemstone_group.value | default: wishlist_product.metafields.custom.gemstone_group | default: wishlist_product.type
            assign shape = wishlist_product.metafields.custom.shape.value | default: wishlist_product.metafields.custom.shape
            assign product_color = wishlist_product.metafields.custom.color.value | default: wishlist_product.metafields.custom.color
            assign carat_weight = wishlist_product.metafields.custom.actual_carat_weight.value
            assign certification_status = wishlist_product.metafields.custom.certification_status.value
            assign detail_count = 0
          %}
          <li
            class="wishlist-page__grid-item"
            data-wishlist-card
            data-product-handle="{{ wishlist_product.handle | escape }}"
            hidden
          >
            <product-card
              class="wishlist-card"
              data-product-id="{{ wishlist_product.id }}"
              style="
                --quick-add-display: flex;
                --quick-add-mobile-display: flex;
                --quick-add-mobile-opacity: 1;
              "
            >
              <div class="wishlist-card__media">
                <a
                  class="wishlist-card__image-link"
                  href="{{ wishlist_product.url }}"
                  ref="productCardLink"
                  aria-label="{{ wishlist_product.title | escape }}"
                >
                  {% if wishlist_product.featured_media.preview_image != blank %}
                    {{
                      wishlist_product.featured_media.preview_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '300, 450, 600, 750, 900',
                        sizes: '(min-width: 990px) 25vw, (min-width: 750px) 40vw, 90vw',
                        alt: wishlist_product.title,
                        class: 'wishlist-card__image'
                    }}
                  {% else %}
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'wishlist-card__placeholder' }}
                  {% endif %}
                </a>

                <button
                  class="wishlist-card__remove"
                  type="button"
                  aria-label="{{ 'products.gemstone.remove_from_wishlist' | t: product: wishlist_product.title | escape }}"
                  data-wishlist-remove="{{ wishlist_product.handle | escape }}"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M12 21.4 10.6 20.1C5.4 15.4 2 12.3 2 8.5 2 5.4 4.4 3 7.5 3c1.7 0 3.4.8 4.5 2.1C13.1 3.8 14.8 3 16.5 3 19.6 3 22 5.4 22 8.5c0 3.8-3.4 6.9-8.6 11.6L12 21.4Z" />
                  </svg>
                </button>

                {% if wishlist_product.available %}
                  {% render 'quick-add', product: wishlist_product, section_id: wishlist_section_id %}
                {% endif %}
              </div>

              <div class="wishlist-card__content">
                <a class="wishlist-card__title" href="{{ wishlist_product.url }}">{{ wishlist_product.title }}</a>

                <div class="wishlist-card__details">
                  {% if product_color != blank %}
                    {% assign detail_count = detail_count | plus: 1 %}
                    <span>{{ 'products.gemstone.color' | t }}: {{ product_color }}</span>
                  {% endif %}
                  {% if shape != blank %}
                    {% assign detail_count = detail_count | plus: 1 %}
                    <span>{{ 'products.gemstone.shape' | t }}: {{ shape }}</span>
                  {% endif %}
                  {% if gemstone_type != blank %}
                    {% assign detail_count = detail_count | plus: 1 %}
                    <span>{{ 'products.gemstone.stone_type' | t }}: {{ gemstone_type }}</span>
                  {% elsif gemstone_group != blank %}
                    {% assign detail_count = detail_count | plus: 1 %}
                    <span>{{ 'products.gemstone.group' | t }}: {{ gemstone_group }}</span>
                  {% endif %}
                  {% if carat_weight != blank %}
                    {% assign detail_count = detail_count | plus: 1 %}
                    <span>{{ 'products.gemstone.carat_weight' | t }}: {{ carat_weight }}</span>
                  {% endif %}
                  {% if detail_count == 0 and certification_status != blank %}
                    <span>{{ certification_status }}</span>
                  {% endif %}
                </div>

                <div class="wishlist-card__footer">
                  <p class="wishlist-card__price">{{ selected_variant.price | money }}</p>
                  <a class="wishlist-card__view" href="{{ wishlist_product.url }}">{{ 'products.gemstone.view_product' | t }}</a>
                </div>
              </div>
            </product-card>
          </li>
        {% endfor %}
      {% endpaginate %}
    </ul>
  </div>
</section>

{% javascript %}
  const wishlistPage = document.querySelector('[data-wishlist-page]');
  const getWishlistItems = () => JSON.parse(localStorage.getItem('raza-gems-wishlist') || '[]');
  const setWishlistItems = (wishlist) => localStorage.setItem('raza-gems-wishlist', JSON.stringify(wishlist));

  const renderRazaGemsWishlist = () => {
    if (!wishlistPage) return;

    const grid = wishlistPage.querySelector('[data-wishlist-grid]');
    const empty = wishlistPage.querySelector('[data-wishlist-empty]');
    const summary = wishlistPage.querySelector('[data-wishlist-summary]');
    const count = wishlistPage.querySelector('[data-wishlist-count]');
    if (!grid || !empty || !summary) return;

    const wishlist = getWishlistItems().filter((item) => item.handle);
    const cards = Array.from(grid.querySelectorAll('[data-wishlist-card]'));
    const cardByHandle = new Map(cards.map((card) => [card.dataset.productHandle, card]));
    let visibleCount = 0;

    cards.forEach((card) => {
      card.hidden = true;
    });

    wishlist.forEach((item) => {
      const card = cardByHandle.get(item.handle);
      if (!card) return;

      card.hidden = false;
      grid.appendChild(card);
      visibleCount += 1;
    });

    grid.hidden = visibleCount === 0;
    summary.hidden = visibleCount === 0;
    empty.hidden = visibleCount > 0;

    if (count) {
      count.textContent =
        visibleCount === 1 ? grid.dataset.countOne : grid.dataset.countOther.replace('COUNT', String(visibleCount));
    }
  };

  document.addEventListener('click', (event) => {
    if (!wishlistPage) return;

    const removeButton = event.target.closest('[data-wishlist-remove]');
    const shareButton = event.target.closest('[data-wishlist-share]');

    if (removeButton) {
      const wishlist = getWishlistItems().filter((product) => product.handle !== removeButton.dataset.wishlistRemove);
      setWishlistItems(wishlist);
      renderRazaGemsWishlist();
      window.dispatchEvent(new CustomEvent('raza-gems:wishlist-updated', { detail: { count: wishlist.length } }));
      return;
    }

    if (shareButton) {
      const shareData = {
        title: document.title,
        url: window.location.href,
      };

      if (navigator.share) {
        navigator.share(shareData);
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(shareData.url);
      }
    }
  });

  renderRazaGemsWishlist();
  window.addEventListener('raza-gems:wishlist-updated', renderRazaGemsWishlist);
  window.addEventListener('storage', renderRazaGemsWishlist);
{% endjavascript %}

{% stylesheet %}
  .wishlist-page {
    color: var(--color-foreground);
    background: var(--color-background);
  }

  .wishlist-page__hero {
    position: relative;
    min-height: clamp(230px, 28vw, 360px);
    display: grid;
    align-items: center;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgb(255 252 247 / 96%) 0%, rgb(255 252 247 / 82%) 43%, rgb(255 252 247 / 10%) 72%),
      url("https://cdn.shopify.com/s/files/1/1003/6353/4631/files/Return_exchange_banner_image.webp?v=1790160147") center / cover no-repeat;
  }

  .wishlist-page__hero-content {
    width: min(var(--page-width), calc(100% - var(--page-margin) * 2));
    margin-inline: auto;
    padding-block: clamp(34px, 6vw, 76px);
  }

  .wishlist-page__breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-block-end: 18px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: 0.9rem;
  }

  .wishlist-page__breadcrumb a,
  .wishlist-page__breadcrumb span:last-child {
    color: #8a4b08;
    text-decoration: none;
  }

  .wishlist-page__eyebrow,
  .wishlist-page__intro {
    max-width: 34rem;
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    line-height: 1.45;
  }

  .wishlist-page__hero h1 {
    max-width: 36rem;
    margin: 0 0 8px;
    color: var(--color-foreground);
    font-family: var(--font-heading--family);
    font-size: clamp(2.8rem, 6vw, 5.7rem);
    font-weight: var(--font-heading--weight);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .wishlist-page__shell {
    padding-block: clamp(22px, 4vw, 52px);
  }

  .wishlist-page__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-block-end: 18px;
    padding: 14px 18px;
    border: 1px solid rgb(var(--color-border-rgb) / 0.45);
    border-radius: 8px;
    background: rgb(var(--color-background-rgb) / 0.86);
    box-shadow: 0 16px 42px rgb(var(--color-foreground-rgb) / 0.06);
  }

  .wishlist-page__count {
    margin: 0;
    font-weight: 700;
  }

  .wishlist-page__share {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 42px;
    padding: 0 16px;
    border: 1px solid #b78343;
    border-radius: 8px;
    background: transparent;
    color: #8a4b08;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
  }

  .wishlist-page__share svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .wishlist-page__empty {
    display: grid;
    justify-items: center;
    gap: 12px;
    min-height: 270px;
    padding: clamp(34px, 6vw, 70px) 18px;
    border: 1px dashed rgb(var(--color-border-rgb) / 0.55);
    border-radius: 8px;
    text-align: center;
  }

  .wishlist-page__empty-icon {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #f8efe6;
    color: #8a4b08;
  }

  .wishlist-page__empty-icon svg {
    width: 30px;
    height: 30px;
    fill: currentColor;
  }

  .wishlist-page__empty h2 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    line-height: 1.1;
  }

  .wishlist-page__empty p {
    max-width: 32rem;
    margin: 0 0 8px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .wishlist-page__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 22px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wishlist-page__grid-item {
    min-width: 0;
  }

  .wishlist-card {
    display: grid;
    height: 100%;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid rgb(var(--color-border-rgb) / 0.55);
    border-radius: 8px;
    background: var(--color-background);
    box-shadow: 0 18px 46px rgb(var(--color-foreground-rgb) / 0.07);
  }

  .wishlist-card__media {
    position: relative;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .wishlist-card__image-link {
    display: block;
  }

  .wishlist-card__image,
  .wishlist-card__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 0.78;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .wishlist-card:hover .wishlist-card__image {
    transform: scale(1.025);
  }

  .wishlist-card__remove {
    position: absolute;
    inset-block-start: 10px;
    inset-inline-end: 10px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-background);
    color: #d7283f;
    box-shadow: 0 10px 24px rgb(var(--color-foreground-rgb) / 0.14);
    cursor: pointer;
  }

  .wishlist-card__remove svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .wishlist-card .quick-add {
    --button-size-md: 42px;
    --padding-sm: 10px;
    --padding-md: 10px;
    --padding-inline-end: 0px;
    --padding-block-end: 0px;
    --border-radius: 8px;
  }

  .wishlist-card .quick-add__button {
    box-shadow: 0 10px 24px rgb(var(--color-foreground-rgb) / 0.14);
  }

  .wishlist-card__content {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 12px;
    min-width: 0;
    padding: 16px;
  }

  .wishlist-card__title {
    color: var(--color-foreground);
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 1.8vw, 1.65rem);
    font-weight: var(--font-heading--weight);
    line-height: 1.15;
    text-decoration: none;
  }

  .wishlist-card__details {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 8px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .wishlist-card__details span {
    min-width: 0;
    padding: 5px 9px;
    border: 1px solid rgb(var(--color-border-rgb) / 0.45);
    border-radius: 999px;
    overflow-wrap: anywhere;
  }

  .wishlist-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block-start: 4px;
  }

  .wishlist-card__price {
    margin: 0;
    color: #8a4b08;
    font-family: var(--font-heading--family);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .wishlist-card__view {
    flex: 0 0 auto;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }

  @media screen and (max-width: 989px) {
    .wishlist-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .wishlist-page__hero {
      min-height: 300px;
      align-items: end;
      background:
        linear-gradient(180deg, rgb(255 252 247 / 78%) 0%, rgb(255 252 247 / 94%) 62%, rgb(255 252 247 / 98%) 100%),
        url("https://cdn.shopify.com/s/files/1/1003/6353/4631/files/Return_exchange_banner_image.webp?v=1790160147") 64% center / cover no-repeat;
    }

    .wishlist-page__hero-content {
      padding-block: 32px;
    }

    .wishlist-page__summary {
      align-items: stretch;
      flex-direction: column;
    }

    .wishlist-page__share {
      width: 100%;
    }
  }

  @media screen and (max-width: 560px) {
    .wishlist-page__grid {
      grid-template-columns: 1fr;
    }

    .wishlist-card__image,
    .wishlist-card__placeholder {
      aspect-ratio: 1 / 0.72;
    }
  }
{% endstylesheet %}
