{% doc %}
  Renders the browser-based wishlist content.
  @example
  {% render 'wishlist-content' %}
{% enddoc %}

<section class="wishlist-page section section--page-width" data-wishlist-page>
  <nav class="wishlist-page__breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">/</span>
    <span>Wishlist</span>
  </nav>

  <header class="wishlist-page__header">
    <h1>My Wishlist <span data-wishlist-count></span></h1>
    <button class="wishlist-page__share" type="button" data-wishlist-share>
      <span aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M18 16.1c-1.1 0-2 .5-2.7 1.3L8.9 13.7c.1-.3.1-.5.1-.8s0-.5-.1-.8l6.3-3.7A3.2 3.2 0 1 0 14.5 7L8.2 10.7a3.2 3.2 0 1 0 0 4.6l6.4 3.8A3.2 3.2 0 1 0 18 16.1Zm0-12.2a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6ZM6 14.2a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Zm12 5.9a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Z" />
        </svg>
      </span>
      Share Wishlist
    </button>
  </header>

  <div class="wishlist-page__empty" data-wishlist-empty>
    <p>{{ 'products.gemstone.wishlist_empty' | t }}</p>
    <a href="{{ routes.collections_url }}" class="button">{{ 'actions.continue_shopping' | t }}</a>
  </div>

  <div class="wishlist-page__list" data-wishlist-grid hidden></div>
</section>

<script type="application/json" data-wishlist-product-details>
  {
    {% paginate collections.all.products by 250 %}
      {% for catalog_product in collections.all.products %}
        {% liquid
          assign catalog_variant = catalog_product.selected_or_first_available_variant
          assign catalog_color = catalog_product.metafields.custom.color.value | default: catalog_product.metafields.custom.color
          assign catalog_shape = catalog_product.metafields.custom.shape.value | default: catalog_product.metafields.custom.shape
          assign catalog_gemstone_type = catalog_product.metafields.custom.gemstone_type.value | default: catalog_product.metafields.custom.gemstone_type
          assign catalog_product_type = catalog_product.metafields.custom.gemstone_group.value | default: catalog_product.metafields.custom.gemstone_group | default: catalog_product.type
        %}
        {{ catalog_product.handle | json }}: {
          "color": {{ catalog_color | json }},
          "shape": {{ catalog_shape | json }},
          "gemstoneType": {{ catalog_gemstone_type | json }},
          "productType": {{ catalog_product_type | json }},
          "variantId": {{ catalog_variant.id | json }},
          "price": {{ catalog_variant.price | money | strip_html | json }},
          "url": {{ catalog_product.url | json }},
          "image": {% if catalog_product.featured_media.preview_image != blank %}{{ catalog_product.featured_media.preview_image | image_url: width: 600 | json }}{% else %}""{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    {% endpaginate %}
  }
</script>

{% javascript %}
  const wishlistEscapeHtml = (value = '') =>
    String(value).replace(/[&<>"']/g, (character) => {
      const replacements = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      };
      return replacements[character];
    });

  const wishlistColorMap = {
    black: '#111827',
    blue: '#0b3f9d',
    brown: '#8b5a2b',
    green: '#0f9f58',
    orange: '#f97316',
    pink: '#ec4899',
    purple: '#7c3aed',
    red: '#ef0015',
    white: '#f8fafc',
    yellow: '#eab308',
  };

  const getWishlistItems = () => JSON.parse(localStorage.getItem('raza-gems-wishlist') || '[]');
  const setWishlistItems = (wishlist) => localStorage.setItem('raza-gems-wishlist', JSON.stringify(wishlist));
  const wishlistCatalogSource = document.querySelector('[data-wishlist-product-details]');
  const wishlistProductCatalog = (() => {
    if (!wishlistCatalogSource) return {};

    try {
      return JSON.parse(wishlistCatalogSource.textContent || '{}');
    } catch (error) {
      return {};
    }
  })();

  const getWishlistColor = (color = '') => {
    const normalizedColor = color.toLowerCase().trim();
    return wishlistColorMap[normalizedColor] || normalizedColor || '#c49a4a';
  };

  const inferWishlistColor = (title = '') => {
    const normalizedTitle = title.toLowerCase();
    const titleColors = [
      ['ruby', 'Red'],
      ['garnet', 'Red'],
      ['coral', 'Red'],
      ['carnelian', 'Red'],
      ['sapphire', 'Blue'],
      ['aquamarine', 'Blue'],
      ['emerald', 'Green'],
      ['onyx', 'Green'],
      ['citrine', 'Yellow'],
      ['topaz', 'Yellow'],
      ['amethyst', 'Purple'],
      ['agate', 'Black'],
      ['diamond', 'White'],
    ];
    const match = titleColors.find(([name]) => normalizedTitle.includes(name));
    return match ? match[1] : '';
  };

  const getWishlistDetails = (product) => {
    const title = product.title || '';
    const catalogProduct = wishlistProductCatalog[product.handle] || {};
    const savedType = product.type || '';
    const genericTypes = ['gemstone', 'jewellery', 'jewelry', 'precious', 'semi-precious', 'semi precious', 'uncategorized'];
    const savedTypeIsSpecific = savedType && !genericTypes.includes(savedType.toLowerCase().trim());

    return {
      color: catalogProduct.color || product.color || product.colour || inferWishlistColor(title),
      shape: catalogProduct.shape || product.shape || product.cutShape || product.gemstoneShape || '',
      type:
        catalogProduct.gemstoneType ||
        product.gemstoneType ||
        product.gemstone_type ||
        product.stoneType ||
        (savedTypeIsSpecific ? savedType : '') ||
        (title.toLowerCase().includes('ring') ? 'Ring' : ''),
    };
  };

  const wishlistChip = (label, value, type = 'text') => {
    const displayValue = value || 'Not set';
    const safeLabel = wishlistEscapeHtml(label);
    const safeValue = wishlistEscapeHtml(displayValue);
    const emptyClass = value ? '' : ' wishlist-detail__pill--empty';

    if (type === 'color') {
      return `
        <div class="wishlist-detail">
          <span class="wishlist-detail__label">${safeLabel}</span>
          <span class="wishlist-detail__pill${emptyClass}">
            <span class="wishlist-detail__swatch" style="--wishlist-swatch: ${wishlistEscapeHtml(getWishlistColor(value))}"></span>
            ${safeValue}
          </span>
        </div>
      `;
    }

    return `
      <div class="wishlist-detail">
        <span class="wishlist-detail__label">${safeLabel}</span>
        <span class="wishlist-detail__pill${emptyClass}">
          <span class="wishlist-detail__icon" aria-hidden="true">${type === 'shape' ? '◇' : '♢'}</span>
          ${safeValue}
        </span>
      </div>
    `;
  };

  const renderRazaGemsWishlist = () => {
    const grid = document.querySelector('[data-wishlist-grid]');
    const empty = document.querySelector('[data-wishlist-empty]');
    const count = document.querySelector('[data-wishlist-count]');
    if (!grid || !empty) return;

    const wishlist = getWishlistItems();
    grid.innerHTML = '';
    grid.hidden = wishlist.length === 0;
    empty.hidden = wishlist.length > 0;

    if (count) {
      count.textContent = wishlist.length === 1 ? '(1 item)' : `(${wishlist.length} items)`;
    }

    wishlist.forEach((product) => {
      const catalogProduct = wishlistProductCatalog[product.handle] || {};
      const productDetails = getWishlistDetails(product);
      const productUrl = catalogProduct.url || product.url || '#';
      const productImage = catalogProduct.image || product.image;
      const productPrice = catalogProduct.price || product.price || '';
      const productVariantId = catalogProduct.variantId || product.variantId || '';
      const card = document.createElement('article');
      card.className = 'wishlist-item';
      card.innerHTML = `
        <a class="wishlist-item__image-link" href="${wishlistEscapeHtml(productUrl)}">
          ${
            productImage
              ? `<img src="${wishlistEscapeHtml(productImage)}" alt="${wishlistEscapeHtml(product.title || '')}" loading="lazy">`
              : '<div class="wishlist-item__placeholder"></div>'
          }
        </a>
        <div class="wishlist-item__content">
          <a class="wishlist-item__title" href="${wishlistEscapeHtml(productUrl)}">${wishlistEscapeHtml(product.title || '')}</a>
          <div class="wishlist-item__details">
            ${wishlistChip('Color', productDetails.color, 'color')}
            ${wishlistChip('Shape', productDetails.shape, 'shape')}
            ${wishlistChip('Type', productDetails.type, 'type')}
          </div>
        </div>
        <div class="wishlist-item__actions">
          <button class="wishlist-item__remove" type="button" aria-label="Remove ${wishlistEscapeHtml(product.title || 'product')}" data-wishlist-remove="${wishlistEscapeHtml(product.handle || '')}">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M9 3h6l1 2h4v2H4V5h4l1-2Zm-2 6h10l-.7 11H7.7L7 9Zm3 2v7h1.5v-7H10Zm2.5 0v7H14v-7h-1.5Z" />
            </svg>
          </button>
          <p class="wishlist-item__price">${wishlistEscapeHtml(productPrice)}</p>
          <button class="wishlist-item__add" type="button" data-wishlist-add-cart data-variant-id="${wishlistEscapeHtml(productVariantId)}" data-product-url="${wishlistEscapeHtml(productUrl)}">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M7 7V6a5 5 0 0 1 10 0v1h2l1 14H4L5 7h2Zm2 0h6V6a3 3 0 0 0-6 0v1Zm-2.1 2-.7 10h11.6l-.7-10H17v2h-2V9H9v2H7V9h-.1Z" />
            </svg>
            Add to cart
          </button>
          <a class="wishlist-item__view" href="${wishlistEscapeHtml(productUrl)}">
            View product
            <span aria-hidden="true">→</span>
          </a>
        </div>
      `;
      grid.appendChild(card);
    });
  };

  const getWishlistCartSectionIds = () =>
    Array.from(document.querySelectorAll('cart-items-component'))
      .map((component) => component.dataset.sectionId)
      .filter(Boolean);

  const resolveWishlistVariantId = async (button) => {
    if (button.dataset.variantId) return button.dataset.variantId;

    const productUrl = button.dataset.productUrl;
    if (!productUrl || productUrl === '#') return '';

    const productJsonUrl = `${productUrl.split('?')[0]}.js`;
    const response = await fetch(productJsonUrl, { headers: { Accept: 'application/json' } });
    if (!response.ok) return '';

    const product = await response.json();
    const variant = product.variants?.find((item) => item.available) || product.variants?.[0];
    const variantId = variant?.id ? String(variant.id) : '';

    if (variantId) {
      button.dataset.variantId = variantId;
    }

    return variantId;
  };

  const dispatchWishlistCartUpdate = (promise, variantId) => {
    const event = new CustomEvent('shopify:cart:lines-update', { bubbles: true });
    event.action = 'add';
    event.context = 'wishlist';
    event.lines = [{ merchandiseId: variantId, quantity: 1 }];
    event.promise = promise;
    document.dispatchEvent(event);
  };

  document.addEventListener('click', async (event) => {
    const removeButton = event.target.closest('[data-wishlist-remove]');
    const addButton = event.target.closest('[data-wishlist-add-cart]');
    const shareButton = event.target.closest('[data-wishlist-share]');

    if (removeButton) {
      const wishlist = getWishlistItems().filter((product) => product.handle !== removeButton.dataset.wishlistRemove);
      setWishlistItems(wishlist);
      renderRazaGemsWishlist();
      window.dispatchEvent(new CustomEvent('raza-gems:wishlist-updated', { detail: { count: wishlist.length } }));
      return;
    }

    if (addButton) {
      addButton.disabled = true;
      const originalHtml = addButton.innerHTML;
      addButton.textContent = 'Adding...';

      try {
        const variantId = await resolveWishlistVariantId(addButton);
        if (!variantId) throw new Error('Variant unavailable');

        const sectionIds = getWishlistCartSectionIds();
        const cartUpdatePromise = fetch(Theme?.routes?.cart_add_url || '/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1,
            sections: sectionIds.join(','),
          }),
        })
          .then(async (response) => {
            const data = await response.json();
            if (!response.ok || data.status) {
              throw new Error(data.description || data.message || 'Cart add failed');
            }

            return {
              cart: data,
              detail: {
                sections: data.sections,
                items: data.items,
                source: 'wishlist',
                itemCount: 1,
              },
            };
          });

        dispatchWishlistCartUpdate(cartUpdatePromise, variantId);
        await cartUpdatePromise;
        addButton.textContent = 'Added';
      } catch (error) {
        addButton.textContent = 'Try again';
      } finally {
        window.setTimeout(() => {
          addButton.disabled = false;
          addButton.innerHTML = originalHtml;
        }, 1600);
      }
      return;
    }

    if (shareButton) {
      const shareData = {
        title: 'My Wishlist',
        url: window.location.href,
      };

      if (navigator.share) {
        navigator.share(shareData);
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(shareData.url);
      }
    }
  });

  renderRazaGemsWishlist();
  window.addEventListener('raza-gems:wishlist-updated', renderRazaGemsWishlist);
{% endjavascript %}

{% stylesheet %}
  .wishlist-page {
    padding-block: clamp(22px, 3vw, 42px);
    color: #111827;
  }

  .wishlist-page__breadcrumb {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-block-end: 14px;
    color: #9ca3af;
    font-size: clamp(14px, 1.1vw, 18px);
  }

  .wishlist-page__breadcrumb a,
  .wishlist-page__breadcrumb span:last-child {
    color: #9a5a10;
    text-decoration: none;
  }

  .wishlist-page__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-block-end: 20px;
  }

  .wishlist-page__header h1 {
    margin: 0;
    color: #0b0b0c;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(34px, 4vw, 54px);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: 0;
  }

  .wishlist-page__header h1 span {
    color: #6b7280;
    font-family: var(--font-body--family);
    font-size: clamp(16px, 1.5vw, 24px);
    font-weight: 500;
  }

  .wishlist-page__share {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 46px;
    padding: 0 20px;
    border: 1px solid #f0e1cc;
    border-radius: 8px;
    background: #f8f1eb;
    color: #8a4b08;
    font: inherit;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
  }

  .wishlist-page__share svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .wishlist-page__empty {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding: 32px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #ffffff;
  }

  .wishlist-page__list {
    display: grid;
    gap: 14px;
  }

  .wishlist-item {
    display: grid;
    grid-template-columns: minmax(170px, 260px) minmax(0, 1fr) minmax(210px, 310px);
    gap: clamp(18px, 2.2vw, 32px);
    align-items: center;
    padding: 8px 16px 8px 8px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 12px 32px rgb(17 24 39 / 3%);
  }

  .wishlist-item__image-link {
    display: block;
    overflow: hidden;
    border-radius: 7px;
    background: #f4f4f4;
    aspect-ratio: 16 / 9.8;
  }

  .wishlist-item__image-link img,
  .wishlist-item__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wishlist-item__content {
    min-width: 0;
  }

  .wishlist-item__title {
    display: inline-block;
    margin-block-end: 18px;
    color: #0b0b0c;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(21px, 1.55vw, 28px);
    font-weight: 700;
    line-height: 1.15;
    text-decoration: none;
  }

  .wishlist-item__details {
    display: grid;
    grid-template-columns: repeat(3, minmax(92px, 1fr));
    gap: 10px;
  }

  .wishlist-detail {
    display: grid;
    gap: 6px;
    min-width: 0;
  }

  .wishlist-detail__label {
    color: #5f6673;
    font-size: 13px;
    line-height: 1.2;
  }

  .wishlist-detail__pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 42px;
    max-width: 100%;
    padding: 0 12px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    color: #374151;
    font-size: 14px;
    line-height: 1.2;
  }

  .wishlist-detail__pill--empty {
    color: #8b95a1;
    background: #f9fafb;
  }

  .wishlist-detail__swatch {
    width: 26px;
    height: 26px;
    flex: 0 0 auto;
    border: 1px solid rgb(17 24 39 / 10%);
    border-radius: 50%;
    background: var(--wishlist-swatch);
  }

  .wishlist-detail__icon {
    color: #111827;
    font-size: 22px;
    line-height: 1;
  }

  .wishlist-item__actions {
    position: relative;
    display: grid;
    gap: 10px;
    padding-inline-start: clamp(18px, 2.2vw, 30px);
    border-inline-start: 1px solid #e5e7eb;
  }

  .wishlist-item__remove {
    position: absolute;
    inset-block-start: -8px;
    inset-inline-end: -2px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: #f7f0f0;
    color: #7b4205;
    cursor: pointer;
  }

  .wishlist-item__remove svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .wishlist-item__price {
    margin: 0 48px 4px 0;
    color: #8a4b08;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(22px, 1.7vw, 30px);
    line-height: 1.1;
  }

  .wishlist-item__add,
  .wishlist-item__view {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 46px;
    border-radius: 8px;
    font: inherit;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
  }

  .wishlist-item__add {
    border: 0;
    background: linear-gradient(180deg, #c69648, #a66a1b);
    color: #ffffff;
    cursor: pointer;
  }

  .wishlist-item__add:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  .wishlist-item__add svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .wishlist-item__view {
    border: 1px solid #b78343;
    background: #ffffff;
    color: #8a4b08;
  }

  @media screen and (max-width: 1180px) {
    .wishlist-item {
      grid-template-columns: minmax(160px, 240px) minmax(0, 1fr);
      padding: 8px;
    }

    .wishlist-item__actions {
      grid-column: 1 / -1;
      grid-template-columns: minmax(140px, auto) 1fr 1fr auto;
      align-items: center;
      padding: 18px 0 0;
      border-block-start: 1px solid #e5e7eb;
      border-inline-start: 0;
    }

    .wishlist-item__remove {
      position: static;
      order: 4;
    }

    .wishlist-item__price {
      margin: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .wishlist-page {
      padding-block: 18px 34px;
    }

    .wishlist-page__breadcrumb {
      margin-block-end: 12px;
      font-size: 13px;
    }

    .wishlist-page__header {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
      margin-block-end: 16px;
    }

    .wishlist-page__header h1 {
      font-size: clamp(32px, 10vw, 42px);
    }

    .wishlist-page__share {
      width: 100%;
      min-height: 44px;
      font-size: 14px;
    }

    .wishlist-item {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 8px;
    }

    .wishlist-item__image-link {
      aspect-ratio: 16 / 9;
    }

    .wishlist-item__title {
      margin-block-end: 12px;
      font-size: 22px;
    }

    .wishlist-item__details {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .wishlist-detail__pill {
      min-height: 40px;
      font-size: 14px;
    }

    .wishlist-item__actions {
      grid-template-columns: 1fr;
    }

    .wishlist-item__remove {
      position: absolute;
      inset-block-start: 10px;
      inset-inline-end: 10px;
      width: 38px;
      height: 38px;
    }

    .wishlist-item__price {
      padding-inline-end: 48px;
      font-size: 24px;
    }

    .wishlist-item__add,
    .wishlist-item__view {
      min-height: 44px;
      font-size: 15px;
    }
  }

  @media screen and (max-width: 420px) {
    .wishlist-item__details {
      grid-template-columns: 1fr;
    }

    .wishlist-detail {
      grid-template-columns: 58px minmax(0, 1fr);
      align-items: center;
    }

    .wishlist-detail__label {
      font-size: 12px;
    }
  }
{% endstylesheet %}
