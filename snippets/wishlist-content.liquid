{% doc %}
  Renders the browser-based wishlist content.
  @param {string} [section_id] - Parent section id for quick-add forms.
  @example
  {% render 'wishlist-content', section_id: section.id %}
{% enddoc %}

{% liquid
  assign wishlist_section_id = section_id | default: 'wishlist-page'
%}

<section class="wishlist-page" data-wishlist-page>
  <div class="wishlist-page__hero">
    <div class="wishlist-page__hero-content">
      <nav class="wishlist-page__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        <span>{{ 'products.gemstone.wishlist' | t }}</span>
      </nav>

      <p class="wishlist-page__eyebrow">{{ 'products.gemstone.wishlist_saved_favourites' | t }}</p>
      <h1>{{ 'products.gemstone.wishlist_title' | t }}</h1>
      <p class="wishlist-page__intro">{{ 'products.gemstone.wishlist_intro' | t }}</p>
    </div>
  </div>

  <div class="wishlist-page__shell section section--page-width">
    <div class="wishlist-page__summary" data-wishlist-summary hidden>
      <p class="wishlist-page__count" data-wishlist-count></p>
    </div>

    <div class="wishlist-page__empty" data-wishlist-empty>
      <span class="wishlist-page__empty-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M12 21.4 10.6 20.1C5.4 15.4 2 12.3 2 8.5 2 5.4 4.4 3 7.5 3c1.7 0 3.4.8 4.5 2.1C13.1 3.8 14.8 3 16.5 3 19.6 3 22 5.4 22 8.5c0 3.8-3.4 6.9-8.6 11.6L12 21.4Zm0-2.7.1-.1c4.8-4.3 7.9-7.2 7.9-10.1C20 6.5 18.5 5 16.5 5c-1.5 0-3 .9-3.6 2.1h-1.8C10.5 5.9 9 5 7.5 5 5.5 5 4 6.5 4 8.5c0 2.9 3.1 5.8 7.9 10.1l.1.1Z" />
        </svg>
      </span>
      <h2>{{ 'products.gemstone.wishlist_empty_title' | t }}</h2>
      <p>{{ 'products.gemstone.wishlist_empty_body' | t }}</p>
      <a href="{{ routes.root_url }}" class="button">{{ 'actions.continue_shopping' | t }}</a>
    </div>

    <ul
      class="wishlist-page__grid"
      data-wishlist-grid
      data-count-one="{{ 'products.gemstone.wishlist_count.one' | t: count: 1 | escape }}"
      data-count-other="{{ 'products.gemstone.wishlist_count.other' | t: count: 'COUNT' | escape }}"
      hidden
      role="list"
    >
      {% paginate collections.all.products by 250 %}
        {% for wishlist_product in collections.all.products %}
          {% liquid
            assign selected_variant = wishlist_product.selected_or_first_available_variant
            assign gemstone_type = wishlist_product.metafields.custom.gemstone_type.value | default: wishlist_product.metafields.custom.gemstone_type
            assign gemstone_group = wishlist_product.metafields.custom.gemstone_group.value | default: wishlist_product.metafields.custom.gemstone_group | default: wishlist_product.type
            assign shape = wishlist_product.metafields.custom.shape.value | default: wishlist_product.metafields.custom.shape
            assign product_color = wishlist_product.metafields.custom.color.value | default: wishlist_product.metafields.custom.color
            assign carat_weight = wishlist_product.metafields.custom.actual_carat_weight.value
            assign certification_status = wishlist_product.metafields.custom.certification_status.value
            assign wishlist_add_to_cart_text = 'actions.add_to_cart' | t
            assign detail_count = 0
          %}
          <li
            class="wishlist-page__grid-item"
            data-wishlist-card
            data-product-handle="{{ wishlist_product.handle | escape }}"
            hidden
          >
            <product-card
              class="wishlist-card"
              data-product-id="{{ wishlist_product.id }}"
              style="
                --quick-add-display: flex;
                --quick-add-mobile-display: flex;
                --quick-add-mobile-opacity: 1;
              "
            >
              <div class="wishlist-card__media">
                <a
                  class="wishlist-card__image-link"
                  href="{{ wishlist_product.url }}"
                  ref="productCardLink"
                  aria-label="{{ wishlist_product.title | escape }}"
                >
                  {% if wishlist_product.featured_media.preview_image != blank %}
                    {{
                      wishlist_product.featured_media.preview_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '300, 450, 600, 750, 900',
                        sizes: '(min-width: 990px) 25vw, (min-width: 750px) 40vw, 90vw',
                        alt: wishlist_product.title,
                        class: 'wishlist-card__image'
                    }}
                  {% else %}
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'wishlist-card__placeholder' }}
                  {% endif %}
                </a>
              </div>

              <div class="wishlist-card__content">
                <div class="wishlist-card__header">
                  <a class="wishlist-card__title" href="{{ wishlist_product.url }}">{{ wishlist_product.title }}</a>
                  <div class="wishlist-card__tools">
                    <button
                      class="wishlist-card__tool wishlist-card__tool--trash"
                      type="button"
                      aria-label="{{ 'products.gemstone.remove_from_wishlist' | t: product: wishlist_product.title | escape }}"
                      data-wishlist-remove="{{ wishlist_product.handle | escape }}"
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M9 3h6l1 2h4v2H4V5h4l1-2Zm-2 6h10l-.7 11H7.7L7 9Zm3 2v7h1.5v-7H10Zm2.5 0v7H14v-7h-1.5Z" />
                      </svg>
                    </button>
                  </div>
                </div>

                <div class="wishlist-card__details">
                  {% if product_color != blank %}
                    {% assign detail_count = detail_count | plus: 1 %}
                    <div class="wishlist-card__detail">
                      <span class="wishlist-card__detail-label">{{ 'products.gemstone.color' | t }}</span>
                      <span class="wishlist-card__detail-separator">:</span>
                      <span class="wishlist-card__detail-value">
                        <span class="wishlist-card__color-dot" style="--wishlist-card-color: {{ product_color | escape }}"></span>
                        {{ product_color }}
                      </span>
                    </div>
                  {% endif %}
                  {% if shape != blank %}
                    {% assign detail_count = detail_count | plus: 1 %}
                    <div class="wishlist-card__detail">
                      <span class="wishlist-card__detail-label">{{ 'products.gemstone.shape' | t }}</span>
                      <span class="wishlist-card__detail-separator">:</span>
                      <span class="wishlist-card__detail-value">
                        <span class="wishlist-card__diamond" aria-hidden="true"></span>
                        {{ shape }}
                      </span>
                    </div>
                  {% endif %}
                  {% if gemstone_type != blank %}
                    {% assign detail_count = detail_count | plus: 1 %}
                    <div class="wishlist-card__detail">
                      <span class="wishlist-card__detail-label">{{ 'products.gemstone.stone_type' | t }}</span>
                      <span class="wishlist-card__detail-separator">:</span>
                      <span class="wishlist-card__detail-value">
                        <span class="wishlist-card__diamond" aria-hidden="true"></span>
                        {{ gemstone_type }}
                      </span>
                    </div>
                  {% elsif gemstone_group != blank %}
                    {% assign detail_count = detail_count | plus: 1 %}
                    <div class="wishlist-card__detail">
                      <span class="wishlist-card__detail-label">{{ 'products.gemstone.group' | t }}</span>
                      <span class="wishlist-card__detail-separator">:</span>
                      <span class="wishlist-card__detail-value">
                        <span class="wishlist-card__diamond" aria-hidden="true"></span>
                        {{ gemstone_group }}
                      </span>
                    </div>
                  {% endif %}
                  {% if carat_weight != blank %}
                    {% assign detail_count = detail_count | plus: 1 %}
                    <div class="wishlist-card__detail">
                      <span class="wishlist-card__detail-label">{{ 'products.gemstone.carat_weight' | t }}</span>
                      <span class="wishlist-card__detail-separator">:</span>
                      <span class="wishlist-card__detail-value">{{ carat_weight }}</span>
                    </div>
                  {% endif %}
                  {% if detail_count == 0 and certification_status != blank %}
                    <div class="wishlist-card__detail">
                      <span class="wishlist-card__detail-value">{{ certification_status }}</span>
                    </div>
                  {% endif %}
                </div>

                <p class="wishlist-card__price">{{ selected_variant.price | money }}</p>
              </div>

              <div class="wishlist-card__actions">
                <a class="wishlist-card__view" href="{{ wishlist_product.url }}">{{ 'products.gemstone.view_product' | t }}</a>
                {% if wishlist_product.available %}
                  {% render 'quick-add',
                    product: wishlist_product,
                    section_id: wishlist_section_id,
                    quick_add_text: wishlist_add_to_cart_text
                  %}
                {% else %}
                  <button class="wishlist-card__sold-out" type="button" disabled>{{ 'products.product.sold_out' | t }}</button>
                {% endif %}
              </div>
            </product-card>
          </li>
        {% endfor %}
      {% endpaginate %}
    </ul>
  </div>
</section>

{% javascript %}
  const wishlistPage = document.querySelector('[data-wishlist-page]');
  const getWishlistItems = () => JSON.parse(localStorage.getItem('raza-gems-wishlist') || '[]');
  const setWishlistItems = (wishlist) => localStorage.setItem('raza-gems-wishlist', JSON.stringify(wishlist));

  const renderRazaGemsWishlist = () => {
    if (!wishlistPage) return;

    const grid = wishlistPage.querySelector('[data-wishlist-grid]');
    const empty = wishlistPage.querySelector('[data-wishlist-empty]');
    const summary = wishlistPage.querySelector('[data-wishlist-summary]');
    const count = wishlistPage.querySelector('[data-wishlist-count]');
    if (!grid || !empty || !summary) return;

    const wishlist = getWishlistItems().filter((item) => item.handle);
    const cards = Array.from(grid.querySelectorAll('[data-wishlist-card]'));
    const cardByHandle = new Map(cards.map((card) => [card.dataset.productHandle, card]));
    let visibleCount = 0;

    cards.forEach((card) => {
      card.hidden = true;
    });

    wishlist.forEach((item) => {
      const card = cardByHandle.get(item.handle);
      if (!card) return;

      card.hidden = false;
      grid.appendChild(card);
      visibleCount += 1;
    });

    grid.hidden = visibleCount === 0;
    summary.hidden = visibleCount === 0;
    empty.hidden = visibleCount > 0;

    if (count) {
      count.textContent =
        visibleCount === 1 ? grid.dataset.countOne : grid.dataset.countOther.replace('COUNT', String(visibleCount));
    }
  };

  document.addEventListener('click', (event) => {
    if (!wishlistPage) return;

    const removeButton = event.target.closest('[data-wishlist-remove]');

    if (removeButton) {
      const wishlist = getWishlistItems().filter((product) => product.handle !== removeButton.dataset.wishlistRemove);
      setWishlistItems(wishlist);
      renderRazaGemsWishlist();
      window.dispatchEvent(new CustomEvent('raza-gems:wishlist-updated', { detail: { count: wishlist.length } }));
    }
  });

  renderRazaGemsWishlist();
  window.addEventListener('raza-gems:wishlist-updated', renderRazaGemsWishlist);
  window.addEventListener('storage', renderRazaGemsWishlist);
{% endjavascript %}

{% stylesheet %}
  .wishlist-page {
    color: var(--color-foreground);
    background: var(--color-background);
  }

  .wishlist-page__hero {
    position: relative;
    min-height: clamp(230px, 28vw, 360px);
    display: grid;
    align-items: center;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgb(255 252 247 / 96%) 0%, rgb(255 252 247 / 82%) 43%, rgb(255 252 247 / 10%) 72%),
      url("https://cdn.shopify.com/s/files/1/1003/6353/4631/files/Return_exchange_banner_image.webp?v=1790160147") center / cover no-repeat;
  }

  .wishlist-page__hero-content {
    width: min(var(--page-width), calc(100% - var(--page-margin) * 2));
    margin-inline: auto;
    padding-block: clamp(34px, 6vw, 76px);
  }

  .wishlist-page__breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-block-end: 18px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: 0.9rem;
  }

  .wishlist-page__breadcrumb a,
  .wishlist-page__breadcrumb span:last-child {
    color: #8a4b08;
    text-decoration: none;
  }

  .wishlist-page__eyebrow,
  .wishlist-page__intro {
    max-width: 34rem;
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    line-height: 1.45;
  }

  .wishlist-page__hero h1 {
    max-width: 36rem;
    margin: 0 0 8px;
    color: var(--color-foreground);
    font-family: var(--font-heading--family);
    font-size: clamp(2.8rem, 6vw, 5.7rem);
    font-weight: var(--font-heading--weight);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .wishlist-page__shell {
    padding-block: clamp(22px, 4vw, 52px);
  }

  .wishlist-page__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-block-end: 18px;
    padding: 14px 18px;
    border: 1px solid rgb(var(--color-border-rgb) / 0.45);
    border-radius: 8px;
    background: rgb(var(--color-background-rgb) / 0.86);
    box-shadow: 0 16px 42px rgb(var(--color-foreground-rgb) / 0.06);
  }

  .wishlist-page__count {
    margin: 0;
    font-weight: 700;
  }

  .wishlist-page__summary[hidden],
  .wishlist-page__empty[hidden],
  .wishlist-page__grid[hidden],
  .wishlist-page__grid-item[hidden] {
    display: none;
  }

  .wishlist-page__empty {
    display: grid;
    justify-items: center;
    gap: 12px;
    min-height: 270px;
    padding: clamp(34px, 6vw, 70px) 18px;
    border: 1px dashed rgb(var(--color-border-rgb) / 0.55);
    border-radius: 8px;
    text-align: center;
  }

  .wishlist-page__empty-icon {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #f8efe6;
    color: #8a4b08;
  }

  .wishlist-page__empty-icon svg {
    width: 30px;
    height: 30px;
    fill: currentColor;
  }

  .wishlist-page__empty h2 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    line-height: 1.1;
  }

  .wishlist-page__empty p {
    max-width: 32rem;
    margin: 0 0 8px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .wishlist-page__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 22px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wishlist-page__grid-item {
    min-width: 0;
  }

  .wishlist-card {
    display: grid;
    height: 100%;
    grid-template-columns: minmax(118px, 38%) minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    gap: 14px;
    overflow: hidden;
    padding: 10px;
    border: 1px solid rgb(var(--color-border-rgb) / 0.55);
    border-radius: 8px;
    background: var(--color-background);
    box-shadow: 0 12px 30px rgb(var(--color-foreground-rgb) / 0.08);
  }

  .wishlist-card__media {
    position: relative;
    overflow: hidden;
    align-self: stretch;
    border-radius: 8px;
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .wishlist-card__image-link {
    display: block;
  }

  .wishlist-card__image,
  .wishlist-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 132px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .wishlist-card:hover .wishlist-card__image {
    transform: scale(1.025);
  }

  .wishlist-card__content {
    display: grid;
    gap: 9px;
    min-width: 0;
    padding: 2px 4px 0 0;
  }

  .wishlist-card__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    align-items: start;
  }

  .wishlist-card__title {
    color: var(--color-foreground);
    font-family: var(--font-heading--family);
    font-size: clamp(1.2rem, 1.35vw, 1.55rem);
    font-weight: var(--font-heading--weight);
    line-height: 1.15;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .wishlist-card__tools {
    display: flex;
    gap: 8px;
  }

  .wishlist-card__tool {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #f8f1ed;
    color: #8a4b08;
    cursor: pointer;
  }

  .wishlist-card__tool svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
  }

  .wishlist-card__details {
    display: grid;
    gap: 7px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .wishlist-card__detail {
    display: grid;
    grid-template-columns: 44px 8px minmax(0, 1fr);
    gap: 8px;
    align-items: center;
    min-width: 0;
  }

  .wishlist-card__detail-label,
  .wishlist-card__detail-separator {
    color: rgb(var(--color-foreground-rgb) / 0.68);
  }

  .wishlist-card__detail-value {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    color: rgb(var(--color-foreground-rgb) / 0.72);
    overflow-wrap: anywhere;
  }

  .wishlist-card__color-dot {
    width: 12px;
    height: 12px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--wishlist-card-color, #b87922);
  }

  .wishlist-card__diamond {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border: 1.5px solid currentColor;
    transform: rotate(45deg);
  }

  .wishlist-card__price {
    margin: 0;
    color: #8a4b08;
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 1.45vw, 1.55rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .wishlist-card__actions {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 10px;
  }

  .wishlist-card__view {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    border: 1px solid #b78343;
    border-radius: 6px;
    background: var(--color-background);
    color: #8a4b08;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .wishlist-card__actions .quick-add {
    --button-size-md: 38px;
    --quick-add-collapsed-width: 100%;
    --quick-add-expanded-width: 100%;
    --padding-sm: 12px;
    --padding-md: 12px;
    --padding-inline-end: 0px;
    --padding-block-end: 0px;
    --border-radius: 6px;
    position: static;
    inset: auto;
    pointer-events: auto;
    z-index: auto;
    display: block;
    min-width: 0;
  }

  .wishlist-card__actions .quick-add__product-form-component,
  .wishlist-card__actions .quick-add__product-form-component .shopify-product-form {
    height: 100%;
    width: 100%;
  }

  .wishlist-card__actions button.quick-add__button,
  .wishlist-card__sold-out {
    position: static;
    inset: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    max-inline-size: none;
    min-height: 38px;
    height: 38px;
    padding: 0 14px;
    border: 0;
    border-radius: 6px;
    background: linear-gradient(180deg, #bd8532, #98600f);
    color: #ffffff;
    box-shadow: none;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .wishlist-card__actions .quick-add__button > .add-to-cart-icon {
    width: 18px;
    height: 18px;
  }

  .wishlist-card__actions .quick-add__button:is(:hover, :focus-visible) {
    width: 100%;
    padding-inline-end: 14px;
  }

  .wishlist-card__sold-out {
    opacity: 0.6;
  }

  @media screen and (max-width: 989px) {
    .wishlist-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .wishlist-page__hero {
      align-items: end;
      background:
        linear-gradient(180deg, rgb(255 252 247 / 78%) 0%, rgb(255 252 247 / 94%) 62%, rgb(255 252 247 / 98%) 100%),
        url("https://cdn.shopify.com/s/files/1/1003/6353/4631/files/Return_exchange_banner_image.webp?v=1790160147") 64% center / cover no-repeat;
    }

    .wishlist-page__hero-content {
      padding-block: 32px;
    }

    .wishlist-page__summary {
      align-items: stretch;
      flex-direction: column;
    }

  }

  @media screen and (max-width: 560px) {
    .wishlist-page__shell {
      padding-block: 12px 28px;
    }

    .wishlist-page__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .wishlist-card {
      grid-template-columns: 72px minmax(0, 1fr);
      grid-template-rows: auto auto auto auto;
      column-gap: 10px;
      row-gap: 8px;
      padding: 8px;
      box-shadow: 0 8px 22px rgb(var(--color-foreground-rgb) / 0.08);
    }

    .wishlist-card__media {
      grid-column: 1;
      grid-row: 1 / span 2;
      align-self: start;
      width: 72px;
    }

    .wishlist-card__image,
    .wishlist-card__placeholder {
      min-height: 0;
      height: 92px;
      aspect-ratio: auto;
    }

    .wishlist-card__content {
      display: contents;
    }

    .wishlist-card__header {
      grid-column: 2;
      grid-row: 1;
      gap: 6px;
      padding-block-start: 1px;
    }

    .wishlist-card__title {
      font-size: 1.15rem;
      line-height: 1.18;
    }

    .wishlist-card__tools {
      gap: 5px;
    }

    .wishlist-card__tool {
      width: 24px;
      height: 24px;
    }

    .wishlist-card__tool svg {
      width: 13px;
      height: 13px;
    }

    .wishlist-card__details {
      grid-column: 2;
      grid-row: 2;
      gap: 3px;
      font-size: 0.68rem;
      line-height: 1.28;
    }

    .wishlist-card__detail {
      grid-template-columns: 52px 5px minmax(0, 1fr);
      gap: 5px;
    }

    .wishlist-card__detail-value {
      gap: 6px;
    }

    .wishlist-card__color-dot {
      width: 8px;
      height: 8px;
    }

    .wishlist-card__diamond {
      width: 6px;
      height: 6px;
      border-width: 1px;
    }

    .wishlist-card__price {
      grid-column: 1 / -1;
      grid-row: 3;
      margin-block-start: 2px;
      font-size: 1.35rem;
      line-height: 1.1;
    }

    .wishlist-card__actions {
      grid-column: 1 / -1;
      grid-row: 4;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 8px;
    }

    .wishlist-card__view,
    .wishlist-card__actions button.quick-add__button,
    .wishlist-card__sold-out {
      min-height: 34px;
      height: 34px;
      border-radius: 5px;
      font-size: 0.72rem;
    }

    .wishlist-card__actions .quick-add {
      --button-size-md: 34px;
    }

    .wishlist-card__actions .quick-add__button > .add-to-cart-icon {
      width: 13px;
      height: 13px;
    }
  }
{% endstylesheet %}
