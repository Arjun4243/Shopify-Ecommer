<span class="gemstone-landing-item">
  <span class="gemstone-landing-item__image">
    <img
      src="{{ image | asset_url }}"
      alt="{{ title | escape }}"
      loading="lazy"
      width="56"
      height="56"
    >
  </span>
  <span class="gemstone-landing-item__title">{{ title }}</span>
</span>
