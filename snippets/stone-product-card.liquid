{% doc %}
Renders a stone product card with gemstone details, sale badge, wishlist button, and pricing.
@param {product} product - Product object to render.
@param {string} [card_class] - Optional class prefix for page-specific styling hooks.
@param {string} [section_id] - Parent section id for quick-add.
@param {boolean} [quick_add_enabled] - Whether quick-add should render.
@example
{% render 'stone-product-card', product: product, card_class: 'precious-product-card', section_id: section.id, quick_add_enabled: true %}
{% enddoc %}

{% liquid
  assign card_class = card_class | default: 'stone-product-card'
  assign selected_variant = product.selected_or_first_available_variant
  assign shape = product.metafields.custom.shape.value
  assign carat_weight = product.metafields.custom.actual_carat_weight.value
  assign certification_status = product.metafields.custom.certification_status.value
  assign compare_at_price = selected_variant.compare_at_price
  assign price = selected_variant.price
  assign show_sale_badge = false

  if compare_at_price > price
    assign show_sale_badge = true
  endif

  assign detail_count = 0
%}

<product-card class="product-card stone-product-card {{ card_class }}" data-product-id="{{ product.id }}">
  <div class="stone-product-card__content">
    <div class="stone-product-card__media">
      <a class="stone-product-card__image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
        {% if product.featured_media.preview_image != blank %}
          {{
            product.featured_media.preview_image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '300, 450, 600, 750, 900',
              sizes: '(min-width: 1000px) 25vw, (min-width: 750px) 33vw, 50vw',
              alt: product.title,
              class: 'stone-product-card__image'
          }}
        {% else %}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'stone-product-card__placeholder' }}
        {% endif %}
      </a>

      {% if show_sale_badge %}
        <span class="stone-product-card__badge">Sale</span>
      {% endif %}

      <button
        class="stone-product-card__wishlist"
        type="button"
        aria-label="{{ 'products.gemstone.add_to_wishlist' | t | default: 'Add to wishlist' }}"
        data-stone-wishlist
        data-product-handle="{{ product.handle | escape }}"
        data-product-title="{{ product.title | escape }}"
        data-product-url="{{ product.url }}"
        data-product-image="{% if product.featured_media.preview_image != blank %}{{ product.featured_media.preview_image | image_url: width: 600 }}{% endif %}"
        data-product-price="{{ price | money | strip_html | escape }}"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path class="stone-product-card__heart-outline" d="M12 21.4 10.6 20.1C5.4 15.4 2 12.3 2 8.5 2 5.4 4.4 3 7.5 3c1.7 0 3.4.8 4.5 2.1C13.1 3.8 14.8 3 16.5 3 19.6 3 22 5.4 22 8.5c0 3.8-3.4 6.9-8.6 11.6L12 21.4Zm0-2.7.1-.1c4.8-4.3 7.9-7.2 7.9-10.1C20 6.5 18.5 5 16.5 5c-1.5 0-3 .9-3.6 2.1h-1.8C10.5 5.9 9 5 7.5 5 5.5 5 4 6.5 4 8.5c0 2.9 3.1 5.8 7.9 10.1l.1.1Z" />
          <path class="stone-product-card__heart-fill" d="M12 21.4 10.6 20.1C5.4 15.4 2 12.3 2 8.5 2 5.4 4.4 3 7.5 3c1.7 0 3.4.8 4.5 2.1C13.1 3.8 14.8 3 16.5 3 19.6 3 22 5.4 22 8.5c0 3.8-3.4 6.9-8.6 11.6L12 21.4Z" />
        </svg>
      </button>

      {% if product.available and quick_add_enabled %}
        {% render 'quick-add', product: product, section_id: section_id %}
      {% endif %}
    </div>

    <a class="stone-product-card__title" href="{{ product.url }}">{{ product.title }}</a>

    {% if shape != blank or carat_weight != blank or certification_status != blank %}
      <p class="stone-product-card__details">
        {% if shape != blank %}
          {% assign detail_count = detail_count | plus: 1 %}
          <span>{{ shape }}</span>
        {% endif %}
        {% if carat_weight != blank %}
          {% assign carat_text = carat_weight %}
          {% assign carat_text_downcase = carat_text | downcase %}
          {% unless carat_text_downcase contains 'ct' or carat_text_downcase contains 'carat' %}
            {% assign carat_text = carat_text | append: ' ct' %}
          {% endunless %}
          {% if detail_count > 0 %}<span aria-hidden="true">|</span>{% endif %}
          {% assign detail_count = detail_count | plus: 1 %}
          <span>{{ carat_text }}</span>
        {% endif %}
        {% if certification_status != blank %}
          {% if detail_count > 0 %}<span aria-hidden="true">|</span>{% endif %}
          <span>{{ certification_status }}</span>
        {% endif %}
      </p>
    {% endif %}

    <div class="stone-product-card__price">
      <span class="stone-product-card__price-current">{{ price | money }}</span>
      {% if show_sale_badge %}
        <span class="stone-product-card__price-compare">{{ compare_at_price | money }}</span>
      {% endif %}
    </div>
  </div>
</product-card>

{% javascript %}
  const wishlistStorageKey = 'raza-gems-wishlist';
  const getStoneWishlist = () => JSON.parse(localStorage.getItem(wishlistStorageKey) || '[]');
  const setStoneWishlist = (wishlist) => localStorage.setItem(wishlistStorageKey, JSON.stringify(wishlist));

  const syncStoneWishlistButtons = () => {
    const wishlist = getStoneWishlist();

    document.querySelectorAll('[data-stone-wishlist]').forEach((button) => {
      const active = wishlist.some((item) => item.handle === button.dataset.productHandle);
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });
  };

  document.addEventListener('click', (event) => {
    const button = event.target.closest('[data-stone-wishlist]');

    if (!button) return;

    const wishlist = getStoneWishlist();
    const product = {
      handle: button.dataset.productHandle,
      title: button.dataset.productTitle,
      url: button.dataset.productUrl,
      image: button.dataset.productImage,
      price: button.dataset.productPrice,
    };
    const existingIndex = wishlist.findIndex((item) => item.handle === product.handle);

    if (existingIndex > -1) {
      wishlist.splice(existingIndex, 1);
    } else {
      wishlist.unshift(product);
    }

    setStoneWishlist(wishlist);
    syncStoneWishlistButtons();
    window.dispatchEvent(new CustomEvent('raza-gems:wishlist-updated', { detail: { count: wishlist.length } }));
  });

  syncStoneWishlistButtons();
  window.addEventListener('raza-gems:wishlist-updated', syncStoneWishlistButtons);
{% endjavascript %}

{% stylesheet %}
  .stone-product-card {
    display: block;
    min-width: 0;
    font-family: Inter, sans-serif;
  }

  .stone-product-card__content {
    display: grid;
    gap: 8px;
  }

  .stone-product-card__media {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background: #f5efe7;
  }

  .stone-product-card__image-link {
    display: block;
  }

  .stone-product-card__image,
  .stone-product-card__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .stone-product-card__badge,
  .stone-product-card__wishlist {
    position: absolute;
    top: 10px;
    z-index: 2;
    min-height: 30px;
    border: 0;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 3px 10px rgb(0 0 0 / 12%);
  }

  .stone-product-card__badge {
    left: 10px;
    display: inline-flex;
    align-items: center;
    padding: 0 10px;
    color: #1e1f24;
    font-size: 12px;
    font-weight: 800;
  }

  .stone-product-card__wishlist {
    right: 10px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    color: #242830;
    cursor: pointer;
  }

  .stone-product-card__wishlist svg {
    width: 19px;
    height: 19px;
    fill: currentColor;
  }

  .stone-product-card__heart-fill {
    display: none;
  }

  .stone-product-card__wishlist.is-active {
    color: #c82f4a;
  }

  .stone-product-card__wishlist.is-active .stone-product-card__heart-outline {
    display: none;
  }

  .stone-product-card__wishlist.is-active .stone-product-card__heart-fill {
    display: block;
  }

  .stone-product-card__title {
    margin-top: 4px;
    color: #141820;
    font-size: clamp(15px, 1vw, 17px);
    font-weight: 800;
    line-height: 1.25;
    text-decoration: none;
  }

  .stone-product-card__details {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: -2px 0 0;
    color: #727780;
    font-size: clamp(12px, 0.85vw, 14px);
    font-weight: 700;
    line-height: 1.3;
  }

  .stone-product-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-top: 4px;
    color: #111722;
    font-size: clamp(14px, 1vw, 16px);
    font-weight: 900;
    line-height: 1.3;
  }

  .stone-product-card__price-compare {
    color: #81858d;
    font-weight: 700;
    text-decoration: line-through;
  }

  @media screen and (max-width: 640px) {
    .stone-product-card__badge {
      min-height: 26px;
      padding: 0 8px;
      font-size: 11px;
    }

    .stone-product-card__wishlist {
      width: 30px;
      height: 30px;
    }
  }
{% endstylesheet %}
