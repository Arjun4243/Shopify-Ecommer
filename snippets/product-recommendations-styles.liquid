{%- doc -%}
  Shared product recommendations styles used by the section and block.

  @example
  {% render 'product-recommendations-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-recommendations {
    display: block;
  }

  .product-recommendations__skeleton-item {
    aspect-ratio: 3 / 4;
    background-color: var(--color-foreground);
    opacity: var(--skeleton-opacity);
    border-radius: 4px;
  }

  @media screen and (max-width: 749px) {
    .product-recommendations__skeleton-item:nth-child(2n + 1) {
      display: none;
    }
  }

  @media screen and (min-width: 768px) and (max-width: 1199px) {
    .product-recommendations .responsive-product-grid:not(.product-grid--organic, [product-grid-view='zoom-out'], [product-grid-view='mobile-single'], .stone-listing__grid--list) {
      grid-template-columns: var(--resource-list-columns);
    }
  }

  product-recommendations:has([data-has-recommendations='false']) {
    display: none;
  }
{% endstylesheet %}
