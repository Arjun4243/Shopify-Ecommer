{% doc %}
  Renders the fixed mobile action dock using global merchant colors and the existing wishlist, search, and cart actions.
  The spacer keeps footer content clear of the fixed bar.
  @example
  {% render 'mobile-search-dock' %}
{% enddoc %}

{% if settings.mobile_search_dock_enabled %}
  {% render 'contrast-override',
    background_color: settings.mobile_search_dock_background,
    border_color: settings.mobile_search_dock_border,
    section_id: 'mobile-search-dock',
    preset: 'ui'
  %}
  <div class="mobile-search-dock-spacer" aria-hidden="true"></div>
  <mobile-search-dock
    class="mobile-search-dock color-custom-mobile-search-dock"
    style="--mobile-search-dock-button-background: {{ settings.mobile_search_dock_button_background }}; --mobile-search-dock-button-text: {{ settings.mobile_search_dock_button_text }};"
  >
    <div class="mobile-search-dock__bar">
      <a
        class="mobile-search-dock__action"
        href="{{ routes.search_url }}?q=wishlist&type=product"
        aria-label="{{ 'accessibility.wishlist' | t }}"
      >
        <span class="mobile-search-dock__circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" focusable="false">
            <path d="M12 20.25s-7.25-4.35-9.4-9.1C1.1 7.84 3.07 4.5 6.48 4.5c2 0 3.42 1.06 4.22 2.22.22.32.38.58.5.78.12-.2.28-.46.5-.78.8-1.16 2.22-2.22 4.22-2.22 3.41 0 5.38 3.34 3.88 6.65-2.15 4.75-9.8 9.1-9.8 9.1Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
          </svg>
        </span>
      </a>

      <a
        class="mobile-search-dock__action"
        href="{{ routes.search_url }}"
        aria-label="{{ 'content.search_input_label' | t | escape }}"
        on:click="/openSearch"
      >
        <span class="mobile-search-dock__circle" aria-hidden="true">
          {{ 'icon-search.svg' | inline_asset_content }}
        </span>
      </a>

      {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
        <a
          class="mobile-search-dock__action"
          href="{{ routes.cart_url }}"
          on:click="/openCart"
          ref="cartTrigger"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="cart-drawer"
          aria-label="{{ 'accessibility.cart' | t }}"
        >
          <span class="mobile-search-dock__circle" aria-hidden="true">
            {{ 'icon-cart.svg' | inline_asset_content }}
          </span>
        </a>
      {% else %}
        <a
          class="mobile-search-dock__action"
          href="{{ routes.cart_url }}"
          aria-label="{{ 'accessibility.cart' | t }}"
        >
          <span class="mobile-search-dock__circle" aria-hidden="true">
            {{ 'icon-cart.svg' | inline_asset_content }}
          </span>
        </a>
      {% endif %}
    </div>
  </mobile-search-dock>
  <script src="{{ 'mobile-search-dock.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% endif %}

{% stylesheet %}
  .mobile-search-dock,
  .mobile-search-dock-spacer {
    display: none;
  }

  @media screen and (max-width: 749px) {
    body:has(.mobile-search-dock) .header__row--top .search-action,
    body:has(.mobile-search-dock) .header__row--top header-actions > .header-actions__wishlist,
    body:has(.mobile-search-dock) .header__row--top header-actions > [data-header-cart-trigger] {
      display: none;
    }

    .mobile-search-dock-spacer {
      display: block;
      block-size: calc(104px + env(safe-area-inset-bottom, 0px));
    }

    .mobile-search-dock {
      position: fixed;
      inset-inline: 12px;
      inset-block-end: calc(12px + env(safe-area-inset-bottom, 0px));
      z-index: var(--layer-sticky);
      display: block;
      border-radius: 999px;
    }

    .mobile-search-dock__bar {
      display: flex;
      align-items: center;
      justify-content: space-around;
      min-block-size: 48px;
      border: 2px solid var(--color-border);
      border-radius: inherit;
      background:
        linear-gradient(180deg, rgb(255 255 255 / var(--opacity-80)), transparent 52%),
        var(--color-background);
      box-shadow:
        inset 0 0 0 1px rgb(var(--color-border-rgb) / var(--opacity-40)),
        inset 0 -3px 7px rgb(var(--color-border-rgb) / var(--opacity-10)),
        0 3px 12px rgb(var(--color-foreground-rgb) / var(--opacity-15));
    }

    .mobile-search-dock__action {
      display: grid;
      place-items: center;
      flex: 0 0 var(--minimum-touch-target);
      min-inline-size: var(--minimum-touch-target);
      min-block-size: var(--minimum-touch-target);
      color: inherit;
      text-decoration: none;
    }

    .mobile-search-dock__circle {
      position: relative;
      isolation: isolate;
      display: grid;
      place-items: center;
      inline-size: 52px;
      block-size: 52px;
      border: 2px solid var(--color-border);
      border-radius: 50%;
      color: var(--mobile-search-dock-button-text);
      background:
        radial-gradient(circle at 27% 20%, rgb(255 255 255 / 0.35), transparent 11%),
        conic-gradient(
          from 22deg,
          color-mix(in srgb, var(--mobile-search-dock-button-background) 74%, #000) 0deg 34deg,
          color-mix(in srgb, var(--mobile-search-dock-button-background) 88%, #fff) 34deg 68deg,
          color-mix(in srgb, var(--mobile-search-dock-button-background) 63%, #000) 68deg 111deg,
          color-mix(in srgb, var(--mobile-search-dock-button-background) 94%, #fff) 111deg 154deg,
          color-mix(in srgb, var(--mobile-search-dock-button-background) 70%, #000) 154deg 196deg,
          color-mix(in srgb, var(--mobile-search-dock-button-background) 92%, #fff) 196deg 247deg,
          color-mix(in srgb, var(--mobile-search-dock-button-background) 62%, #000) 247deg 291deg,
          color-mix(in srgb, var(--mobile-search-dock-button-background) 90%, #fff) 291deg 360deg
        ),
        var(--mobile-search-dock-button-background);
      box-shadow:
        0 0 0 2px rgb(var(--color-background-rgb) / var(--opacity-70)),
        0 0 0 4px rgb(var(--color-border-rgb) / 0.55),
        0 4px 8px rgb(var(--color-foreground-rgb) / var(--opacity-30));
      transform: translateY(-18%);
      transition: transform var(--animation-speed) var(--animation-timing);
    }

    .mobile-search-dock__circle::before {
      position: absolute;
      z-index: -1;
      inset: 3px;
      border-radius: inherit;
      background:
        linear-gradient(137deg, transparent 42%, rgb(255 255 255 / var(--opacity-20)) 43% 45%, transparent 46%),
        linear-gradient(35deg, transparent 52%, rgb(255 255 255 / var(--opacity-20)) 53% 55%, transparent 56%);
      content: '';
    }

    .mobile-search-dock__circle svg {
      position: relative;
      z-index: 1;
      inline-size: 23px;
      block-size: 23px;
    }

    .mobile-search-dock__action:focus-visible {
      outline: 2px solid var(--mobile-search-dock-button-background);
      outline-offset: 4px;
    }

    .mobile-search-dock__action:is(:hover, :focus-visible) .mobile-search-dock__circle {
      transform: translateY(calc(-18% - 3px));
    }

    body:has(.sticky-add-to-cart__bar[data-stuck='true']) .mobile-search-dock {
      visibility: hidden;
      pointer-events: none;
    }
  }
{% endstylesheet %}
