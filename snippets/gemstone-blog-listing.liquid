{% doc %}
  Renders the gemstone blog header, metafield topic filters, and article cards.

  @param {object} blog_resource - Blog selected for this listing.
  @param {string} section_id - Parent section identifier.
  @param {image} [banner_image] - Optional banner image selected in the section settings.
  @param {string} [banner_eyebrow] - Small banner label.
  @param {string} [banner_heading] - Banner heading.
  @param {string} [banner_description] - Banner supporting text.
{% enddoc %}
<div class="gem-blog" data-gem-blog>
  {% if banner_image != blank or banner_heading != blank or banner_description != blank %}
    <div class="gem-blog__banner">
      {% if banner_image != blank %}
        {{
          banner_image
          | image_url: width: 1800
          | image_tag:
            class: 'gem-blog__banner-image',
            widths: '600, 900, 1200, 1800',
            sizes: '100vw',
            loading: 'eager',
            alt: banner_heading
        }}
      {% endif %}
      <div class="gem-blog__banner-content">
        {% if banner_eyebrow != blank %}
          <p class="gem-blog__banner-eyebrow">{{ banner_eyebrow | escape }}</p>
        {% endif %}
        {% if banner_heading != blank %}
          <h1>{{ banner_heading | escape }}</h1>
        {% endif %}
        {% if banner_description != blank %}
          <p>{{ banner_description | escape | newline_to_br }}</p>
        {% endif %}
      </div>
    </div>
  {% endif %}
  <header class="gem-blog__hero">
    <div class="gem-blog__search">
      <label class="visually-hidden" for="blog-search-{{ section_id }}">{{ 'blogs.gemstone.search_label' | t }}</label>
      <input
        id="blog-search-{{ section_id }}"
        type="search"
        data-blog-search
        placeholder="{{ 'blogs.gemstone.search_placeholder' | t }}"
      >
      <button type="button" data-blog-search-button>{{ 'blogs.gemstone.search_button' | t }}</button>
    </div>
  </header>
  <div class="gem-blog__layout">
    <aside class="gem-blog__topics" aria-label="Article topics">
      <h2>{{ 'blogs.gemstone.topics' | t }}</h2>
      <button type="button" class="is-active" data-topic-filter="">{{ 'blogs.gemstone.all_articles' | t }}</button>
      {% assign seen_topics = '||' %}
      {% for topic_article in blog_resource.articles %}
        {% assign topic_metafield = topic_article.metafields.custom.gemstone_topic %}
        {% assign topic_reference = topic_metafield.value %}
        {% assign topic_label = topic_reference.title | default: topic_reference | default: topic_metafield %}
        {% if topic_label != blank %}
          {% assign topic_label = topic_label | strip %}
          {% assign topic_marker = topic_label | prepend: '||' | append: '||' %}
          {% unless seen_topics contains topic_marker %}
            {% assign seen_topics = seen_topics | append: topic_label | append: '||' %}
            <button type="button" data-topic-filter="{{ topic_label | downcase | escape }}">
              {{ topic_label | escape -}}
              <span aria-hidden="true">›</span>
            </button>
          {% endunless %}
        {% endif %}
      {% endfor %}
    </aside>
    <section class="gem-blog__results" aria-label="Articles">
      <div ref="grid" class="blog-posts-container">
        {% for article in blog_resource.articles %}
          {% assign topic_metafield = article.metafields.custom.gemstone_topic %}
          {% assign topic_reference = topic_metafield.value %}
          {% assign article_topic = topic_reference.title | default: topic_reference | default: topic_metafield %}
          {% assign searchable_text = article.title | append: ' ' | append: article.author %}
          <article
            class="blog-post-item gem-blog__card"
            data-testid="blog-post-item"
            data-topic="{{ article_topic | downcase | escape }}"
            data-search="{{ searchable_text | downcase | escape }}"
          >
            {% if article.image %}
              <a class="gem-blog__image" href="{{ article.url }}">
                <img
                  src="{{ article.image | image_url: width: 900 }}"
                  srcset="{{ article.image | image_url: width: 450 }} 450w, {{ article.image | image_url: width: 900 }} 900w"
                  sizes="(min-width: 1100px) 26vw, (min-width: 700px) 40vw, 100vw"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}
                    fetchpriority="high"
                  {% endif %}
                  alt="{{ article.image.alt | escape }}"
                >
              </a>
            {% endif %}
            <div class="gem-blog__card-body">
              {% if article_topic != blank %}
                <p class="gem-blog__category">{{ article_topic | escape }}</p>
              {% endif %}
              <h2>
                <a href="{{ article.url }}">{{ article.title | escape }}</a>
              </h2>
              <p class="gem-blog__meta">
                <span class="gem-blog__meta-item">
                  <svg class="gem-blog__meta-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <rect x="3" y="4.5" width="14" height="12" rx="1.5"></rect>
                    <path d="M6.5 2.5v4M13.5 2.5v4M3 8.5h14"></path>
                  </svg>
                  {{ article.published_at | time_tag: format: 'date' }}
                </span>
                <span class="gem-blog__meta-separator" aria-hidden="true">|</span>
                <span class="gem-blog__meta-item">
                  <svg class="gem-blog__meta-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <circle cx="10" cy="6.5" r="3"></circle>
                    <path d="M4.5 17c.7-3 2.5-4.5 5.5-4.5s4.8 1.5 5.5 4.5"></path>
                  </svg>
                  {{ article.author | escape }}
                </span>
              </p>
              <a class="gem-blog__read-more" href="{{ article.url }}">
                {{- 'blogs.gemstone.read_more' | t }}
                <span aria-hidden="true">→</span></a
              >
            </div>
          </article>
        {% endfor %}
        <p class="gem-blog__empty" hidden>{{ 'blogs.gemstone.empty_search' | t }}</p>
      </div>
    </section>
  </div>
</div>

{% stylesheet %}
  .gem-blog__banner {
    position: relative;
    overflow: hidden;
    min-height: clamp(11rem, 24vw, 18rem);
    border-radius: 12px;
    background: var(--color-background);
    isolation: isolate;
  }
  .gem-blog__banner-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gem-blog__banner::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(255 253 249 / 0.34);
    content: '';
  }
  .gem-blog__banner-content {
    position: relative;
    z-index: 2;
    display: grid;
    min-height: inherit;
    place-content: center;
    padding: clamp(1.5rem, 5vw, 4rem);
    text-align: center;
    color: #17251f;
  }
  .gem-blog__banner-eyebrow {
    margin: 0 0 0.4rem;
    color: #9b773f;
    font-size: clamp(0.62rem, calc(0.55rem + 0.35vw), 0.82rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .gem-blog__banner h1 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.8rem, calc(1.25rem + 3.4vw), 4rem);
    line-height: 1.05;
    overflow-wrap: anywhere;
  }
  .gem-blog__banner-content > p:last-child {
    max-width: 38rem;
    margin: 0.75rem auto 0;
    font-size: clamp(0.88rem, calc(0.75rem + 0.65vw), 1.2rem);
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .gem-blog__hero {
    text-align: center;
    padding: 1.5rem;
  }
  .gem-blog__hero h1 {
    margin: 0.25rem 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4vw, 3.25rem);
  }
  .gem-blog__hero p {
    margin: 0.25rem 0;
  }
  .gem-blog__eyebrow,
  .gem-blog__category {
    color: var(--color-foreground-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .gem-blog__search {
    display: flex;
    gap: 0.5rem;
    max-width: 48rem;
    margin: 1.25rem auto 0;
    padding: 0.35rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    border-radius: 999px;
  }
  .gem-blog__search input {
    flex: 1;
    min-width: 0;
    border: 0;
    padding: 0.55rem 0.9rem;
    background: transparent;
  }
  .gem-blog__search button,
  .gem-blog__read-more {
    border: 0;
    border-radius: 999px;
    padding: 0.65rem 1rem;
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    text-decoration: none;
    cursor: pointer;
  }
  .gem-blog__layout {
    display: grid;
    grid-template-columns: minmax(12rem, 15rem) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }
  .gem-blog__topics {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    border-radius: 12px;
    padding: 1rem;
  }
  .gem-blog__topics h2 {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading--family);
  }
  .gem-blog__topics button {
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding: 0.65rem 0.2rem;
    border: 0;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    background: transparent;
    color: var(--color-foreground);
    text-align: start;
    cursor: pointer;
  }
  .gem-blog__topics button.is-active {
    color: var(--color-primary-button-background);
    font-weight: 700;
  }
  .gem-blog__card {
    overflow: hidden;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    border-radius: 14px;
    background: var(--color-background);
    box-shadow: 0 0.35rem 1.2rem rgb(var(--color-foreground-rgb) / 0.06);
  }
  .gem-blog__image {
    display: block;
    overflow: hidden;
    aspect-ratio: 1.8;
  }
  .gem-blog__image img {
    width: 100%;
    height: 100%;
    object-fit: fill;
  }
  .gem-blog__card-body {
    padding: 1rem;
  }
  .gem-blog__card h2 {
    margin: 0.3rem 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1rem, calc(0.9rem + 0.45vw), 1.2rem);
    line-height: 1.25;
    display: -webkit-box;
    min-height: calc(2 * 1.25em);
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .gem-blog__card h2 a {
    color: var(--color-foreground);
    text-decoration: none;
  }
  .gem-blog__category,
  .gem-blog__meta {
    margin: 0.35rem 0;
  }
  .gem-blog__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    color: var(--color-foreground-muted);
    font-size: 0.75rem;
  }
  .gem-blog__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-width: 0;
  }
  .gem-blog__meta-icon {
    width: 0.9rem;
    height: 0.9rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.35;
  }
  .gem-blog__meta-separator {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-40));
  }
  .gem-blog__read-more {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 0.4rem;
    padding: 0.45rem 0.8rem;
    font-size: 0.8rem;
  }
  .gem-blog__empty {
    grid-column: 1/-1;
  }
  @media (max-width: 700px) {
    .gem-blog__layout {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .gem-blog__topics {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }
    .gem-blog__topics h2 {
      flex-basis: 100%;
    }
    .gem-blog__topics button {
      width: auto;
      border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
      border-radius: 999px;
      padding: 0.4rem 0.7rem;
    }
    .gem-blog__topics button span {
      display: none;
    }
    .gem-blog__banner {
      border-radius: 8px;
    }
  }
{% endstylesheet %}
