<section
  id="career-job-list-{{ block.id }}"
  class="career-job-list"
  data-proxy-base="{{ block.settings.proxy_base | default: '/apps/careers' | escape }}"
>
  <div class="career-hero">
    <div class="career-shell">
      <p>Careers at {{ block.settings.brand_name | default: shop.name }}</p>
      <h1>{{ block.settings.heading | default: 'Build Your Future With Us' }}</h1>
      <span>{{ block.settings.subheading | default: 'Be part of a team that creates meaningful experiences and explores a better tomorrow.' }}</span>
      <div class="career-hero-tags">
        <strong>Travel & Explore</strong>
        <strong>Work & Grow</strong>
        <strong>Make an Impact</strong>
      </div>
    </div>
  </div>

  <div class="career-shell career-content">
    <div data-career-list-view>
      <div class="career-search-panel">
        <input data-career-search type="search" placeholder="Search jobs by title, department or keyword...">
        <select data-career-department><option value="">All Departments</option></select>
        <select data-career-location><option value="">All Locations</option></select>
        <select data-career-type><option value="">All Job Types</option></select>
        <button type="button" data-career-search-button>Search</button>
      </div>

      <div class="career-layout">
        <main>
          <h2><span data-career-count>0</span> Open Positions</h2>
          <div class="career-jobs" data-career-jobs>
            <article class="career-card career-job-card">
              <div class="career-round-icon">...</div>
              <div>
                <h3>Loading jobs...</h3>
                <p>Please wait while we load current openings.</p>
              </div>
            </article>
          </div>
        </main>

        <aside class="career-sidebar">
          <article class="career-card career-side-card">
            <div class="career-side-row">
              <span class="career-small-icon">AB</span>
              <div>
                <h3>About {{ block.settings.brand_name | default: shop.name }}</h3>
                <p>We are a fast-growing company creating unforgettable experiences. Join our team and be part of a journey that inspires millions.</p>
              </div>
            </div>
          </article>

          <article class="career-card career-side-card">
            <h3>Why Work With Us?</h3>
            <div class="career-benefit"><span>CS</span><div><strong>Competitive Salary</strong><p>We value your talent</p></div></div>
            <div class="career-benefit"><span>FW</span><div><strong>Flexible Work Options</strong><p>Work-life balance matters</p></div></div>
            <div class="career-benefit"><span>GR</span><div><strong>Growth Opportunities</strong><p>Learn, grow and explore</p></div></div>
            <div class="career-benefit"><span>AT</span><div><strong>Amazing Team</strong><p>Collaborative and supportive culture</p></div></div>
          </article>
        </aside>
      </div>
    </div>

    <div class="career-detail-view" data-career-detail-view hidden>
      <button type="button" class="career-back-button" data-career-back>&lt; Back to Jobs</button>

      <div class="career-layout">
        <main class="career-detail-main">
          <div class="career-notice" data-career-notice hidden></div>

          <article class="career-card career-job-summary">
            <span class="career-round-icon" data-detail-initials>JOB</span>
            <div>
              <h2 data-detail-title>Loading job...</h2>
              <div class="career-job-tags">
                <span data-detail-department></span>
                <span data-detail-type></span>
                <span data-detail-location></span>
                <span data-detail-shift></span>
              </div>
            </div>
          </article>

          <article class="career-card career-section">
            <div class="career-section-heading">
              <span class="career-small-icon">INFO</span>
              <div>
                <h2>Job Details</h2>
                <p>Review this role before submitting your application.</p>
              </div>
            </div>

            <div class="career-detail-grid">
              <div><strong>Openings</strong><span data-detail-openings></span></div>
              <div><strong>Experience</strong><span data-detail-experience></span></div>
              <div><strong>Qualification</strong><span data-detail-qualification></span></div>
              <div><strong>Salary</strong><span data-detail-salary></span></div>
            </div>

            <div class="career-rich-text" data-detail-block="jobDescription"><h3>Job Description</h3><p data-detail-description></p></div>
            <div class="career-rich-text" data-detail-block="jobResponsibilities"><h3>Responsibilities</h3><p data-detail-responsibilities></p></div>
            <div class="career-rich-text" data-detail-block="primaryRequirements"><h3>Requirements</h3><p data-detail-requirements></p></div>
            <div class="career-rich-text" data-detail-block="preferredRequirements"><h3>Preferred Requirements</h3><p data-detail-preferred></p></div>
            <div class="career-rich-text" data-detail-block="benefits"><h3>Benefits</h3><p data-detail-benefits></p></div>
          </article>

          <form class="career-form" data-career-form enctype="multipart/form-data">
            <article class="career-card career-section">
              <div class="career-section-heading">
                <span class="career-small-icon">PI</span>
                <div>
                  <h2>Personal Information</h2>
                  <p>Tell us about yourself</p>
                </div>
              </div>

              <div class="career-form-grid">
                <label><span>Full Name <b>*</b></span><input name="fullName" type="text" placeholder="Enter your full name" required></label>
                <label><span>Email Address <b>*</b></span><input name="email" type="email" placeholder="Enter your email address" required></label>
                <label><span>Phone Number <b>*</b></span><input name="phone" type="tel" placeholder="+91 98765 43210" required></label>
                <label><span>Date of Birth</span><input name="dateOfBirth" type="date"></label>
                <label><span>Current City / Location</span><input name="currentCity" type="text" placeholder="Enter your current city"></label>
                <label><span>LinkedIn Profile</span><input name="linkedin" type="url" placeholder="https://linkedin.com/in/yourprofile"></label>
              </div>
            </article>

            <article class="career-card career-section">
              <div class="career-section-heading">
                <span class="career-small-icon">PRO</span>
                <div>
                  <h2>Professional Information</h2>
                  <p>Share your professional details</p>
                </div>
              </div>

              <div class="career-form-grid">
                <label>
                  <span>Work Experience <b>*</b></span>
                  <select name="experience" required>
                    <option value="">Select experience</option>
                    <option>Fresher</option>
                    <option>1 Year</option>
                    <option>2 Years</option>
                    <option>3 Years</option>
                    <option>4+ Years</option>
                  </select>
                </label>
                <label>
                  <span>Highest Qualification <b>*</b></span>
                  <select name="qualification" required>
                    <option value="">Select qualification</option>
                    <option>Diploma</option>
                    <option>Bachelor's</option>
                    <option>Master's</option>
                    <option>Other</option>
                  </select>
                </label>
                <label><span>Current Job Title</span><input name="currentJobTitle" type="text" placeholder="Enter your current job title"></label>
                <label><span>Current / Previous Company</span><input name="currentCompany" type="text" placeholder="Enter your current or previous company"></label>
                <label><span>Available Start Date <b>*</b></span><input name="availableStart" type="date" required></label>
                <label>
                  <span>Notice Period</span>
                  <select name="noticePeriod">
                    <option value="">Select notice period</option>
                    <option>Immediate</option>
                    <option>15 Days</option>
                    <option>30 Days</option>
                    <option>60 Days</option>
                    <option>90 Days</option>
                  </select>
                </label>
                <label>
                  <span>Expected Salary <b>*</b></span>
                  <span class="career-salary"><em>Rs</em><input name="expectedSalary" type="number" min="0" placeholder="Enter expected salary" required></span>
                </label>
                <label>
                  <span>Salary Period</span>
                  <select name="salaryType">
                    <option>Per Month</option>
                    <option>Per Year</option>
                    <option>Per Hour</option>
                  </select>
                </label>
                <label class="career-full"><span>Skills <b>*</b></span><input name="skills" type="text" placeholder="e.g. React, Node.js, JavaScript, UI/UX" required><small>Enter skills separated by commas</small></label>
              </div>
            </article>

            <article class="career-card career-section">
              <div class="career-section-heading">
                <span class="career-small-icon">APP</span>
                <div>
                  <h2>Your Application</h2>
                  <p>Tell us why you're a great fit</p>
                </div>
              </div>

              <label class="career-full">
                <span>Cover Letter / Additional Information</span>
                <textarea name="coverLetter" maxlength="1000" rows="4" placeholder="Tell us why you're interested in this position and what makes you a great candidate..." data-career-cover></textarea>
                <small class="career-count"><span data-career-cover-count>0</span>/1000 characters</small>
              </label>
            </article>

            <article class="career-card career-section">
              <div class="career-section-heading">
                <span class="career-small-icon">PDF</span>
                <div>
                  <h2>Resume <b>*</b></h2>
                  <p>Upload your resume (PDF only)</p>
                </div>
              </div>

              <div class="career-upload">
                <input name="resume" type="file" accept="application/pdf" data-career-resume hidden>
                <button type="button" data-career-resume-button>Upload PDF</button>
                <strong>Drag and drop your resume here</strong>
                <span>or click to browse</span>
                <small>PDF only - Maximum file size: 5 MB</small>
                <div class="career-file" data-career-file hidden>
                  <span><strong data-career-file-name></strong><small data-career-file-size></small></span>
                  <button type="button" data-career-file-remove>Remove</button>
                </div>
              </div>

              <label class="career-consent">
                <input name="consent" value="yes" type="checkbox" required>
                <span>I confirm that the information provided above is correct and complete.</span>
              </label>

              <div class="career-submit">
                <button type="submit" data-career-submit>Submit Application</button>
                <small>By submitting this application, you agree to our Privacy Policy and Terms of Service.</small>
              </div>
            </article>
          </form>
        </main>

        <aside class="career-sidebar">
          <article class="career-card career-side-card">
            <div class="career-side-row">
              <span class="career-small-icon">?</span>
              <div>
                <h3>Need Help?</h3>
                <p>If you have any questions about the application process, feel free to reach out to us.</p>
              </div>
            </div>
          </article>

          <article class="career-card career-side-card career-safe">
            <div class="career-side-row">
              <span class="career-small-icon">OK</span>
              <div>
                <h3>Your Data is Safe</h3>
                <p>Your personal information will only be used for recruitment purposes.</p>
              </div>
            </div>
          </article>
        </aside>
      </div>
    </div>
  </div>
</section>

<style>
  #career-job-list-{{ block.id }} { background: #f6f9fd; color: #071436; font-family: Inter, Arial, sans-serif; }
  #career-job-list-{{ block.id }} * { box-sizing: border-box; }
  #career-job-list-{{ block.id }} .career-hero { background: linear-gradient(90deg, rgba(238,247,255,.96), rgba(238,247,255,.7), rgba(238,247,255,.24)), url("https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1800&q=80") center/cover; min-height: 270px; padding: 52px 20px 78px; }
  #career-job-list-{{ block.id }} .career-shell { margin: 0 auto; max-width: 1180px; }
  #career-job-list-{{ block.id }} .career-hero p { color: #33415f; font-size: 14px; font-weight: 800; letter-spacing: 4px; margin: 0 0 14px; text-transform: uppercase; }
  #career-job-list-{{ block.id }} .career-hero h1 { color: #071436; font-size: 44px; font-weight: 850; line-height: 52px; margin: 0; max-width: 680px; }
  #career-job-list-{{ block.id }} .career-hero span { color: #4b587c; display: block; font-size: 17px; line-height: 26px; margin-top: 12px; max-width: 560px; }
  #career-job-list-{{ block.id }} .career-hero-tags { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 22px; }
  #career-job-list-{{ block.id }} .career-content { padding: 0 20px 32px; }
  #career-job-list-{{ block.id }} .career-search-panel { align-items: center; background: #fff; border: 1px solid #dfe7f2; border-radius: 10px; box-shadow: 0 18px 44px rgba(15,23,42,.08); display: grid; gap: 14px; grid-template-columns: minmax(260px, 1fr) 170px 170px 170px 110px; margin-top: -40px; padding: 18px; }
  #career-job-list-{{ block.id }} input, #career-job-list-{{ block.id }} select, #career-job-list-{{ block.id }} textarea { background: #fff; border: 1px solid #cfd8e6; border-radius: 7px; color: #071436; font: inherit; font-size: 14px; outline: none; width: 100%; }
  #career-job-list-{{ block.id }} input, #career-job-list-{{ block.id }} select { height: 42px; padding: 0 14px; }
  #career-job-list-{{ block.id }} textarea { min-height: 76px; padding: 11px; resize: vertical; }
  #career-job-list-{{ block.id }} button, #career-job-list-{{ block.id }} .career-view-btn { align-items: center; background: #145de0; border: 0; border-radius: 7px; color: #fff; cursor: pointer; display: inline-flex; font: inherit; font-size: 14px; font-weight: 800; height: 42px; justify-content: center; padding: 0 18px; text-decoration: none; }
  #career-job-list-{{ block.id }} .career-layout { align-items: start; display: grid; gap: 26px; grid-template-columns: minmax(0,1fr) 320px; margin-top: 22px; }
  #career-job-list-{{ block.id }} main h2 { font-size: 17px; margin: 0 0 12px; }
  #career-job-list-{{ block.id }} .career-jobs, #career-job-list-{{ block.id }} .career-sidebar, #career-job-list-{{ block.id }} .career-detail-main, #career-job-list-{{ block.id }} .career-form { display: grid; gap: 12px; }
  #career-job-list-{{ block.id }} .career-card { background: #fff; border: 1px solid #dfe7f2; border-radius: 10px; box-shadow: 0 14px 38px rgba(15,23,42,.04); }
  #career-job-list-{{ block.id }} .career-job-card { align-items: center; display: grid; gap: 18px; grid-template-columns: 70px minmax(0,1fr) auto; padding: 18px; }
  #career-job-list-{{ block.id }} .career-round-icon, #career-job-list-{{ block.id }} .career-small-icon, #career-job-list-{{ block.id }} .career-benefit span { align-items: center; background: #eaf4ff; border-radius: 50%; color: #145de0; display: inline-flex; flex-shrink: 0; font-weight: 850; justify-content: center; }
  #career-job-list-{{ block.id }} .career-round-icon { font-size: 16px; height: 64px; width: 64px; }
  #career-job-list-{{ block.id }} .career-small-icon { border-radius: 8px; height: 38px; width: 38px; }
  #career-job-list-{{ block.id }} h2, #career-job-list-{{ block.id }} h3 { color: #071436; font-weight: 850; margin: 0; }
  #career-job-list-{{ block.id }} .career-job-card h3 { font-size: 18px; }
  #career-job-list-{{ block.id }} p { color: #4b587c; font-size: 14px; line-height: 21px; margin: 6px 0 0; }
  #career-job-list-{{ block.id }} .career-job-meta, #career-job-list-{{ block.id }} .career-job-tags { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  #career-job-list-{{ block.id }} .career-job-meta span, #career-job-list-{{ block.id }} .career-job-tags span { background: #f8fbff; border: 1px solid #d6dfec; border-radius: 6px; color: #293654; font-size: 13px; font-weight: 700; padding: 4px 10px; }
  #career-job-list-{{ block.id }} .career-openings { background: #d9f8e8; border-radius: 999px; color: #047047; display: inline-flex; font-size: 13px; font-weight: 800; margin-bottom: 20px; padding: 7px 14px; }
  #career-job-list-{{ block.id }} .career-side-card, #career-job-list-{{ block.id }} .career-section, #career-job-list-{{ block.id }} .career-job-summary { padding: 18px 22px; }
  #career-job-list-{{ block.id }} .career-side-row, #career-job-list-{{ block.id }} .career-section-heading, #career-job-list-{{ block.id }} .career-job-summary { align-items: flex-start; display: flex; gap: 14px; }
  #career-job-list-{{ block.id }} .career-benefit { display: flex; gap: 12px; margin-top: 18px; }
  #career-job-list-{{ block.id }} .career-benefit span { height: 38px; width: 38px; }
  #career-job-list-{{ block.id }} .career-safe { background: #eefcf6; border-color: #c8f2df; }
  #career-job-list-{{ block.id }} .career-back-button { background: transparent; color: #145de0; height: auto; justify-content: flex-start; padding: 0; }
  #career-job-list-{{ block.id }} .career-detail-grid { display: grid; gap: 12px; grid-template-columns: repeat(4, minmax(0,1fr)); margin: 16px 0; }
  #career-job-list-{{ block.id }} .career-detail-grid div { background: #f8fbff; border: 1px solid #dfe7f2; border-radius: 7px; padding: 12px; }
  #career-job-list-{{ block.id }} .career-detail-grid strong, #career-job-list-{{ block.id }} .career-detail-grid span { display: block; }
  #career-job-list-{{ block.id }} .career-detail-grid strong { color: #4b587c; font-size: 12px; margin-bottom: 5px; }
  #career-job-list-{{ block.id }} .career-detail-grid span { color: #071436; font-size: 14px; font-weight: 800; }
  #career-job-list-{{ block.id }} .career-rich-text { border-top: 1px solid #e7eef7; padding-top: 14px; }
  #career-job-list-{{ block.id }} .career-rich-text + .career-rich-text { margin-top: 14px; }
  #career-job-list-{{ block.id }} .career-form-grid { display: grid; gap: 14px 26px; grid-template-columns: repeat(2, minmax(0,1fr)); }
  #career-job-list-{{ block.id }} label { color: #071436; display: grid; font-size: 13px; font-weight: 800; gap: 7px; }
  #career-job-list-{{ block.id }} b { color: #e11d2f; }
  #career-job-list-{{ block.id }} .career-full { grid-column: 1 / -1; }
  #career-job-list-{{ block.id }} small { color: #4b587c; font-size: 12px; font-weight: 500; }
  #career-job-list-{{ block.id }} .career-count { text-align: right; }
  #career-job-list-{{ block.id }} .career-salary { display: flex; }
  #career-job-list-{{ block.id }} .career-salary em { align-items: center; background: #f8fbff; border: 1px solid #cfd8e6; border-radius: 7px 0 0 7px; border-right: 0; display: inline-flex; font-style: normal; font-weight: 800; justify-content: center; width: 42px; }
  #career-job-list-{{ block.id }} .career-salary input { border-radius: 0 7px 7px 0; }
  #career-job-list-{{ block.id }} .career-upload { background: #fbfdff; border: 1px dashed #9fb0c8; border-radius: 7px; display: grid; min-height: 142px; padding: 18px; place-items: center; text-align: center; }
  #career-job-list-{{ block.id }} .career-upload > button { background: transparent; color: #145de0; }
  #career-job-list-{{ block.id }} .career-file { align-items: center; background: #fff; border: 1px solid #dfe7f2; border-radius: 7px; display: flex; justify-content: space-between; margin-top: 16px; padding: 10px 12px; text-align: left; width: 100%; }
  #career-job-list-{{ block.id }} .career-file button { background: #fff; border: 1px solid #d6dfec; color: #071436; }
  #career-job-list-{{ block.id }} .career-consent { align-items: flex-start; display: flex; font-weight: 500; gap: 9px; margin-top: 14px; }
  #career-job-list-{{ block.id }} .career-consent input { height: 16px; margin-top: 2px; width: 16px; }
  #career-job-list-{{ block.id }} .career-submit { display: grid; gap: 8px; justify-items: center; margin-top: 12px; }
  #career-job-list-{{ block.id }} .career-submit button { width: min(290px,100%); }
  #career-job-list-{{ block.id }} .career-notice { border-radius: 7px; font-size: 14px; font-weight: 700; padding: 12px 14px; }
  #career-job-list-{{ block.id }} .career-notice.success { background: #ecfdf5; border: 1px solid #b5ead2; color: #08784f; }
  #career-job-list-{{ block.id }} .career-notice.error { background: #fff1f2; border: 1px solid #fecdd3; color: #be123c; }
  @media (max-width: 980px) { #career-job-list-{{ block.id }} .career-search-panel, #career-job-list-{{ block.id }} .career-layout { grid-template-columns: 1fr; } }
  @media (max-width: 720px) { #career-job-list-{{ block.id }} .career-hero h1 { font-size: 34px; line-height: 40px; } #career-job-list-{{ block.id }} .career-job-card, #career-job-list-{{ block.id }} .career-form-grid, #career-job-list-{{ block.id }} .career-detail-grid { grid-template-columns: 1fr; } #career-job-list-{{ block.id }} .career-full { grid-column: auto; } }
</style>

<script>
  (() => {
    const root = document.getElementById("career-job-list-{{ block.id }}");
    if (!root) return;

    const proxyBase = root.dataset.proxyBase || "/apps/careers";
    const listView = root.querySelector("[data-career-list-view]");
    const detailView = root.querySelector("[data-career-detail-view]");
    const jobsWrap = root.querySelector("[data-career-jobs]");
    const count = root.querySelector("[data-career-count]");
    const searchInput = root.querySelector("[data-career-search]");
    const departmentSelect = root.querySelector("[data-career-department]");
    const locationSelect = root.querySelector("[data-career-location]");
    const typeSelect = root.querySelector("[data-career-type]");
    const searchButton = root.querySelector("[data-career-search-button]");
    const form = root.querySelector("[data-career-form]");
    const notice = root.querySelector("[data-career-notice]");
    const submitButton = root.querySelector("[data-career-submit]");
    const resumeInput = root.querySelector("[data-career-resume]");
    const resumeButton = root.querySelector("[data-career-resume-button]");
    const resumeFile = root.querySelector("[data-career-file]");
    const resumeFileName = root.querySelector("[data-career-file-name]");
    const resumeFileSize = root.querySelector("[data-career-file-size]");
    const resumeRemove = root.querySelector("[data-career-file-remove]");
    const cover = root.querySelector("[data-career-cover]");
    const coverCount = root.querySelector("[data-career-cover-count]");
    let jobs = [];
    let activeJobId = "";

    const escapeHtml = (value) => {
      const element = document.createElement("div");
      element.textContent = value || "";
      return element.innerHTML;
    };
    const getInitials = (value) => String(value || "Job").split(" ").filter(Boolean).slice(0, 2).map((part) => part[0]).join("").toUpperCase();
    const uniqueValues = (field) => [...new Set(jobs.map((job) => job[field]).filter(Boolean))].sort();
    const showNotice = (message, type) => {
      notice.textContent = message;
      notice.className = `career-notice ${type}`;
      notice.hidden = false;
    };
    const setText = (selector, value) => {
      const element = root.querySelector(selector);
      if (element) element.textContent = value || "Not provided";
    };
    const setDetailBlock = (name, value) => {
      const element = root.querySelector(`[data-detail-block="${name}"]`);
      if (element) element.hidden = !value;
    };
    const formatFileSize = (size) => `${Math.ceil(size / 1024)} KB`;
    const formatSalary = (job) => {
      if (job.salaryDescription) return job.salaryDescription;
      if (job.minimumSalary || job.maximumSalary) return `${job.currency || "INR"} ${job.minimumSalary || "-"} - ${job.maximumSalary || "-"} ${job.paymentType || ""}`.trim();
      return "Not provided";
    };

    const setOptions = (select, values) => {
      const first = select.options[0];
      select.innerHTML = "";
      select.appendChild(first);
      values.forEach((value) => {
        const option = document.createElement("option");
        option.value = value;
        option.textContent = value;
        select.appendChild(option);
      });
    };

    const renderJobs = () => {
      const search = searchInput.value.trim().toLowerCase();
      const department = departmentSelect.value;
      const location = locationSelect.value;
      const type = typeSelect.value;
      const filteredJobs = jobs.filter((job) => {
        const text = `${job.jobTitle} ${job.department} ${job.location} ${job.employmentType} ${job.jobDescription}`.toLowerCase();
        return (!search || text.includes(search)) && (!department || job.department === department) && (!location || job.location === location) && (!type || job.employmentType === type);
      });

      count.textContent = filteredJobs.length;
      if (filteredJobs.length === 0) {
        jobsWrap.innerHTML = `<article class="career-card career-job-card"><div class="career-round-icon">0</div><div><h3>No open positions found</h3><p>Try changing your search or filters.</p></div></article>`;
        return;
      }

      jobsWrap.innerHTML = filteredJobs.map((job) => `
        <article class="career-card career-job-card">
          <div class="career-round-icon">${escapeHtml(getInitials(job.jobTitle))}</div>
          <div>
            <h3>${escapeHtml(job.jobTitle)}</h3>
            <p>${escapeHtml(job.department)}</p>
            <div class="career-job-meta">
              <span>${escapeHtml(job.employmentType)}</span>
              <span>${escapeHtml(job.location)}</span>
              <span>${escapeHtml(job.shiftSchedule)}</span>
            </div>
            <p>${escapeHtml(job.jobDescription || job.salaryDescription || "View details and apply for this position.")}</p>
          </div>
          <div>
            <span class="career-openings">${Number(job.numberOfOpenings || 1)} ${Number(job.numberOfOpenings || 1) === 1 ? "Opening" : "Openings"}</span>
            <button type="button" class="career-view-btn" data-career-view-job="${escapeHtml(job.id)}">View Details -&gt;</button>
          </div>
        </article>
      `).join("");
    };

    const showJobDetail = async (jobId) => {
      notice.hidden = true;
      activeJobId = jobId;
      const response = await fetch(`${proxyBase}/job/${jobId}`);
      const payload = await response.json();
      if (!response.ok || !payload.job) throw new Error(payload.error || "Job not found.");
      const job = payload.job;
      setText("[data-detail-initials]", getInitials(job.jobTitle));
      setText("[data-detail-title]", job.jobTitle);
      setText("[data-detail-department]", job.department);
      setText("[data-detail-type]", job.employmentType);
      setText("[data-detail-location]", job.location);
      setText("[data-detail-shift]", job.shiftSchedule);
      setText("[data-detail-openings]", `${Number(job.numberOfOpenings || 1)} ${Number(job.numberOfOpenings || 1) === 1 ? "Opening" : "Openings"}`);
      setText("[data-detail-experience]", job.workExperience);
      setText("[data-detail-qualification]", job.qualification);
      setText("[data-detail-salary]", formatSalary(job));
      setText("[data-detail-description]", job.jobDescription);
      setText("[data-detail-responsibilities]", job.jobResponsibilities);
      setText("[data-detail-requirements]", job.primaryRequirements);
      setText("[data-detail-preferred]", job.preferredRequirements);
      setText("[data-detail-benefits]", job.benefits);
      setDetailBlock("jobDescription", job.jobDescription);
      setDetailBlock("jobResponsibilities", job.jobResponsibilities);
      setDetailBlock("primaryRequirements", job.primaryRequirements);
      setDetailBlock("preferredRequirements", job.preferredRequirements);
      setDetailBlock("benefits", job.benefits);
      listView.hidden = true;
      detailView.hidden = false;
      root.scrollIntoView({ behavior: "smooth", block: "start" });
    };

    fetch(`${proxyBase}/jobs`).then((response) => response.json()).then((payload) => {
      jobs = payload.jobs || [];
      setOptions(departmentSelect, uniqueValues("department"));
      setOptions(locationSelect, uniqueValues("location"));
      setOptions(typeSelect, uniqueValues("employmentType"));
      renderJobs();
    }).catch(() => {
      count.textContent = "0";
      jobsWrap.innerHTML = `<article class="career-card career-job-card"><div class="career-round-icon">!</div><div><h3>Unable to load jobs</h3><p>Please try again later.</p></div></article>`;
    });

    jobsWrap.addEventListener("click", (event) => {
      const button = event.target.closest("[data-career-view-job]");
      if (!button) return;
      showJobDetail(button.dataset.careerViewJob).catch((error) => alert(error.message || "Unable to load job details."));
    });

    root.querySelector("[data-career-back]").addEventListener("click", () => {
      detailView.hidden = true;
      listView.hidden = false;
      notice.hidden = true;
      form.reset();
      resumeFile.hidden = true;
      coverCount.textContent = "0";
    });

    searchInput.addEventListener("input", renderJobs);
    departmentSelect.addEventListener("change", renderJobs);
    locationSelect.addEventListener("change", renderJobs);
    typeSelect.addEventListener("change", renderJobs);
    searchButton.addEventListener("click", renderJobs);
    resumeButton.addEventListener("click", () => resumeInput.click());
    resumeInput.addEventListener("change", () => {
      const file = resumeInput.files[0];
      if (!file) { resumeFile.hidden = true; return; }
      if (file.type !== "application/pdf") { showNotice("Resume must be a PDF file.", "error"); resumeInput.value = ""; resumeFile.hidden = true; return; }
      if (file.size > 5 * 1024 * 1024) { showNotice("Resume exceeds the 5 MB file size limit.", "error"); resumeInput.value = ""; resumeFile.hidden = true; return; }
      resumeFileName.textContent = file.name;
      resumeFileSize.textContent = formatFileSize(file.size);
      resumeFile.hidden = false;
    });
    resumeRemove.addEventListener("click", () => { resumeInput.value = ""; resumeFile.hidden = true; });
    cover.addEventListener("input", () => { coverCount.textContent = cover.value.length; });
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      notice.hidden = true;
      submitButton.disabled = true;
      submitButton.textContent = "Submitting...";
      try {
        const response = await fetch(`${proxyBase}/apply/${activeJobId}`, { method: "POST", body: new FormData(form) });
        const payload = await response.json();
        if (!response.ok || !payload.success) throw new Error(payload.error || "Application could not be submitted.");
        form.reset();
        resumeFile.hidden = true;
        coverCount.textContent = "0";
        showNotice("Application submitted successfully.", "success");
      } catch (error) {
        showNotice(error.message || "Application could not be submitted.", "error");
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Submit Application";
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Career Job List",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Shabdd"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Future With Us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Be part of a team that creates meaningful experiences and explores a better tomorrow."
    },
    {
      "type": "text",
      "id": "proxy_base",
      "label": "App proxy base path",
      "default": "/apps/careers"
    }
  ]
}
{% endschema %}
