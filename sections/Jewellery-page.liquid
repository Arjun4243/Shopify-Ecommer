      min-height: 40px;
      border: 1px solid #e5e0d8;
      border-radius: 8px;
      background: #ffffff;
      color: #14243b;
      padding-inline: 16px;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 4px 12px rgb(17 24 39 / 8%);
    }

    .jewellery-filters {
      position: fixed;
      z-index: 60;
      inset-block: 0;
      inset-inline-start: 0;
      block-size: 100dvh;
      max-block-size: 100dvh;
