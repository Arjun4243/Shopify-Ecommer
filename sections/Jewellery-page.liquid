    display: flex;
    flex-wrap: nowrap;
    gap: 12px;
    overflow-x: auto;
    overflow-y: hidden;
    box-sizing: border-box;
    inline-size: 100%;
    max-inline-size: 100%;
    padding-bottom: 6px;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-inline: contain;
  }

  .shop-by-collection__card {
    flex: 0 0 var(--collection-card-width);
    min-width: 0;
    max-width: var(--collection-card-width);
    overflow: hidden;
    border-radius: 8px;
    background: #f7f1e8;
    color: #111827;
    text-decoration: none;
    box-shadow: 0 1px 2px rgb(17 24 39 / 8%);
    scroll-snap-align: start;
