  .shop-by-collection__image-wrap {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f0e7db;
  }

  .shop-by-collection__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shop-by-collection__title {
    display: block;
    overflow: hidden;
    padding: 10px 12px;
    font-size: 13px;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .jewellery-products__toolbar p {
    margin: 0;
    font-size: 14px;
  }

  .jewellery-products__controls {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
  }

  .jewellery-products__controls select {
    min-height: 38px;
    border: 1px solid #e5e0d8;
    border-radius: 8px;
    background: #ffffff;
    padding-inline: 12px;
  }

  .jewellery-products__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, 174px);
    gap: 28px 26px;
    justify-content: start;
    width: 100%;
  }

  .jewellery-product-card {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 6px;
    width: 100%;
    min-width: 0;
    border-radius: 0;
    background: transparent;
  }

  .jewellery-product-card.is-hidden {
    display: none;
  }

  .jewellery-product-card__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    background: #f4f4f4;
  }

  .jewellery-product-card__image-link {
    display: block;
    height: 100%;
  }

