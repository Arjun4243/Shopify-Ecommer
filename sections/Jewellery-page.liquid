  }

  @media screen and (max-width: 1100px) {
    .jewellery-page__body {
      grid-template-columns: 1fr;
    }

    .jewellery-filters {
      position: static;
      max-block-size: none;
      overflow-y: visible;
    }

    .jewellery-products__grid {
      grid-template-columns: repeat(auto-fill, 174px);
    }
  }

  @media screen and (max-width: 989px) {
    .shop-by-collection__grid {
      --collection-card-width: clamp(108px, 24vw, 132px);
