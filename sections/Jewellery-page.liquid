  .jewellery-product-card__details span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .jewellery-product-card__price {
    margin: 1px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
    overflow: hidden;
    color: #111827;
    white-space: nowrap;
  }

  .jewellery-product-card__price-current {
    min-width: 0;
    overflow: hidden;
    font-size: 15px;
    font-weight: 900;
    line-height: 1.2;
    text-overflow: ellipsis;
  }

  .jewellery-product-card__price-compare {
    min-width: 0;
    overflow: hidden;
    color: #9ca3af;
