      max-width: 100%;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-bottom: max(18px, env(safe-area-inset-bottom));
      border-radius: 0;
      transform: translateX(-100%);
      transition: transform 220ms ease;
      -webkit-overflow-scrolling: touch;
    }

    [dir='rtl'] .jewellery-filters {
      transform: translateX(100%);
