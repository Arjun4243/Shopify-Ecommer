    --padding-block-end: 0px;
    --border-radius: 8px;
  }

  .jewellery-product-card .quick-add__button {
    inset-block-end: 8px;
    inset-inline-end: 8px;
    border-color: #b8c8cc;
    background: #ffffff;
    color: #111827;
    box-shadow: 0 8px 18px rgb(17 24 39 / 14%);
  }

  .jewellery-product-card:is(:hover, :focus-within) .quick-add__button {
    opacity: 1;
  }

  .jewellery-product-card__content {
    display: grid;
    gap: 5px;
    min-width: 0;
    overflow: hidden;
  }

  .jewellery-product-card__content h3 {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    color: #111827;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .jewellery-product-card__content a {
    display: -webkit-box;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .jewellery-product-card__details {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    min-width: 0;
    overflow: hidden;
    color: #6b7280;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.35;
