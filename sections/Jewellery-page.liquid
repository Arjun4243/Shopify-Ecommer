  }

  .jewellery-product-card__heart {
    position: absolute;
    top: 8px;
    right: 8px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: #ffffff;
    color: #111827;
    cursor: pointer;
    box-shadow: 0 8px 18px rgb(17 24 39 / 14%);
    transition:
