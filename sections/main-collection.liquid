

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% render 'collection-wrapper-styles' %}

{% if section.settings.enable_gemstone_filters %}
  {% assign collection_subtitle = collection.description | strip_html %}
  {% render 'stone-product-listing',
    source_collection: collection,
    heading: collection.title,
    subtitle: collection_subtitle,
    section_id: section.id,
    show_type_filter: false
  %}
{% else %}
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  {% # theme-check-disable-next-line UnknownFilter %}
  <collection-component view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
    <results-list
      class="section product-grid-container{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
      style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
      section-id="{{ section.id }}"
      infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
    >
      {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

      <div
        class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
      >
        {% content_for 'block',
          type: 'filters',
          id: 'filters',
          results: collection,
          results_size: collection.products_count
        %}

        {% assign products_per_page = 24 %}

        {% if section.settings.enable_infinite_scroll == false %}
          {% assign products_per_page = section.settings.products_per_page %}
        {% endif %}

        {% paginate collection.products by products_per_page %}
          {% capture children %}
            {% for product in collection.products %}
              <li
                id="{{ section.id }}-{{ product.id }}"
                class="product-grid__item product-grid__item--{{ forloop.index0 }}"
                data-page="{{ paginate.current_page }}"
                data-product-id="{{ product.id }}"
                ref="cards[]"
              >
                {% content_for 'block',
                  type: '_product-card',
                  id: 'product-card',
                  closest.product: product,
                  product_view_context: 'collection'
                %}
              </li>
            {% endfor %}
          {% endcapture %}

          {% render 'product-grid',
            section: section,
            children: children,
            products: collection.products,
            paginate: paginate,
            enable_infinite_scroll: section.settings.enable_infinite_scroll
          %}
        {% endpaginate %}
      </div>
    </results-list>
  </collection-component>
{% endif %}

{% stylesheet %}
  .content-for-layout[data-template^='collection'] .collection-wrapper {
    background:
      linear-gradient(180deg, #fffdf8 0%, rgb(var(--color-background-rgb)) 38%),
      var(--color-background);
  }

  .content-for-layout[data-template^='collection'] .facets-block-wrapper--horizontal {
    border-block-end: 1px solid rgb(169 121 43 / 14%);
    background: rgb(255 253 248 / 88%);
    box-shadow: 0 12px 32px rgb(87 60 24 / 6%);
  }

  .content-for-layout[data-template^='collection'] .facets--horizontal {
    --facets-form-horizontal-gap: clamp(12px, 1.6vw, 28px);
  }

  .content-for-layout[data-template^='collection'] .facets--horizontal .facets__summary,
  .content-for-layout[data-template^='collection'] .sorting-filter__select,
  .content-for-layout[data-template^='collection'] .products-count-wrapper {
    color: var(--color-foreground);
    font-weight: 600;
  }

  .content-for-layout[data-template^='collection'] .facets-toggle__button {
    border-radius: 8px;
    background: #f7ecd8;
    color: #5d3d12;
  }

  .content-for-layout[data-template^='collection'] .column-picker {
    border-radius: 8px;
  }

  .content-for-layout[data-template^='collection'] .column-options__option-input:checked ~ .column-picker {
    background: #f7ecd8;
    color: #7a551d;
  }

  .content-for-layout[data-template^='collection'] .main-collection-grid {
    padding-block-start: clamp(22px, 3vw, 40px);
  }

  .content-for-layout[data-template^='collection'] .product-grid {
    align-items: stretch;
  }

  .content-for-layout[data-template^='collection'] .product-grid__item {
    overflow: hidden;
    border: 1px solid rgb(169 121 43 / 14%);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 12px 32px rgb(87 60 24 / 7%);
    transition: transform var(--animation-speed) var(--animation-easing),
      box-shadow var(--animation-speed) var(--animation-easing);
  }

  .content-for-layout[data-template^='collection'] .product-grid__item:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 42px rgb(87 60 24 / 11%);
  }

  .content-for-layout[data-template^='collection'] .product-grid__card.product-grid__card {
    height: 100%;
    padding: 8px 8px 16px;
    gap: 12px;
  }

  .content-for-layout[data-template^='collection'] .product-card .card-gallery {
    border-radius: 8px;
    background: #f7f0e4;
  }

  .content-for-layout[data-template^='collection'] .product-card .card-gallery .product-media-container {
    aspect-ratio: 16 / 9;
  }

  .content-for-layout[data-template^='collection'] .product-card .card-gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .content-for-layout[data-template^='collection'] .product-card :is(h3, h4, .h4) {
    padding-inline: 8px;
    color: var(--color-foreground);
    font-family: var(--font-heading--family);
    font-size: clamp(1.15rem, 1.4vw, 1.45rem);
    line-height: 1.2;
  }

  .content-for-layout[data-template^='collection'] .product-card .price {
    margin-block-start: auto;
    padding-inline: 8px;
    color: var(--color-foreground);
    font-size: clamp(1rem, 1.1vw, 1.2rem);
    font-weight: 800;
  }

  .content-for-layout[data-template^='collection'] .product-card .quick-add {
    --quick-add-offset: 10px;
  }

  .content-for-layout[data-template^='collection'] .product-card button.quick-add__button {
    border: 0;
    background: #a9792b;
    color: #ffffff;
    box-shadow: 0 10px 22px rgb(87 60 24 / 18%);
  }

  @media screen and (min-width: 750px) {
    .content-for-layout[data-template^='collection'] .product-card button.quick-add__button:is(:hover, :focus-visible) {
      padding-inline-end: 14px;
    }
  }

  @media screen and (max-width: 749px) {
    .content-for-layout[data-template^='collection'] .facets-toggle {
      border-block-end: 1px solid rgb(169 121 43 / 14%);
      background: rgb(255 253 248 / 92%);
    }

    .content-for-layout[data-template^='collection'] .main-collection-grid {
      padding-inline: var(--page-margin);
    }

    .content-for-layout[data-template^='collection'] .product-grid__card.product-grid__card {
      padding: 7px 7px 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_gemstone_filters",
      "label": "t:settings.enable_gemstone_filters",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
