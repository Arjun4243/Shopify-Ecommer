{% comment %}
  Section contract.
  Displays the supplied custom gemstone jewellery banner artwork.
  @example
  Configure the banner image URL and optional destination in the homepage editor.
{% endcomment %}
{% if section.settings.image_url != blank %}
  <section class="home-second-banner{% unless section.settings.full_width %} home-second-banner--contained{% endunless %}" style="--home-second-banner-radius: {{ section.settings.border_radius }}px;">
    <div class="home-second-banner__inner">
      <img
        class="home-second-banner__image"
        src="{{ section.settings.image_url | escape }}"
        alt=""
        width="1800"
        height="665"
        sizes="100vw"
        loading="lazy"
      >
      <div class="home-second-banner__content">
        <h2 class="home-second-banner__heading">
          <span>{{ section.settings.heading_line_1 | escape }}</span>
          <span>{{ section.settings.heading_line_2 | escape }}</span>
        </h2>
        {% if section.settings.description != blank %}
          <p class="home-second-banner__description">{{ section.settings.description | escape }}</p>
        {% endif %}
        {% if section.settings.cta_label != blank and section.settings.link != blank %}
          <a class="home-second-banner__cta" href="{{ section.settings.link | escape }}">
            <span>{{ section.settings.cta_label | escape }}</span>
            <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3.5 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/></svg>
          </a>
        {% endif %}
        <ul class="home-second-banner__features" aria-label="{{ section.settings.features_label | escape }}">
          <li class="home-second-banner__feature">
            <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="m16 3 11 9-11 17L5 12l11-9Z"/><path d="M5 12h22M11 7l5 5 5-5M11 7l5 22 5-22"/></svg>
            <span>{{ section.settings.feature_1 | escape }}</span>
          </li>
          <li class="home-second-banner__feature">
            <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><circle cx="16" cy="16" r="11"/><circle cx="16" cy="16" r="7"/><path d="M16 2v3m0 22v3M2 16h3m22 0h3"/></svg>
            <span>{{ section.settings.feature_2 | escape }}</span>
          </li>
          <li class="home-second-banner__feature">
            <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="4"/><circle cx="22" cy="10" r="4"/><circle cx="16" cy="21" r="4"/><path d="m13 13 2 4m4 0 2-4m-7 8h4"/></svg>
            <span>{{ section.settings.feature_3 | escape }}</span>
          </li>
        </ul>
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .home-second-banner {
    padding-block: 16px;
    padding-inline: 0;
  }
  .home-second-banner__inner {
    position: relative;
    aspect-ratio: 1800 / 665;
    width: 100%;
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--home-second-banner-radius, 8px);
    background: #07362c;
  }
  .home-second-banner--contained {
    padding-inline: var(--page-margin, 20px);
  }
  .home-second-banner--contained .home-second-banner__inner {
    max-width: var(--page-width, 1400px);
  }
  .home-second-banner__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .home-second-banner__content {
    position: absolute;
    inset-block: 0;
    inset-inline-start: clamp(16px, calc(4px + 4.6vw), 72px);
    display: flex;
    width: min(58%, 700px);
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(4px, calc(1px + 0.65vw), 12px);
    color: #fff;
    text-shadow: 0 1px 8px rgb(0 0 0 / 28%);
  }
  .home-second-banner__heading {
    display: grid;
    margin: 0;
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: clamp(20px, calc(11px + 2.4vw), 46px);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.025em;
  }
  .home-second-banner__description {
    max-width: 95%;
    margin: 0;
    font-size: clamp(9px, calc(7px + 0.45vw), 15px);
    line-height: 1.35;
  }
  .home-second-banner__cta {
    display: inline-flex;
    min-height: clamp(28px, calc(20px + 1.2vw), 44px);
    align-items: center;
    gap: 10px;
    margin-block: clamp(1px, 0.4vw, 7px);
    padding-inline: clamp(14px, calc(8px + 1.5vw), 30px);
    border-radius: 999px;
    background: #d9a33d;
    box-shadow: 0 3px 12px rgb(0 0 0 / 18%);
    color: #fff;
    font-size: clamp(9px, calc(7px + 0.45vw), 13px);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    text-shadow: none;
    transition: background-color 160ms ease, transform 160ms ease;
  }
  .home-second-banner__cta:hover {
    transform: translateY(-1px);
    background: #c28b27;
  }
  .home-second-banner__cta:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .home-second-banner__cta svg {
    width: clamp(12px, calc(10px + 0.4vw), 17px);
    flex: 0 0 auto;
  }
  .home-second-banner__features {
    display: grid;
    width: min(100%, 590px);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(4px, calc(2px + 0.8vw), 14px);
    margin: clamp(1px, 0.4vw, 7px) 0 0;
    padding: 0;
    list-style: none;
  }
  .home-second-banner__feature {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: clamp(4px, 0.7vw, 10px);
    font-size: clamp(8px, calc(6px + 0.5vw), 13px);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }
  .home-second-banner__feature svg {
    width: clamp(19px, calc(15px + 1.2vw), 32px);
    flex: 0 0 auto;
    fill: none;
    stroke: #d5a344;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }
  @media screen and (max-width: 749px) {
    .home-second-banner {
      padding-block: 10px;
    }
    .home-second-banner__inner {
      aspect-ratio: 1800 / 720;
    }
    .home-second-banner__image {
      object-position: 64% center;
    }
    .home-second-banner__content {
      width: 65%;
    }
    .home-second-banner__heading {
      font-size: clamp(18px, calc(12px + 2.2vw), 26px);
    }
    .home-second-banner__features {
      gap: 3px;
    }
    .home-second-banner__feature {
      gap: 3px;
      font-size: clamp(7px, calc(5px + 0.7vw), 10px);
    }
    .home-second-banner__feature svg {
      width: clamp(15px, 4.5vw, 21px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-second-banner__cta {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.home_second_banner.name",
  "settings": [
    {
      "type": "text",
      "id": "image_url",
      "label": "t:sections.home_second_banner.image_url",
      "default": "https://cdn.shopify.com/s/files/1/1003/6353/4631/files/Home-second-banner.webp?v=1792404158"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "t:sections.home_second_banner.heading_line_1",
      "default": "Custom"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "t:sections.home_second_banner.heading_line_2",
      "default": "Gemstone Jewellery"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.home_second_banner.description",
      "default": "Your stone. Your design. Handcrafted by experts."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.home_second_banner.cta_label",
      "default": "Create Your Own"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.home_second_banner.link"
    },
    {
      "type": "text",
      "id": "features_label",
      "label": "t:sections.home_second_banner.features_label",
      "default": "Custom jewellery process"
    },
    {
      "type": "text",
      "id": "feature_1",
      "label": "t:sections.home_second_banner.feature_1",
      "default": "Choose Your Gemstone"
    },
    {
      "type": "text",
      "id": "feature_2",
      "label": "t:sections.home_second_banner.feature_2",
      "default": "Personalised Design"
    },
    {
      "type": "text",
      "id": "feature_3",
      "label": "t:sections.home_second_banner.feature_3",
      "default": "Expert Craftsmanship"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.home_second_banner.full_width",
      "default": true
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:sections.home_second_banner.border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [{ "name": "t:sections.home_second_banner.name" }]
}
{% endschema %}
