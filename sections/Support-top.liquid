<section class="support-banner">
  {% if section.settings.backgrond_image != blank %}
    {{
      section.settings.backgrond_image
      | image_url: width: 2000
      | image_tag: class: 'support-banner-background-image', loading: 'lazy'
    }}
  {% endif %}

  <div class="support-container">
    {% if section.settings.support_heading_page != blank %}
      <h1 class="support-heading">{{ section.settings.support_heading_page }}</h1>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="support-description">
        {{ section.settings.description }}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .support-banner {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 320px;
    overflow: hidden;
    background: #fbf4e8;
  }

  .support-banner-background-image {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .support-banner::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      90deg,
      rgba(255, 250, 241, 0.96) 0%,
      rgba(255, 250, 241, 0.82) 34%,
      rgba(255, 250, 241, 0.28) 62%,
      rgba(255, 250, 241, 0) 100%
    );
    pointer-events: none;
  }

  .support-container {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 40px;
  }

  .support-heading {
    max-width: 430px;
    margin: 0 0 22px;
    color: #111;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 52px;
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .support-description {
    max-width: 560px;
    color: #222;
    font-size: 14px;
    line-height: 1.8;
  }

  .support-description p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .support-banner {
      min-height: 360px;
      align-items: flex-start;
    }

    .support-banner::before {
      background: rgba(255, 250, 241, 0.8);
    }

    .support-container {
      padding: 42px 22px;
    }

    .support-heading {
      max-width: 320px;
      font-size: 38px;
    }

    .support-description {
      max-width: 340px;
      font-size: 13px;
      line-height: 1.7;
    }
  }
</style>

{% schema %}
{
  "name": "Support Top",
  "settings": [
    {
      "type": "text",
      "id": "support_heading_page",
      "label": "Heading",
      "default": "Our Stores & Locations"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover our gemstone and jewelry collections at our exquisite store locations, where elegance meets craftsmanship. With the added touch of custom gem cutting and shaping, we're here to create the perfect piece just for you. Explore our stores to bring your vision to life.</p>"
    },
    {
      "type": "image_picker",
      "id": "backgrond_image",
      "label": "Banner image"
    }
  ],
  "presets": [
    {
      "name": "Support Top"
    }
  ]
}
{% endschema %}
