<section class="store-locations" id="store-locations-{{ section.id }}" aria-labelledby="store-locations-title-{{ section.id }}">
  <div class="store-locations__inner">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="store-locations__header">
        {% if section.settings.heading != blank %}
          <h2 id="store-locations-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="store-locations__intro">{{ section.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="store-locations__viewport" data-store-carousel data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}">
      <div class="store-locations__grid">
        {% for block in section.blocks %}
          <article class="store-card" {{ block.shopify_attributes }}>
          <div class="store-card__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '360, 540, 720, 900',
                  sizes: '(min-width: 990px) 31vw, (min-width: 750px) 46vw, 92vw',
                  alt: block.settings.image_alt
              }}
            {% elsif block.settings.image_url != blank %}
              <img src="{{ block.settings.image_url | escape }}" alt="{{ block.settings.image_alt | escape }}" loading="lazy" width="900" height="430">
            {% else %}
              <div class="store-card__image-fallback" aria-hidden="true"></div>
            {% endif %}

            <span class="store-card__pin" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <path d="M12 2.75c-3.35 0-6.08 2.72-6.08 6.08 0 4.24 5.35 11.72 5.58 12.04a.62.62 0 0 0 1 0c.23-.32 5.58-7.8 5.58-12.04 0-3.36-2.73-6.08-6.08-6.08Zm0 8.66a2.58 2.58 0 1 1 0-5.16 2.58 2.58 0 0 1 0 5.16Z" />
              </svg>
            </span>
          </div>

          <div class="store-card__body">
            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}

            <ul class="store-card__details" aria-label="{{ block.settings.title | escape }} details">
              {% if block.settings.address != blank %}
                <li>
                  <span aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 2.75c-3.35 0-6.08 2.72-6.08 6.08 0 4.24 5.35 11.72 5.58 12.04a.62.62 0 0 0 1 0c.23-.32 5.58-7.8 5.58-12.04 0-3.36-2.73-6.08-6.08-6.08Zm0 8.66a2.58 2.58 0 1 1 0-5.16 2.58 2.58 0 0 1 0 5.16Z" /></svg>
                  </span>
                  <p>{{ block.settings.address }}</p>
                </li>
              {% endif %}

              {% if block.settings.email != blank %}
                <li>
                  <span aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4.75 5.75h14.5c.97 0 1.75.78 1.75 1.75v9c0 .97-.78 1.75-1.75 1.75H4.75c-.97 0-1.75-.78-1.75-1.75v-9c0-.97.78-1.75 1.75-1.75Zm.42 1.5 6.4 5.1c.25.2.61.2.86 0l6.4-5.1H5.17Zm14.33 1.18-6.13 4.88a2.2 2.2 0 0 1-2.74 0L4.5 8.43v8.07c0 .14.11.25.25.25h14.5c.14 0 .25-.11.25-.25V8.43Z" /></svg>
                  </span>
                  <a href="mailto:{{ block.settings.email | escape }}">{{ block.settings.email }}</a>
                </li>
              {% endif %}

              {% if block.settings.phone != blank %}
                <li>
                  <span aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M7.11 4.05c.48-.15.99.06 1.23.5l1.35 2.52c.22.41.16.92-.15 1.27L8.35 9.7a10.2 10.2 0 0 0 5.95 5.95l1.36-1.19c.35-.31.86-.37 1.27-.15l2.52 1.35c.44.24.65.75.5 1.23l-.74 2.38c-.15.48-.59.8-1.09.8A15.19 15.19 0 0 1 2.93 4.88c0-.5.32-.94.8-1.09l2.38-.74Z" /></svg>
                  </span>
                  <a href="tel:{{ block.settings.phone | remove: ' ' | escape }}">{{ block.settings.phone }}</a>
                </li>
              {% endif %}

              {% if block.settings.hours != blank %}
                <li>
                  <span aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm.75 4.5a.75.75 0 0 0-1.5 0v5c0 .25.13.49.34.63l3.25 2.17a.75.75 0 1 0 .83-1.25l-2.92-1.95V7.5Z" /></svg>
                  </span>
                  <p>{{ block.settings.hours }}</p>
                </li>
              {% endif %}
            </ul>

            {% assign directions_url = block.settings.map_url %}
            {% if directions_url == blank and block.settings.address != blank %}
              {% assign encoded_address = block.settings.address | url_encode %}
              {% assign directions_url = 'https://www.google.com/maps/search/?api=1&query=' | append: encoded_address %}
            {% endif %}

            {% if directions_url != blank %}
              <a class="store-card__directions" href="{{ directions_url }}" target="_blank" rel="noopener noreferrer" aria-label="Get directions to {{ block.settings.title | escape }}">
                {{ section.settings.button_label }}
                <span aria-hidden="true">+</span>
              </a>
            {% endif %}
          </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  .store-locations {
    background: {{ section.settings.background_color }};
    padding: clamp(36px, 5vw, 78px) 20px;
  }

  .store-locations__inner {
    max-width: 1240px;
    margin: 0 auto;
  }

  .store-locations__header {
    max-width: 760px;
    margin: 0 auto 30px;
    text-align: center;
  }

  .store-locations__header h2 {
    margin: 0;
    color: #191411;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(28px, 3vw, 44px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .store-locations__intro {
    margin-top: 12px;
    color: #5d5448;
    font-size: 14px;
    line-height: 1.7;
  }

  .store-locations__intro p {
    margin: 0;
  }

  .store-locations__grid {
    display: flex;
    flex-wrap: nowrap;
    gap: 22px;
    perspective: 1300px;
    scroll-snap-type: x mandatory;
  }

  .store-card {
    flex: 0 0 calc((100% - 44px) / 3);
    min-width: 0;
    overflow: hidden;
    background: #fffdf9;
    border: 1px solid #eadbc0;
    border-radius: 8px;
    box-shadow: 0 16px 34px rgba(67, 45, 20, 0.08);
    transform: rotateX(0);
    transform-origin: center;
    transition: transform 280ms ease, box-shadow 280ms ease, border-color 280ms ease;
    scroll-snap-align: start;
  }

  .store-locations__viewport {
    margin-inline: -6px;
    overflow-x: auto;
    overflow-y: visible;
    padding: 0 6px 18px;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }

  .store-locations__viewport::-webkit-scrollbar {
    display: none;
  }

  .store-card:hover,
  .store-card:focus-within {
    border-color: #d6b873;
    box-shadow: 0 22px 42px rgba(67, 45, 20, 0.14);
    transform: rotateX({{ section.settings.rotate_degrees }}deg) translateY(-4px);
  }

  .store-card__media {
    position: relative;
    background: #efe5d6;
  }

  .store-card__media img,
  .store-card__image-fallback {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 7.1;
    object-fit: cover;
  }

  .store-card__image-fallback {
    background:
      linear-gradient(135deg, rgba(198, 161, 86, 0.34), rgba(255, 255, 255, 0.38)),
      linear-gradient(90deg, #c6a156, #f3e8cf 48%, #9c7541);
  }

  .store-card__pin {
    position: absolute;
    left: 18px;
    bottom: -20px;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    color: #c59b3b;
    background: #ffffff;
    border: 2px solid #dcc17e;
    border-radius: 50%;
    box-shadow: 0 7px 18px rgba(80, 54, 20, 0.16);
  }

  .store-card__pin svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  .store-card__body {
    padding: 30px 22px 22px;
  }

  .store-card h3 {
    margin: 0 0 14px;
    color: #3d2a16;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .store-card__details {
    display: grid;
    gap: 9px;
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
  }

  .store-card__details li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    min-width: 0;
    color: #5d5448;
    font-size: 13px;
    line-height: 1.45;
  }

  .store-card__details span {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    color: #a78338;
  }

  .store-card__details svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  .store-card__details p,
  .store-card__details a {
    min-width: 0;
    margin: 0;
    color: inherit;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .store-card__details a:hover {
    color: #9f772f;
  }

  .store-card__directions {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 38px;
    padding: 0 22px;
    color: #a77f32;
    border: 1px solid #d8b76b;
    border-radius: 999px;
    background: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .store-card__directions:hover {
    color: #ffffff;
    background: #b3893d;
    transform: translateX(2px);
  }

  .store-card__directions span {
    font-size: 15px;
    line-height: 1;
  }

  @media screen and (max-width: 989px) {
    .store-card {
      flex-basis: calc((100% - 22px) / 2);
    }
  }

  @media screen and (max-width: 649px) {
    .store-locations {
      padding-inline: 16px;
    }

    .store-locations__grid {
      gap: 18px;
    }

    .store-card {
      flex-basis: min(86vw, 390px);
    }

    .store-card__body {
      padding: 28px 18px 20px;
    }
  }
</style>

<script>
  (() => {
    const section = document.getElementById('store-locations-{{ section.id }}');
    const viewport = section?.querySelector('[data-store-carousel]');
    if (!viewport || viewport.dataset.carouselReady === 'true') return;

    viewport.dataset.carouselReady = 'true';

    const track = viewport.querySelector('.store-locations__grid');
    const getCards = () => Array.from(track.querySelectorAll('.store-card'));
    const getStep = () => {
      const cards = getCards();
      if (cards.length < 2) return 0;
      const first = cards[0].getBoundingClientRect();
      const second = cards[1].getBoundingClientRect();
      return Math.max(0, second.left - first.left);
    };

    const speed = Number(viewport.dataset.autoplaySpeed) || 3000;

    window.setInterval(() => {
      const cards = getCards();
      const step = getStep();
      if (cards.length <= 3 || step <= 0) return;

      const maxScroll = viewport.scrollWidth - viewport.clientWidth - 4;
      if (viewport.scrollLeft >= maxScroll) {
        viewport.scrollTo({ left: 0, behavior: 'smooth' });
        return;
      }

      viewport.scrollBy({ left: step, behavior: 'smooth' });
    }, speed);
  })();
</script>

