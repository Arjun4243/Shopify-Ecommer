<section class="privacy-policy-banner" aria-labelledby="privacy-policy-banner-title-{{ section.id }}">
  <div class="privacy-policy-banner__media" aria-hidden="true">
    {% if section.settings.banner_image != blank %}
      {{
        section.settings.banner_image
        | image_url: width: 2200
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 1800, 2200',
          sizes: '100vw',
          class: 'privacy-policy-banner__image',
          alt: section.settings.image_alt
      }}
    {% else %}
      <img
        src="{{ section.settings.fallback_image_url | escape }}"
        alt="{{ section.settings.image_alt | escape }}"
        class="privacy-policy-banner__image"
        width="1905"
        height="450"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}
  </div>

  <div class="privacy-policy-banner__content">
    {% if section.settings.eyebrow != blank %}
      <p class="privacy-policy-banner__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 id="privacy-policy-banner-title-{{ section.id }}" class="privacy-policy-banner__heading">
        {{ section.settings.heading }}
      </h1>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="privacy-policy-banner__text">{{ section.settings.text }}</div>
    {% endif %}
  </div>
</section>

<style>
  .privacy-policy-banner {
    position: relative;
    min-height: clamp(280px, 28vw, 450px);
    overflow: hidden;
    background: #f7efe3;
  }

  .privacy-policy-banner__media {
    position: absolute;
    inset: 0;
  }

  .privacy-policy-banner__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .privacy-policy-banner::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(255, 250, 243, 0.98) 0%,
      rgba(255, 250, 243, 0.88) 34%,
      rgba(255, 250, 243, 0.42) 62%,
      rgba(255, 250, 243, 0.08) 100%
    );
    pointer-events: none;
  }

  .privacy-policy-banner__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: clamp(280px, 28vw, 450px);
    width: min(100%, 1280px);
    margin: 0 auto;
    padding: clamp(38px, 5vw, 78px) 6%;
  }

  .privacy-policy-banner__eyebrow {
    margin: 0 0 16px;
    color: #7a7064;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 3px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .privacy-policy-banner__eyebrow::after {
    content: "";
    display: inline-block;
    width: 48px;
    height: 1px;
    margin-left: 14px;
    vertical-align: middle;
    background: #c6a156;
  }

  .privacy-policy-banner__heading {
    max-width: 560px;
    margin: 0;
    color: #17120f;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(42px, 5vw, 74px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .privacy-policy-banner__text {
    max-width: 580px;
    margin-top: 20px;
    color: #4d4740;
    font-size: clamp(14px, 1.1vw, 17px);
    font-weight: 500;
    line-height: 1.7;
  }

  .privacy-policy-banner__text p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .privacy-policy-banner {
      min-height: 360px;
    }

    .privacy-policy-banner::before {
      background: linear-gradient(
        90deg,
        rgba(255, 250, 243, 0.95) 0%,
        rgba(255, 250, 243, 0.78) 58%,
        rgba(255, 250, 243, 0.28) 100%
      );
    }

    .privacy-policy-banner__image {
      object-position: 62% center;
    }

    .privacy-policy-banner__content {
      min-height: 360px;
      padding: 42px 22px;
    }

    .privacy-policy-banner__eyebrow {
      font-size: 11px;
      letter-spacing: 2px;
    }

    .privacy-policy-banner__heading {
      max-width: 320px;
      font-size: clamp(38px, 12vw, 52px);
    }

    .privacy-policy-banner__text {
      max-width: 330px;
      font-size: 14px;
      line-height: 1.6;
    }
  }
</style>

{% schema %}
{
  "name": "Privacy policy Local",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "fallback_image_url",
      "label": "Fallback image URL",
      "default": "https://cdn.shopify.com/s/files/1/1003/6353/4631/files/privacy-policy.webp?v=1789558458"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Gemstones arranged on a soft neutral privacy policy banner"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Privacy Policy"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Privacy Policy"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Your trust matters to us. Learn how we collect, use, and protect your information.</p>"
    }
  ],
  "presets": [
    {
      "name": "Privacy policy page"
    }
  ]
}
{% endschema %}
