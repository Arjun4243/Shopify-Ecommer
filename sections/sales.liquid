{% comment %}
  Sales page contract.
  Renders a dynamic sale banner and filterable grid of products with sale metafields or compare-at pricing.
  @example
  Assign this section to templates/page.sales.json.
{% endcomment %}

{% liquid
  assign source_collection = collections.all
  assign products_limit = section.settings.products_limit
  assign rendered_products_count = 0
  assign quick_add_enabled = false
  if settings.quick_add or settings.mobile_quick_add
    assign quick_add_enabled = true
  endif
%}

<section class="sales-page" data-sales-page>
  <div class="sales-page__banner">
    {% if section.settings.banner_image != blank %}
      {{
        section.settings.banner_image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          alt: section.settings.banner_image.alt,
          class: 'sales-page__banner-image'
      }}
    {% elsif section.settings.banner_image_url != blank %}
      <img
        class="sales-page__banner-image"
        src="{{ section.settings.banner_image_url }}"
        alt="{{ section.settings.banner_image_alt | escape }}"
        width="2400"
        height="620"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}
    <div class="sales-page__banner-overlay">
      <div class="sales-page__banner-copy">
        {% if section.settings.top_text != blank %}
          <p class="sales-page__eyebrow"><span></span>{{ section.settings.top_text | escape }}<span></span></p>
        {% endif %}
        {% if section.settings.heading != blank %}
          {% liquid
            assign heading_words = section.settings.heading | strip | split: ' '
            assign heading_last_word = heading_words | last
            assign heading_prefix = ''
            for heading_word in heading_words
              unless forloop.last
                assign heading_prefix = heading_prefix | append: heading_word
                unless forloop.rindex == 2
                  assign heading_prefix = heading_prefix | append: ' '
                endunless
              endunless
            endfor
          %}
          <h1>
            {% if heading_prefix != blank %}
              <span>{{ heading_prefix | escape }}</span>
              <span class="sales-page__heading-accent">{{ heading_last_word | escape }}</span>
            {% else %}
              <span>{{ heading_last_word | escape }}</span>
            {% endif %}
          </h1>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="sales-page__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
      {% if section.settings.discount_text != blank %}
        <div class="sales-page__discount" aria-label="{{ section.settings.discount_text | escape }}">
          {{ section.settings.discount_text | newline_to_br }}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="sales-page__layout">
    <aside id="SalesFilters-{{ section.id }}" class="sales-page__filters" aria-label="Filters" data-sales-filter-drawer>
      <div class="sales-page__filters-head">
        <h2>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16l-6.2 7.1v5.5l-3.6 1.8v-7.3L4 5Zm4.4 2 3.8 4.4v4.8l.6-.3v-4.5L16.6 7H8.4Z" /></svg>
          Filters
        </h2>
        <div class="sales-page__filter-actions">
          <button type="button" data-sales-clear>Clear all</button>
          <button class="sales-page__filter-close" type="button" aria-label="{{ 'actions.close' | t }}" data-sales-filter-close>X</button>
        </div>
      </div>

      <details class="sales-filter" open>
        <summary>Product Type</summary>
        <div class="sales-filter__options" data-sales-options="productType"></div>
      </details>
      <details class="sales-filter" open>
        <summary>Discount</summary>
        <div class="sales-filter__options" data-sales-options="discount"></div>
      </details>
      <details class="sales-filter">
        <summary>Price</summary>
        <div class="sales-price-filter">
          <label><span>Min</span><input type="number" inputmode="numeric" data-sales-price-min></label>
          <label><span>Max</span><input type="number" inputmode="numeric" data-sales-price-max></label>
        </div>
        <div class="sales-price-range" data-sales-price-range>
          <input type="range" aria-label="Minimum price" data-sales-price-min-range>
          <input type="range" aria-label="Maximum price" data-sales-price-max-range>
        </div>
        <p class="sales-price-filter__hint" data-sales-price-hint></p>
      </details>
      <details class="sales-filter">
        <summary>Gemstone Type</summary>
        <div class="sales-filter__options" data-sales-options="gemstoneType"></div>
      </details>
      <details class="sales-filter">
        <summary>Shape</summary>
        <div class="sales-filter__options" data-sales-options="shape"></div>
      </details>
      <details class="sales-filter">
        <summary>Color</summary>
        <div class="sales-filter__options" data-sales-options="color"></div>
      </details>
    </aside>

    <button class="sales-page__scrim" type="button" aria-label="{{ 'actions.close' | t }}" data-sales-filter-close></button>

    <div class="sales-page__main">
      <div class="sales-page__toolbar">
        <button
          class="sales-page__filter-toggle"
          type="button"
          aria-controls="SalesFilters-{{ section.id }}"
          aria-expanded="false"
          data-sales-filter-toggle
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16l-6.2 7.1v5.5l-3.6 1.8v-7.3L4 5Z" /></svg>
          Filters
        </button>
        <p class="sales-page__count" data-sales-count>Products</p>
        <div class="sales-page__tools">
          <label class="sales-page__sort">
            <span>Sort:</span>
            <select data-sales-sort>
              <option value="discount-desc">Biggest Discount</option>
              <option value="price-asc">Price: low to high</option>
              <option value="price-desc">Price: high to low</option>
              <option value="title-asc">Name: A to Z</option>
            </select>
          </label>
        </div>
      </div>

      <div class="sales-page__grid" data-sales-grid>
        {% if source_collection != blank and source_collection.products_count > 0 %}
          {% paginate source_collection.products by products_limit %}
            {% for product in source_collection.products %}
              {% liquid
                assign sale_discount_raw = product.metafields.custom.sale_discount_percentage.value | default: product.metafields.custom.sale_discount_percentage
                assign sale_discount = sale_discount_raw | plus: 0
                assign compare_at_price = product.compare_at_price
                assign price = product.price
                assign is_sale_product = false
                if sale_discount > 0 and sale_discount < 100
                  assign is_sale_product = true
                elsif compare_at_price > price
                  assign sale_discount = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price
                  assign is_sale_product = true
                endif
              %}
              {% if is_sale_product %}
                {% liquid
                  assign rendered_products_count = rendered_products_count | plus: 1
                  assign product_group = product.metafields.custom.gemstone_group.value | default: product.metafields.custom.gemstone_group
                  assign product_type_label = product_group | default: product.type
                  assign gemstone_type = product.metafields.custom.gemstone_type.value | default: product.metafields.custom.gemstone_type
                  assign shape = product.metafields.custom.shape.value | default: product.metafields.custom.shape
                  assign color = product.metafields.custom.color.value | default: product.metafields.custom.color
                  if color == blank
                    assign color_option = product.options_with_values | where: 'name', 'Color' | first
                    assign first_color_value = color_option.values | first
                    assign color = first_color_value.name | default: first_color_value
                  endif
                %}
                <div
                  class="sales-page__item"
                  data-sales-item
                  data-index="{{ rendered_products_count }}"
                  data-title="{{ product.title | escape }}"
                  data-price="{{ product.price }}"
                  data-discount="{{ sale_discount }}"
                  data-product-type="{{ product_type_label | escape }}"
                  data-product-type-key="{{ product_type_label | handleize }}"
                  data-gemstone-type="{{ gemstone_type | escape }}"
                  data-gemstone-type-key="{{ gemstone_type | handleize }}"
                  data-shape="{{ shape | escape }}"
                  data-shape-key="{{ shape | handleize }}"
                  data-color="{{ color | escape }}"
                  data-color-key="{{ color | handleize }}"
                >
                  {% render 'stone-product-card',
                    product: product,
                    card_class: 'sales-product-card',
                    section_id: section.id,
                    quick_add_enabled: quick_add_enabled
                  %}
                </div>
              {% endif %}
            {% endfor %}
          {% endpaginate %}
        {% endif %}
      </div>

      <p class="sales-page__empty" data-sales-empty hidden>No sale products match these filters.</p>
    </div>
  </div>
</section>

{% javascript %}
  (() => {
    const formatMoney = new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 });
    const handle = (value) => String(value || '').trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

    const initSalesPage = (page) => {
      if (page.dataset.salesPageInitialized === 'true') return;
      page.dataset.salesPageInitialized = 'true';

      const items = Array.from(page.querySelectorAll('[data-sales-item]'));
      const grid = page.querySelector('[data-sales-grid]');
      const count = page.querySelector('[data-sales-count]');
      const empty = page.querySelector('[data-sales-empty]');
      const sort = page.querySelector('[data-sales-sort]');
      const priceMinInput = page.querySelector('[data-sales-price-min]');
      const priceMaxInput = page.querySelector('[data-sales-price-max]');
      const priceMinRange = page.querySelector('[data-sales-price-min-range]');
      const priceMaxRange = page.querySelector('[data-sales-price-max-range]');
      const priceRange = page.querySelector('[data-sales-price-range]');
      const priceHint = page.querySelector('[data-sales-price-hint]');
      const clearButtons = page.querySelectorAll('[data-sales-clear]');
      const drawer = page.querySelector('[data-sales-filter-drawer]');
      const filterToggle = page.querySelector('[data-sales-filter-toggle]');
      const filterCloseButtons = page.querySelectorAll('[data-sales-filter-close]');
      const mobileMedia = window.matchMedia('(max-width: 900px)');
      let filterToggleReturn = null;

      const state = {
        productType: new Set(),
        discount: new Set(),
        gemstoneType: new Set(),
        shape: new Set(),
        color: new Set(),
        min: null,
        max: null,
        sort: 'discount-desc',
      };

      const prices = items.map((item) => Number(item.dataset.price || 0) / 100).filter((price) => price > 0);
      const minPrice = prices.length ? Math.floor(Math.min(...prices)) : 0;
      const maxPrice = prices.length ? Math.ceil(Math.max(...prices)) : 0;

      if (priceMinInput && priceMaxInput) {
        priceMinInput.min = minPrice;
        priceMinInput.max = maxPrice;
        priceMaxInput.min = minPrice;
        priceMaxInput.max = maxPrice;
        priceMinInput.placeholder = String(minPrice);
        priceMaxInput.placeholder = String(maxPrice);
      }
      if (priceMinRange && priceMaxRange) {
        [priceMinRange, priceMaxRange].forEach((input) => {
          input.min = minPrice;
          input.max = maxPrice;
          input.step = 1;
        });
        priceMinRange.value = minPrice;
        priceMaxRange.value = maxPrice;
      }
      if (priceHint) priceHint.textContent = `Available price: Rs. ${formatMoney.format(minPrice)} - Rs. ${formatMoney.format(maxPrice)}`;

      const closeDrawer = () => {
        page.classList.remove('is-filter-drawer-open');
        filterToggle?.setAttribute('aria-expanded', 'false');
        drawer?.setAttribute('aria-hidden', mobileMedia.matches ? 'true' : 'false');
        document.documentElement.classList.remove('sales-filter-drawer-open');
        if (filterToggleReturn instanceof HTMLElement) filterToggleReturn.focus();
      };

      const openDrawer = () => {
        if (!mobileMedia.matches) return;
        filterToggleReturn = document.activeElement;
        page.classList.add('is-filter-drawer-open');
        filterToggle?.setAttribute('aria-expanded', 'true');
        drawer?.setAttribute('aria-hidden', 'false');
        document.documentElement.classList.add('sales-filter-drawer-open');
        drawer?.querySelector('[data-sales-filter-close]')?.focus();
      };

      const makeOptions = (keyAttr, labelAttr = keyAttr) => {
        const map = new Map();
        items.forEach((item) => {
          const key = item.dataset[keyAttr];
          const label = item.dataset[labelAttr];
          if (!key || !label) return;
          const entry = map.get(key) || { key, label, count: 0 };
          entry.count += 1;
          map.set(key, entry);
        });
        return Array.from(map.values()).sort((a, b) => a.label.localeCompare(b.label));
      };

      const discountRanges = [
        { key: 'up-to-10', label: 'Up to 10% Off', min: 0, max: 10 },
        { key: '10-20', label: '10% - 20% Off', min: 10, max: 20 },
        { key: '20-30', label: '20% - 30% Off', min: 20, max: 30 },
        { key: '30-50', label: '30% - 50% Off', min: 30, max: 50 },
        { key: '50-plus', label: '50%+ Off', min: 50, max: Infinity },
      ].map((range) => ({
        ...range,
        count: items.filter((item) => {
          const discount = Number(item.dataset.discount || 0);
          return discount > range.min && discount <= range.max;
        }).length,
      }));

      const optionGroups = {
        productType: makeOptions('productTypeKey', 'productType'),
        discount: discountRanges,
        gemstoneType: makeOptions('gemstoneTypeKey', 'gemstoneType'),
        shape: makeOptions('shapeKey', 'shape'),
        color: makeOptions('colorKey', 'color'),
      };

      Object.entries(optionGroups).forEach(([group, options]) => {
        const target = page.querySelector(`[data-sales-options="${group}"]`);
        if (!target) return;
        target.innerHTML = options.filter((option) => option.count > 0).map((option) => `
          <label class="sales-filter__option">
            <input type="checkbox" value="${option.key}" data-sales-check="${group}">
            <span></span>
            <em>${option.label} (${option.count})</em>
          </label>
        `).join('');
      });

      const updatePriceRangeTrack = () => {
        if (!priceRange || !priceMinRange || !priceMaxRange || maxPrice <= minPrice) return;
        const minValue = Number(priceMinRange.value || minPrice);
        const maxValue = Number(priceMaxRange.value || maxPrice);
        const start = ((minValue - minPrice) / (maxPrice - minPrice)) * 100;
        const end = ((maxValue - minPrice) / (maxPrice - minPrice)) * 100;
        priceRange.style.setProperty('--range-start', `${start}%`);
        priceRange.style.setProperty('--range-end', `${end}%`);
      };

      const syncPriceControls = (source = 'number') => {
        const minSource = source === 'range' ? priceMinRange : priceMinInput;
        const maxSource = source === 'range' ? priceMaxRange : priceMaxInput;
        let min = Number(minSource?.value || minPrice);
        let max = Number(maxSource?.value || maxPrice);
        min = Math.max(minPrice, Math.min(min, maxPrice));
        max = Math.max(minPrice, Math.min(max, maxPrice));
        if (min > max) min = max;
        state.min = min;
        state.max = max;
        if (source === 'range') {
          if (priceMinInput) priceMinInput.value = min;
          if (priceMaxInput) priceMaxInput.value = max;
        } else {
          if (priceMinRange) priceMinRange.value = min;
          if (priceMaxRange) priceMaxRange.value = max;
        }
        updatePriceRangeTrack();
      };

      const matchesDiscount = (item) => {
        if (!state.discount.size) return true;
        const discount = Number(item.dataset.discount || 0);
        return Array.from(state.discount).some((key) => {
          const range = discountRanges.find((entry) => entry.key === key);
          return range && discount > range.min && discount <= range.max;
        });
      };

      const apply = () => {
        syncPriceControls();
        let visible = items.filter((item) => {
          const price = Number(item.dataset.price || 0) / 100;
          return (!state.productType.size || state.productType.has(item.dataset.productTypeKey))
            && matchesDiscount(item)
            && (!state.gemstoneType.size || state.gemstoneType.has(item.dataset.gemstoneTypeKey))
            && (!state.shape.size || state.shape.has(item.dataset.shapeKey))
            && (!state.color.size || state.color.has(item.dataset.colorKey))
            && price >= state.min
            && price <= state.max;
        });

        visible.sort((a, b) => {
          if (state.sort === 'price-asc') return Number(a.dataset.price) - Number(b.dataset.price);
          if (state.sort === 'price-desc') return Number(b.dataset.price) - Number(a.dataset.price);
          if (state.sort === 'title-asc') return a.dataset.title.localeCompare(b.dataset.title);
          return Number(b.dataset.discount) - Number(a.dataset.discount);
        });

        items.forEach((item) => { item.hidden = true; });
        visible.forEach((item) => {
          item.hidden = false;
          grid.appendChild(item);
        });

        count.textContent = `${visible.length} products`;
        empty.hidden = visible.length > 0;
      };

      page.addEventListener('change', (event) => {
        const checkbox = event.target.closest('[data-sales-check]');
        if (checkbox) {
          const group = checkbox.dataset.salesCheck;
          checkbox.checked ? state[group].add(checkbox.value) : state[group].delete(checkbox.value);
        }
        if (event.target === sort) state.sort = sort.value;
        apply();
      });

      page.addEventListener('input', (event) => {
        if (event.target === priceMinInput || event.target === priceMaxInput) apply();
        if (event.target === priceMinRange || event.target === priceMaxRange) {
          syncPriceControls('range');
          apply();
        }
      });

      clearButtons.forEach((button) => {
        button.addEventListener('click', () => {
          Object.values(state).forEach((value) => {
            if (value instanceof Set) value.clear();
          });
          state.sort = 'discount-desc';
          if (sort) sort.value = state.sort;
          if (priceMinInput) priceMinInput.value = '';
          if (priceMaxInput) priceMaxInput.value = '';
          if (priceMinRange) priceMinRange.value = minPrice;
          if (priceMaxRange) priceMaxRange.value = maxPrice;
          page.querySelectorAll('[data-sales-check]').forEach((checkbox) => { checkbox.checked = false; });
          apply();
        });
      });

      filterToggle?.addEventListener('click', openDrawer);
      filterCloseButtons.forEach((button) => button.addEventListener('click', closeDrawer));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && page.classList.contains('is-filter-drawer-open')) closeDrawer();
      });
      mobileMedia.addEventListener('change', () => {
        if (mobileMedia.matches) {
          drawer?.setAttribute('aria-hidden', page.classList.contains('is-filter-drawer-open') ? 'false' : 'true');
        } else {
          closeDrawer();
          drawer?.setAttribute('aria-hidden', 'false');
        }
      });
      drawer?.setAttribute('aria-hidden', mobileMedia.matches ? 'true' : 'false');
      updatePriceRangeTrack();
      apply();
    };

    const initAllSalesPages = (root = document) => {
      if (root.matches?.('[data-sales-page]')) initSalesPage(root);
      root.querySelectorAll('[data-sales-page]').forEach(initSalesPage);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initAllSalesPages(), { once: true });
    } else {
      initAllSalesPages();
    }
    document.addEventListener('shopify:section:load', (event) => initAllSalesPages(event.target));
  })();
{% endjavascript %}

{% stylesheet %}
  .sales-page {
    background: #fffdf9;
    color: #111827;
    font-family: Inter, sans-serif;
  }

  .sales-page__banner {
    position: relative;
    min-height: clamp(158px, 16.8vw, 258px);
    overflow: hidden;
    background: linear-gradient(90deg, #f8efe3, #f4dfcd 55%, #8c0507);
  }

  .sales-page__banner-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
  }

  .sales-page__banner-overlay {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(18px, 3vw, 48px);
    min-height: inherit;
    width: min(100%, 1480px);
    margin: 0 auto;
    padding: clamp(18px, 2.6vw, 34px) 7%;
  }

  .sales-page__banner-copy {
    max-width: 650px;
  }

  .sales-page__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 6px;
    color: #7a4b19;
    font-size: clamp(10px, 0.82vw, 13px);
    font-weight: 700;
    letter-spacing: 6px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .sales-page__eyebrow span {
    width: clamp(26px, 4vw, 58px);
    height: 1px;
    background: #c9a460;
  }

  .sales-page__banner h1 {
    display: flex;
    flex-wrap: wrap;
    gap: 0.24em;
    margin: 0;
    color: #111;
    font-family: var(--font-heading--family);
    font-size: clamp(36px, 5.5vw, 78px);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .sales-page__heading-accent {
    color: #9b0506;
  }

  .sales-page__subheading {
    max-width: 560px;
    margin: 7px 0 0;
    color: #1f2937;
    font-size: clamp(13px, 1.22vw, 18px);
    line-height: 1.32;
  }

  .sales-page__discount {
    display: grid;
    place-items: center;
    width: clamp(104px, 11vw, 164px);
    aspect-ratio: 1;
    border: 2px solid #e4c56f;
    border-radius: 50%;
    background: #98080b;
    color: #f8dc92;
    font-family: var(--font-heading--family);
    font-size: clamp(25px, 3.8vw, 56px);
    font-weight: 800;
    line-height: 0.9;
    text-align: center;
    box-shadow: 0 12px 30px rgb(60 0 0 / 24%);
  }

  .sales-page__layout {
    display: grid;
    grid-template-columns: minmax(240px, 290px) minmax(0, 1fr);
    gap: 34px;
    width: min(100%, 1600px);
    margin: 0 auto;
    padding: 110px 4% 64px;
  }

  .sales-page__filters {
    position: sticky;
    top: 20px;
    align-self: start;
    padding: 18px 20px;
    border: 1px solid #eee6dc;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 12px 34px rgb(17 24 39 / 7%);
  }

  .sales-page__filters-head,
  .sales-page__toolbar,
  .sales-page__tools,
  .sales-page__filters-head h2,
  .sales-filter__option {
    display: flex;
    align-items: center;
  }

  .sales-page__filters-head,
  .sales-page__toolbar {
    justify-content: space-between;
    gap: 18px;
  }

  .sales-page__filters-head h2 {
    gap: 8px;
    margin: 0;
    font-size: 17px;
    line-height: 1.2;
  }

  .sales-page__filters-head svg,
  .sales-page__filter-toggle svg,
  .sales-page__tools svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .sales-page__filter-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sales-page__filter-actions button,
  .sales-page__filter-toggle {
    cursor: pointer;
  }

  .sales-page__filter-actions button {
    border: 0;
    background: transparent;
    color: #b86500;
    font-size: 13px;
  }

  .sales-page__filter-toggle,
  .sales-page__filter-close,
  .sales-page__scrim {
    display: none;
  }

  .sales-filter {
    padding: 14px 0;
    border-top: 1px solid #eee6dc;
  }

  .sales-filter summary {
    cursor: pointer;
    color: #111827;
    font-size: 16px;
    font-weight: 800;
  }

  .sales-filter__options {
    display: grid;
    gap: 10px;
    margin-top: 12px;
  }

  .sales-filter__option {
    gap: 10px;
    color: #4b5563;
    cursor: pointer;
    font-size: 15px;
  }

  .sales-filter__option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .sales-filter__option span {
    display: grid;
    place-items: center;
    width: 17px;
    height: 17px;
    border: 1px solid #aeb6c2;
    border-radius: 3px;
    background: #fff;
  }

  .sales-filter__option input:checked + span {
    border-color: #b40012;
    background: #b40012;
  }

  .sales-filter__option input:checked + span::after {
    content: "";
    width: 8px;
    height: 4px;
    border-left: 2px solid #fff;
    border-bottom: 2px solid #fff;
    transform: rotate(-45deg);
  }

  .sales-filter__option em {
    font-style: normal;
  }

  .sales-price-filter {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 12px;
  }

  .sales-price-filter label {
    display: grid;
    gap: 4px;
    padding: 8px 10px;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
  }

  .sales-price-filter span,
  .sales-price-filter__hint {
    color: #6b7280;
    font-size: 12px;
  }

  .sales-price-filter input,
  .sales-page__sort select {
    width: 100%;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    outline: 0;
  }

  .sales-price-filter__hint {
    margin: 10px 0 0;
    line-height: 1.35;
  }

  .sales-price-range {
    --range-start: 0%;
    --range-end: 100%;
    position: relative;
    height: 26px;
    margin-top: 14px;
  }

  .sales-price-range::before,
  .sales-price-range::after {
    content: "";
    position: absolute;
    inset-block-start: 10px;
    inset-inline: 0;
    height: 4px;
    border-radius: 999px;
  }

  .sales-price-range::before {
    background: #e5e7eb;
  }

  .sales-price-range::after {
    inset-inline-start: var(--range-start);
    inset-inline-end: calc(100% - var(--range-end));
    background: #b40012;
  }

  .sales-price-range input {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 1;
    width: 100%;
    height: 26px;
    margin: 0;
    appearance: none;
    background: transparent;
    pointer-events: none;
  }

  .sales-price-range input::-webkit-slider-runnable-track {
    height: 4px;
    background: transparent;
  }

  .sales-price-range input::-moz-range-track {
    height: 4px;
    background: transparent;
  }

  .sales-price-range input::-webkit-slider-thumb {
    width: 18px;
    height: 18px;
    margin-top: -7px;
    border: 3px solid #b40012;
    border-radius: 50%;
    appearance: none;
    background: #fff;
    box-shadow: 0 2px 8px rgb(17 24 39 / 18%);
    cursor: pointer;
    pointer-events: auto;
  }

  .sales-price-range input::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border: 3px solid #b40012;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 8px rgb(17 24 39 / 18%);
    cursor: pointer;
    pointer-events: auto;
  }

  .sales-page__main {
    min-width: 0;
  }

  .sales-page__count {
    margin: 0;
    color: #374151;
    font-size: 15px;
  }

  .sales-page__tools {
    gap: 10px;
  }

  .sales-page__sort {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #fff;
    white-space: nowrap;
  }

  .sales-page__sort span {
    color: #4b5563;
  }

  .sales-page__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px 24px;
    margin-top: 16px;
  }

  .sales-product-card .quick-add {
    position: static;
    margin: 0;
    opacity: 1;
    transform: none;
  }

  .sales-page__empty {
    margin: 30px 0 0;
    color: #6b7280;
    font-weight: 700;
  }

  @media screen and (max-width: 1180px) {
    .sales-page__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 900px) {
    .sales-page__banner {
      min-height: 320px;
    }

    .sales-page__banner-image {
      object-position: 62% center;
    }

    .sales-page__banner-overlay {
      grid-template-columns: 1fr;
      justify-items: start;
      padding: 34px 22px;
    }

    .sales-page__discount {
      width: 132px;
    }

    .sales-page__layout {
      grid-template-columns: 1fr;
      padding: 34px 18px 46px;
    }

    .sales-page__filters {
      position: fixed;
      z-index: 60;
      inset-block: 0;
      inset-inline-start: 0;
      width: min(86vw, 360px);
      max-width: 100%;
      overflow-y: auto;
      border-radius: 0;
      transform: translateX(-100%);
      transition: transform 220ms ease;
    }

    [dir='rtl'] .sales-page__filters {
      transform: translateX(100%);
    }

    html.sales-filter-drawer-open {
      overflow: hidden;
    }

    .sales-page.is-filter-drawer-open .sales-page__filters {
      transform: translateX(0);
    }

    .sales-page__filter-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 42px;
      width: max-content;
      padding: 0 16px;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      background: #fff;
      color: #111827;
      font-weight: 800;
      box-shadow: 0 4px 12px rgb(17 24 39 / 8%);
    }

    .sales-page__filter-close {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      color: #111827;
      font-size: 18px;
      line-height: 1;
    }

    .sales-page__scrim {
      position: fixed;
      z-index: 50;
      inset: 0;
      display: block;
      border: 0;
      background: rgb(17 24 39 / 44%);
      opacity: 0;
      pointer-events: none;
      transition: opacity 220ms ease;
    }

    .sales-page.is-filter-drawer-open .sales-page__scrim {
      opacity: 1;
      pointer-events: auto;
    }

    .sales-page__toolbar {
      align-items: stretch;
      flex-wrap: wrap;
    }

    .sales-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 14px;
    }
  }

  @media screen and (max-width: 560px) {
    .sales-page__banner {
      min-height: 360px;
    }

    .sales-page__banner::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgb(255 248 238 / 0.94), rgb(255 248 238 / 0.58) 58%, rgb(255 248 238 / 0));
    }

    .sales-page__banner-overlay {
      align-content: start;
      gap: 18px;
    }

    .sales-page__eyebrow {
      gap: 8px;
      letter-spacing: 3px;
    }

    .sales-page__eyebrow span {
      width: 28px;
    }

    .sales-page__banner h1 {
      font-size: 42px;
    }

    .sales-page__subheading {
      font-size: 16px;
    }

    .sales-page__tools {
      flex-wrap: wrap;
    }

    .sales-page__sort {
      flex: 1 1 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sales page",
  "settings": [
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    },
    {
      "type": "url",
      "id": "banner_image_url",
      "label": "Fallback banner image URL"
    },
    {
      "type": "text",
      "id": "banner_image_alt",
      "label": "Fallback image alt text",
      "default": "Gemstone sale banner"
    },
    {
      "type": "text",
      "id": "top_text",
      "label": "Small top text",
      "default": "Limited time only"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Special Offers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore limited-time savings across gemstones and fine jewellery."
    },
    {
      "type": "textarea",
      "id": "discount_text",
      "label": "Discount text",
      "default": "Up to\n50%\nOff"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to scan",
      "min": 25,
      "max": 250,
      "step": 5,
      "default": 250
    }
  ],
  "presets": [
    {
      "name": "Sales page"
    }
  ]
}
{% endschema %}
