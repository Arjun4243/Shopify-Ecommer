<section class="semi-section-category">
    <div class="container">
        <div class="semi-category-content">
            <h2>{{ section.settings.semi_title_category }}</h2>
            <p>{{ section.settings.description }}</p>
        </div>
    </div>
</section>

{%schema%}
{
"name":"Semi Precious Category",
"settings":[
    {
    "type":"text",
    "id":"semi_title_category",
    "label":"Semi Precious Category Title",
    "default":"Semi Precious Category"
    },
     {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our beautiful collection of semi-precious gemstones."
    }
],
"presets":[
    {
        "name":"Semi Precious Category",
        "category":"Custom"
    }
]
}
{%endschema%}