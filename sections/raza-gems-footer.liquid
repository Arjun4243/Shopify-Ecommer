        { "type": "text", "id": "label", "label": "Label", "default": "FAQs" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "contact_item",
      "name": "Contact item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "clock", "label": "Clock" },
            { "value": "headset", "label": "Headset" },
            { "value": "pin", "label": "Location pin" },
            { "value": "phone", "label": "Phone" },
            { "value": "email", "label": "Email" }
          ],
          "default": "clock"
        },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Visit our store 10:00 AM to 8:00 PM" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "social_link",
      "name": "Social link",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "instagram", "label": "Instagram" },
            { "value": "facebook", "label": "Facebook" },
            { "value": "pinterest", "label": "Pinterest" },
            { "value": "youtube", "label": "YouTube" },
            { "value": "tiktok", "label": "TikTok" }
          ],
          "default": "instagram"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Instagram" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    },
    {
      "type": "company_link",
      "name": "Company link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "About Us" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "feature",
      "name": "Trust feature",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "*" },
        { "type": "text", "id": "label", "label": "Label", "default": "Certified Quality" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Raza Gems custom footer",
      "blocks": [
        { "type": "logo_image" },
        { "type": "contact_item", "settings": { "icon": "clock", "text": "Visit our store 10:00 AM to 8:00 PM" } },
        { "type": "contact_item", "settings": { "icon": "headset", "text": "Call our Helpline Number or Write us at email for order related queries" } },
