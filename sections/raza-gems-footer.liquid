{% liquid
  assign footer_bg = section.settings.background_image
%}

<footer class="raza-footer" style="--raza-bg: {{ section.settings.background_color }}; --raza-gold: {{ section.settings.accent_color }}; --raza-text: {{ section.settings.text_color }};">
  {% if footer_bg != blank %}
    {{ footer_bg | image_url: width: 2400 | image_tag: class: 'raza-footer__bg', loading: 'lazy', widths: '750, 1100, 1500, 2000, 2400' }}
  {% endif %}

  <div class="raza-footer__shade"></div>

  <div class="raza-footer__inner page-width">
    <div class="raza-footer__main">
      <div class="raza-footer__brand">
        {% for block in section.blocks %}
          {% if block.type == 'logo_image' %}
            <div class="raza-footer__logo-block" {{ block.shopify_attributes }}>
              {% if block.settings.logo != blank %}
                {{
                  block.settings.logo
                  | image_url: width: 700
                  | image_tag: class: 'raza-footer__logo', loading: 'lazy', widths: '180, 260, 360, 520, 700'
                }}
              {% endif %}
            </div>
            {% break %}
          {% endif %}
        {% endfor %}
      </div>

      <div class="raza-footer__menus">
        <div class="raza-footer__menu">
          <h2>{{ section.settings.orders_heading }}</h2>
          <span class="raza-footer__rule"></span>
          {% for block in section.blocks %}
            {% if block.type == 'orders_link' %}
              <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }} <span aria-hidden="true">&rsaquo;</span></a>
            {% endif %}
          {% endfor %}
        </div>

        <div class="raza-footer__menu">
          <h2>{{ section.settings.company_heading }}</h2>
          <span class="raza-footer__rule"></span>
          {% for block in section.blocks %}
            {% if block.type == 'company_link' %}
              <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }} <span aria-hidden="true">&rsaquo;</span></a>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="raza-footer__newsletter">
        <h2>{{ section.settings.newsletter_heading }}</h2>
        <span class="raza-footer__rule"></span>
        <p>{{ section.settings.newsletter_text }}</p>

        {% form 'customer', class: 'raza-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.email_placeholder }}"
            aria-label="{{ section.settings.email_placeholder }}"
            required
          >
          <button type="submit">{{ section.settings.button_label }} <span aria-hidden="true">&rarr;</span></button>
        {% endform %}

        <div class="raza-footer__features">
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
              <div class="raza-footer__feature" {{ block.shopify_attributes }}>
                <span class="raza-footer__feature-icon">{{ block.settings.icon }}</span>
                <span>{{ block.settings.label }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="raza-footer__bottom">
      <div class="raza-footer__country">{{ section.settings.country_text }}</div>
      <div class="raza-footer__copyright">{{ section.settings.copyright_text }}</div>
      <div class="raza-footer__payments">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag: class: 'raza-footer__payment' }}
        {% endfor %}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .raza-footer {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 0 100%, rgba(205, 166, 93, 0.22), transparent 28rem),
      radial-gradient(circle at 100% 0, rgba(205, 166, 93, 0.2), transparent 25rem),
      linear-gradient(135deg, #031611, var(--raza-bg));
    color: var(--raza-text);
  }

  .raza-footer__bg,
  .raza-footer__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .raza-footer__bg {
    object-fit: cover;
    opacity: 0.34;
  }

  .raza-footer__shade {
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0.48));
  }

  .raza-footer__inner {
    position: relative;
    z-index: 1;
    padding: 48px 24px 24px;
  }

  .raza-footer__main {
    display: grid;
    grid-template-columns: minmax(180px, 0.75fr) minmax(320px, 1.55fr) minmax(280px, 1.45fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .raza-footer__brand {
    min-height: 1px;
  }

  .raza-footer__logo-block {
    max-width: 280px;
  }

  .raza-footer__logo {
    display: block;
    width: 100%;
    height: auto;
  }

  .raza-footer__menus {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 5vw, 62px);
  }

  .raza-footer h2 {
    margin: 0;
    color: #ffffff;
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    line-height: 1.2;
  }

  .raza-footer__rule {
    display: block;
    width: 42px;
    height: 2px;
    margin: 16px 0 18px;
    background: var(--raza-gold);
  }

  .raza-footer__menu a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 7px;
    color: rgba(255, 255, 255, 0.86);
    text-decoration: none;
  }

  .raza-footer__newsletter p {
    max-width: 430px;
    margin: 0 0 24px;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.55;
  }

  .raza-footer__form {
    display: grid;
    grid-template-columns: 1fr auto;
    max-width: 470px;
    min-height: 56px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.18);
  }

  .raza-footer__form input,
  .raza-footer__form button {
    border: 0;
    font: inherit;
  }

  .raza-footer__form input {
    min-width: 0;
    padding: 0 22px;
    background: transparent;
    color: #ffffff;
  }

  .raza-footer__form button {
    padding: 0 28px;
    border-radius: 999px;
    background: linear-gradient(135deg, #f3d28e, #b98b45);
    color: #151009;
    cursor: pointer;
  }

  .raza-footer__features {
    display: grid;
    grid-template-columns: repeat(4, minmax(70px, 1fr));
    gap: 0;
    margin-top: 34px;
  }

  .raza-footer__feature {
    display: grid;
    gap: 8px;
    justify-items: center;
    padding-inline: 16px;
    color: rgba(255, 255, 255, 0.86);
    text-align: center;
    line-height: 1.25;
    border-inline-start: 1px solid rgba(255, 255, 255, 0.28);
  }

  .raza-footer__feature:first-child {
    border-inline-start: 0;
  }

  .raza-footer__feature-icon {
    color: var(--raza-gold);
    font-size: 1.8rem;
    line-height: 1;
  }

  .raza-footer__bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px;
    align-items: center;
    margin-top: 42px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.32);
    color: rgba(255, 255, 255, 0.84);
    font-size: 0.92rem;
  }

  .raza-footer__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .raza-footer__payment {
    width: 54px;
    height: auto;
  }

  @media screen and (max-width: 989px) {
    .raza-footer__main {
      grid-template-columns: 1fr;
    }

    .raza-footer__logo-block {
      max-width: 240px;
    }

    .raza-footer__bottom {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .raza-footer__payments {
      justify-content: center;
    }
  }

  @media screen and (max-width: 640px) {
    .raza-footer__inner {
      padding: 36px 22px 22px;
    }

    .raza-footer__menus,
    .raza-footer__features {
      grid-template-columns: 1fr;
    }

    .raza-footer__feature {
      grid-template-columns: 40px 1fr;
      justify-items: start;
      text-align: left;
      border-inline-start: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.18);
      padding: 14px 0;
    }

    .raza-footer__feature:first-child {
      border-top: 0;
    }

    .raza-footer__form {
      grid-template-columns: 1fr;
      border-radius: 28px;
    }

    .raza-footer__form input,
    .raza-footer__form button {
      min-height: 52px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Raza Gems custom footer",
  "class": "shopify-section--raza-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#031611" },
    { "type": "color", "id": "accent_color", "label": "Gold accent color", "default": "#d8b16a" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "text", "id": "orders_heading", "label": "Orders column heading", "default": "Orders & Help" },
    { "type": "text", "id": "company_heading", "label": "Company column heading", "default": "About Company" },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Sign Up to Newsletter" },
    { "type": "textarea", "id": "newsletter_text", "label": "Newsletter text", "default": "Be the first to know about new collections, exclusive offers and jewellery updates." },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Enter your email address..." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "country_text", "label": "Country/currency text", "default": "India (AED)" },
    { "type": "text", "id": "copyright_text", "label": "Copyright text", "default": "Copyright 2026 Raza Gems LLC. All Rights Reserved. Developed by AZi Solutions." }
  ],
  "blocks": [
    {
      "type": "logo_image",
      "name": "Logo image",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo image" }
      ]
    },
    {
      "type": "orders_link",
      "name": "Orders/help link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "FAQs" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "company_link",
      "name": "Company link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "About Us" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "feature",
      "name": "Trust feature",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "*" },
        { "type": "text", "id": "label", "label": "Label", "default": "Certified Quality" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Raza Gems custom footer",
      "blocks": [
        { "type": "logo_image" },
        { "type": "orders_link", "settings": { "label": "Contact" } },
        { "type": "orders_link", "settings": { "label": "Blog" } },
        { "type": "orders_link", "settings": { "label": "FAQ" } },
        { "type": "orders_link", "settings": { "label": "Payment Method" } },
        { "type": "orders_link", "settings": { "label": "Return and Exchange" } },
        { "type": "company_link", "settings": { "label": "About" } },
        { "type": "company_link", "settings": { "label": "Our Branch" } },
        { "type": "company_link", "settings": { "label": "Careers" } },
        { "type": "company_link", "settings": { "label": "Terms & Condition" } },
        { "type": "company_link", "settings": { "label": "Privacy Policy" } },
        { "type": "feature", "settings": { "icon": "*", "label": "Natural Gemstones" } },
        { "type": "feature", "settings": { "icon": "*", "label": "Certified Quality" } },
        { "type": "feature", "settings": { "icon": "*", "label": "Worldwide Shipping" } },
        { "type": "feature", "settings": { "icon": "*", "label": "Trusted by Thousands" } }
      ]
    }
  ]
}
{% endschema %}
