{% liquid
  assign footer_bg = section.settings.background_image
%}

<footer class="raza-footer" style="--raza-bg: {{ section.settings.background_color }}; --raza-gold: {{ section.settings.accent_color }}; --raza-text: {{ section.settings.text_color }};">
  {% if footer_bg != blank %}
    {{ footer_bg | image_url: width: 2400 | image_tag: class: 'raza-footer__bg', loading: 'lazy', widths: '750, 1100, 1500, 2000, 2400' }}
  {% endif %}

  <div class="raza-footer__shade"></div>

  <div class="raza-footer__inner page-width">
    <div class="raza-footer__main">
      <div class="raza-footer__brand">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 360 | image_tag: class: 'raza-footer__logo', loading: 'lazy' }}
        {% else %}
          <div class="raza-footer__mark" aria-hidden="true">
            <svg viewBox="0 0 64 48" role="presentation"><path d="M8 14 18 4h28l10 10-24 30L8 14Zm10 0h28M18 4l14 40L46 4M8 14h48" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/></svg>
          </div>
          <p class="raza-footer__name">{{ section.settings.brand_name }}</p>
          <p class="raza-footer__tagline">{{ section.settings.brand_tagline }}</p>
        {% endif %}

        {% if section.settings.script_text != blank %}
          <p class="raza-footer__script">{{ section.settings.script_text }}</p>
        {% endif %}

        <div class="raza-footer__contacts">
          {% if section.settings.hours_text != blank %}
            <div class="raza-footer__contact">
              <span class="raza-footer__icon" aria-hidden="true">⌚</span>
              <span>{{ section.settings.hours_text }}</span>
            </div>
          {% endif %}
          {% if section.settings.help_text != blank %}
            <div class="raza-footer__contact">
              <span class="raza-footer__icon" aria-hidden="true">☏</span>
              <span>{{ section.settings.help_text }}</span>
            </div>
          {% endif %}
          {% if section.settings.address_text != blank %}
            <div class="raza-footer__contact">
              <span class="raza-footer__icon" aria-hidden="true">⌖</span>
              <span>{{ section.settings.address_text }}</span>
            </div>
          {% endif %}
          {% if section.settings.phone_text != blank %}
            <a class="raza-footer__contact" href="tel:{{ section.settings.phone_text | remove: ' ' }}">
              <span class="raza-footer__icon" aria-hidden="true">☎</span>
              <span>{{ section.settings.phone_text }}</span>
            </a>
          {% endif %}
          {% if section.settings.email_text != blank %}
            <a class="raza-footer__contact" href="mailto:{{ section.settings.email_text }}">
              <span class="raza-footer__icon" aria-hidden="true">✉</span>
              <span>{{ section.settings.email_text }}</span>
            </a>
          {% endif %}
        </div>

        <div class="raza-footer__socials" aria-label="Social links">
          {% for block in section.blocks %}
            {% if block.type == 'social_link' and block.settings.url != blank %}
              <a class="raza-footer__social" href="{{ block.settings.url }}" {{ block.shopify_attributes }} aria-label="{{ block.settings.label }}" target="_blank" rel="noopener">
                {{ block.settings.label | slice: 0 | upcase }}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="raza-footer__menus">
        <div class="raza-footer__menu">
          <h2>{{ section.settings.orders_heading }}</h2>
          <span class="raza-footer__rule"></span>
          {% for block in section.blocks %}
            {% if block.type == 'orders_link' %}
              <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }} <span aria-hidden="true">›</span></a>
            {% endif %}
          {% endfor %}
        </div>

        <div class="raza-footer__menu">
          <h2>{{ section.settings.company_heading }}</h2>
          <span class="raza-footer__rule"></span>
          {% for block in section.blocks %}
            {% if block.type == 'company_link' %}
              <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }} <span aria-hidden="true">›</span></a>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="raza-footer__newsletter">
        <h2>{{ section.settings.newsletter_heading }}</h2>
        <span class="raza-footer__rule"></span>
        <p>{{ section.settings.newsletter_text }}</p>

        {% form 'customer', class: 'raza-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.email_placeholder }}"
            aria-label="{{ section.settings.email_placeholder }}"
            required
          >
          <button type="submit">{{ section.settings.button_label }} <span aria-hidden="true">→</span></button>
        {% endform %}

        <div class="raza-footer__features">
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
              <div class="raza-footer__feature" {{ block.shopify_attributes }}>
                <span class="raza-footer__feature-icon">{{ block.settings.icon }}</span>
                <span>{{ block.settings.label }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="raza-footer__bottom">
      <div class="raza-footer__country">{{ section.settings.country_text }}</div>
      <div class="raza-footer__copyright">{{ section.settings.copyright_text }}</div>
      <div class="raza-footer__payments">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag: class: 'raza-footer__payment' }}
        {% endfor %}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .raza-footer {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 0 100%, rgba(205, 166, 93, 0.22), transparent 28rem),
      radial-gradient(circle at 100% 0, rgba(205, 166, 93, 0.2), transparent 25rem),
      linear-gradient(135deg, #031611, var(--raza-bg));
    color: var(--raza-text);
  }

  .raza-footer__bg,
  .raza-footer__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .raza-footer__bg {
    object-fit: cover;
    opacity: 0.34;
  }

  .raza-footer__shade {
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0.48));
  }

  .raza-footer__inner {
    position: relative;
    z-index: 1;
    padding-block: 48px 24px;
  }

  .raza-footer__main {
    display: grid;
    grid-template-columns: minmax(260px, 1.35fr) minmax(320px, 1.55fr) minmax(280px, 1.45fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .raza-footer__brand {
    max-width: 360px;
  }

  .raza-footer__logo {
    max-width: min(260px, 100%);
    height: auto;
  }

  .raza-footer__mark {
    width: 72px;
    margin-inline: auto;
    color: var(--raza-gold);
  }

  .raza-footer__name {
    margin: 8px 0 0;
    color: #f5debc;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4vw, 3.3rem);
    letter-spacing: 0.16em;
    text-align: center;
  }

  .raza-footer__tagline {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.74rem;
    letter-spacing: 0.32em;
    text-align: center;
    text-transform: uppercase;
  }

  .raza-footer__script {
    margin: 22px 0 20px;
    color: var(--raza-gold);
    font-family: cursive;
    font-size: 1.45rem;
    line-height: 1.2;
  }

  .raza-footer__contacts {
    display: grid;
    gap: 13px;
  }

  .raza-footer__contact {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 14px;
    align-items: start;
    color: inherit;
    text-decoration: none;
    line-height: 1.35;
  }

  .raza-footer__icon {
    display: inline-grid;
    place-items: center;
    color: var(--raza-gold);
    font-size: 1.35rem;
    line-height: 1;
  }

  .raza-footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .raza-footer__social {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid color-mix(in srgb, var(--raza-gold) 75%, transparent);
    border-radius: 50%;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
  }

  .raza-footer__menus {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 5vw, 62px);
  }

  .raza-footer h2 {
    margin: 0;
    color: #ffffff;
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    line-height: 1.2;
  }

  .raza-footer__rule {
    display: block;
    width: 42px;
    height: 2px;
    margin: 16px 0 18px;
    background: var(--raza-gold);
  }

  .raza-footer__menu a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 7px;
    color: rgba(255, 255, 255, 0.86);
    text-decoration: none;
  }

  .raza-footer__newsletter p {
    max-width: 430px;
    margin: 0 0 24px;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.55;
  }

  .raza-footer__form {
    display: grid;
    grid-template-columns: 1fr auto;
    max-width: 470px;
    min-height: 56px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.18);
  }

  .raza-footer__form input,
  .raza-footer__form button {
    border: 0;
    font: inherit;
  }

  .raza-footer__form input {
    min-width: 0;
    padding: 0 22px;
    background: transparent;
    color: #ffffff;
  }

  .raza-footer__form button {
    padding: 0 28px;
    border-radius: 999px;
    background: linear-gradient(135deg, #f3d28e, #b98b45);
    color: #151009;
    cursor: pointer;
  }

  .raza-footer__features {
    display: grid;
    grid-template-columns: repeat(4, minmax(70px, 1fr));
    gap: 0;
    margin-top: 34px;
  }

  .raza-footer__feature {
    display: grid;
    gap: 8px;
    justify-items: center;
    padding-inline: 16px;
    color: rgba(255, 255, 255, 0.86);
    text-align: center;
    line-height: 1.25;
    border-inline-start: 1px solid rgba(255, 255, 255, 0.28);
  }

  .raza-footer__feature:first-child {
    border-inline-start: 0;
  }

  .raza-footer__feature-icon {
    color: var(--raza-gold);
    font-size: 1.8rem;
    line-height: 1;
  }

  .raza-footer__bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px;
    align-items: center;
    margin-top: 42px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.32);
    color: rgba(255, 255, 255, 0.84);
    font-size: 0.92rem;
  }

  .raza-footer__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .raza-footer__payment {
    width: 54px;
    height: auto;
  }

  @media screen and (max-width: 989px) {
    .raza-footer__main {
      grid-template-columns: 1fr;
    }

    .raza-footer__brand {
      max-width: none;
    }

    .raza-footer__bottom {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .raza-footer__payments {
      justify-content: center;
    }
  }

  @media screen and (max-width: 640px) {
    .raza-footer__inner {
      padding-block: 36px 22px;
    }

    .raza-footer__menus,
    .raza-footer__features {
      grid-template-columns: 1fr;
    }

    .raza-footer__feature {
      grid-template-columns: 40px 1fr;
      justify-items: start;
      text-align: left;
      border-inline-start: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.18);
      padding: 14px 0;
    }

    .raza-footer__feature:first-child {
      border-top: 0;
    }

    .raza-footer__form {
      grid-template-columns: 1fr;
      border-radius: 28px;
    }

    .raza-footer__form input {
      min-height: 52px;
    }

    .raza-footer__form button {
      min-height: 52px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Raza Gems custom footer",
  "class": "shopify-section--raza-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "RAZA GEMS" },
    { "type": "text", "id": "brand_tagline", "label": "Brand tagline", "default": "Natural Beauty, Timeless You" },
    { "type": "text", "id": "script_text", "label": "Script line", "default": "Beauty Beyond Borders" },
