<section class="gemstone-landing">
  <div class="gemstone-landing__inner">
    <div class="gemstone-landing__eyebrow">Explore Our Collection</div>
    <h1 class="gemstone-landing__title">Find Your Perfect Gem</h1>
    <div class="gemstone-landing__divider" aria-hidden="true"><span></span></div>
    <p class="gemstone-landing__subtitle">Natural Beauty <span>*</span> Certified Quality <span>*</span> Timeless Value</p>

    <div class="gemstone-landing__grid">
      <article class="gemstone-card gemstone-card--precious">
        <div class="gemstone-card__hero">
          <img
            src="https://cdn.shopify.com/s/files/1/1003/6353/4631/files/gemstone-1.webp?v=1789185890"
            alt="Precious gemstones"
            loading="eager"
            width="514"
            height="189"
          >
          <div class="gemstone-card__copy">
            <span class="gemstone-card__icon" aria-hidden="true">◇</span>
            <h2>Precious<br>Gemstones</h2>
            <p>Rare. Exquisite. Timeless.</p>
            <a href="/collections/precious" class="gemstone-card__round-link" aria-label="View precious gemstones">→</a>
          </div>
        </div>
        <div class="gemstone-card__body">
          <div class="gemstone-card__items">
            <a href="/collections/ruby">{% render 'gemstone-landing-item', image: 'mega-menu-precious-ruby.webp', title: 'Ruby' %}</a>
            <a href="/collections/emerald">{% render 'gemstone-landing-item', image: 'mega-menu-precious-emerald.webp', title: 'Emerald' %}</a>
            <a href="/collections/blue-sapphire">{% render 'gemstone-landing-item', image: 'mega-menu-precious-blue-sapphire.webp', title: 'Blue Sapphire' %}</a>
            <a href="/collections/yellow-sapphire">{% render 'gemstone-landing-item', image: 'mega-menu-precious-yellow-sapphire.webp', title: 'Yellow Sapphire' %}</a>
            <a href="/collections/pink-sapphire">{% render 'gemstone-landing-item', image: 'mega-menu-precious-pink-sapphire.webp', title: 'Pink Sapphire' %}</a>
            <a href="/collections/white-sapphire">{% render 'gemstone-landing-item', image: 'mega-menu-precious-white-sapphire.webp', title: 'White Sapphire' %}</a>
            <a href="/collections/diamond">{% render 'gemstone-landing-item', image: 'mega-menu-precious-diamond.webp', title: 'Diamond' %}</a>
          </div>
          <a class="gemstone-card__footer-link" href="/collections/precious">View All Precious Gemstones <span>→</span></a>
        </div>
      </article>

      <article class="gemstone-card gemstone-card--semi">
        <div class="gemstone-card__hero">
          <img
            src="https://cdn.shopify.com/s/files/1/1003/6353/4631/files/gemstone-2.webp?v=1789185890"
            alt="Semi-precious gemstones"
            loading="eager"
            width="514"
            height="189"
          >
          <div class="gemstone-card__copy">
            <span class="gemstone-card__icon" aria-hidden="true">♢</span>
            <h2>Semi-Precious<br>Gemstones</h2>
            <p>Colorful. Versatile. Unique.</p>
           
          </div>
        </div>
        <div class="gemstone-card__body">
          <div class="gemstone-card__items">
            <a href="/collections/amethyst">{% render 'gemstone-landing-item', image: 'mega-menu-semi-precious-amethyst.webp', title: 'Amethyst' %}</a>
            <a href="/collections/labradorite">{% render 'gemstone-landing-item', image: 'mega-menu-semi-precious-labradorite.webp', title: 'Labradorite' %}</a>
            <a href="/collections/topaz">{% render 'gemstone-landing-item', image: 'mega-menu-semi-precious-topaz.webp', title: 'Topaz' %}</a>
            <a href="/collections/citrine">{% render 'gemstone-landing-item', image: 'mega-menu-semi-precious-citrine.webp', title: 'Citrine' %}</a>
            <a href="/collections/carnelian">{% render 'gemstone-landing-item', image: 'mega-menu-semi-precious-carnelian.webp', title: 'Carnelian' %}</a>
            <a href="/collections/moonstone">{% render 'gemstone-landing-item', image: 'mega-menu-semi-precious-moonstone.webp', title: 'Moonstone' %}</a>
            <a href="/collections/rose-quartz">{% render 'gemstone-landing-item', image: 'mega-menu-semi-precious-rose-quartz.webp', title: 'Rose Quartz' %}</a>
            <a href="/collections/turquoise">{% render 'gemstone-landing-item', image: 'mega-menu-semi-precious-turquoise.webp', title: 'Turquoise' %}</a>
            <a href="/collections/peridot">{% render 'gemstone-landing-item', image: 'mega-menu-semi-precious-peridot.webp', title: 'Peridot' %}</a>
          </div>
          <a class="gemstone-card__footer-link" href="/collections/semi-precious">View All Semi-Precious Gemstones <span>→</span></a>
        </div>
      </article>

      <article class="gemstone-card gemstone-card--jewellery">
        <div class="gemstone-card__hero">
          <img
            src="https://cdn.shopify.com/s/files/1/1003/6353/4631/files/gamstone-3.webp?v=1789185890"
            alt="Gemstone jewellery"
            loading="eager"
            width="514"
            height="189"
          >
          <div class="gemstone-card__copy">
            <span class="gemstone-card__icon" aria-hidden="true">♔</span>
            <h2>Jewellery</h2>
            <p>Crafted to Celebrate You.</p>
          
          </div>
        </div>
        <div class="gemstone-card__body">
          <div class="gemstone-card__items gemstone-card__items--jewellery">
            <a href="/collections/rings">{% render 'gemstone-landing-item', image: 'mega-menu-jewellery-ring.webp', title: 'Rings' %}</a>
            <a href="/collections/earrings">{% render 'gemstone-landing-item', image: 'mega-menu-jewellery-earring.webp', title: 'Earrings' %}</a>
            <a href="/collections/pendants">{% render 'gemstone-landing-item', image: 'mega-menu-jewellery-pendant.webp', title: 'Pendants' %}</a>
            <a href="/collections/necklaces">{% render 'gemstone-landing-item', image: 'mega-menu-jewellery-pendant.webp', title: 'Necklaces' %}</a>
            <a href="/collections/bracelets">{% render 'gemstone-landing-item', image: 'mega-menu-jewellery-ring.webp', title: 'Bracelets' %}</a>
            <a href="/collections/sets">{% render 'gemstone-landing-item', image: 'mega-menu-jewellery-earring.webp', title: 'Sets' %}</a>
          </div>
          <a class="gemstone-card__footer-link" href="/collections/jewellery">View All Jewellery <span>→</span></a>
        </div>
      </article>
    </div>
  </div>
</section>

{% stylesheet %}
  .gemstone-landing {
    padding: 18px 22px 44px;
    background:
      radial-gradient(circle at 0 18%, rgb(160 124 74 / 0.13), transparent 20%),
      radial-gradient(circle at 100% 0, rgb(146 119 92 / 0.16), transparent 22%),
      linear-gradient(180deg, #fffaf2 0%, #fffdf9 58%, #f7f1e9 100%);
    color: #27221d;
    overflow: hidden;
  }

  .gemstone-landing__inner {
    width: min(100%, 1490px);
    margin: 0 auto;
  }

  .gemstone-landing__eyebrow {
    color: #a98243;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 6px;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  .gemstone-landing__title {
    margin: 4px 0 4px;
    font-family: var(--font-heading--family);
    font-size: clamp(32px, 4vw, 46px);
    font-weight: 700;
    line-height: 1;
    text-align: center;
  }

  .gemstone-landing__divider {
    display: flex;
    justify-content: center;
    margin: 8px 0;
  }

  .gemstone-landing__divider span {
    position: relative;
    display: block;
    width: 126px;
    height: 1px;
    background: #c9a460;
  }

  .gemstone-landing__divider span::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 10px;
    border: 1px solid #c9a460;
    background: #fffaf2;
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .gemstone-landing__subtitle {
    margin: 0 0 22px;
    color: #746a60;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
  }

  .gemstone-landing__subtitle span {
    margin: 0 8px;
    color: #b18b4d;
  }

  .gemstone-landing__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px;
  }

  .gemstone-card {
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    overflow: hidden;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 14px 36px rgb(80 62 44 / 0.16);
  }

  .gemstone-card__hero {
    position: relative;
    height: 240px;
    overflow: hidden;
  }

  .gemstone-card__hero img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gemstone-card__copy {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 55%;
    padding: 22px 28px;
    color: #fff;
  }

  .gemstone-card--jewellery .gemstone-card__copy {
    color: #1f1b17;
  }

  .gemstone-card__icon {
    margin-bottom: 10px;
    color: #b8944d;
    font-size: 32px;
    line-height: 1;
  }

  .gemstone-card__copy h2 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(28px, 2.4vw, 34px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: 0;
  }

  .gemstone-card__copy p {
    margin: 10px 0 14px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.3;
  }

  .gemstone-card__round-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    margin-top: auto;
    border: 1px solid #c49b51;
    border-radius: 50%;
    color: #c49b51;
    text-decoration: none;
  }

  .gemstone-card__body {
    display: grid;
    grid-template-rows: 1fr auto;
    padding: 22px 26px 14px;
  }

  .gemstone-card__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    row-gap: 18px;
    column-gap: 14px;
  }

  .gemstone-card__items a {
    color: #28231f;
    text-decoration: none;
  }

  .gemstone-landing-item {
    display: grid;
    justify-items: center;
    gap: 6px;
    min-width: 0;
    text-align: center;
  }

  .gemstone-landing-item__image {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #f7f4ef;
  }

  .gemstone-landing-item__image img {
    display: block;
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .gemstone-landing-item__title {
    max-width: 100%;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .gemstone-card__footer-link {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid #eee6dc;
    color: #a27a36;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
  }

  @media screen and (max-width: 1100px) {
    .gemstone-landing__grid {
      grid-template-columns: 1fr;
      max-width: 620px;
      margin: 0 auto;
    }
  }

  @media screen and (max-width: 640px) {
    .gemstone-landing {
      padding: 20px 14px 34px;
    }

    .gemstone-landing__eyebrow {
      font-size: 10px;
      letter-spacing: 3px;
    }

    .gemstone-landing__subtitle {
      font-size: 13px;
    }

    .gemstone-card__copy {
      width: 68%;
      padding: 18px;
    }

    .gemstone-card__hero {
      height: 210px;
    }

    .gemstone-card__copy h2 {
      font-size: 26px;
    }

    .gemstone-card__copy p {
      font-size: 13px;
    }

    .gemstone-card__body {
      padding: 18px 14px 14px;
    }

    .gemstone-card__items {
      column-gap: 8px;
    }

    .gemstone-landing-item__title {
      font-size: 12px;
    }
  }
{% endstylesheet %}

