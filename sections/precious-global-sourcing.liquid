{{ 'precious-page.css' | asset_url | stylesheet_tag }}

<section
  class="precious-origin"
  aria-label="{{ section.settings.aria_label | escape }}"
  style="--precious-origin-bg: url('{{ section.settings.background_image_url }}');"
>
  <div class="precious-origin__content">
    <p class="precious-origin__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p class="precious-origin__intro">{{ section.settings.subheading }}</p>

    <div class="precious-origin__grid">
      {% for block in section.blocks %}
        <article class="precious-origin-card" {{ block.shopify_attributes }}>
          <img src="{{ block.settings.image_url }}" alt="{{ block.settings.image_alt | escape }}" width="520" height="350" loading="lazy">
          <div class="precious-origin-card__copy">
            <h3>{{ block.settings.title }}</h3>
            <ul>
              {% assign locations = block.settings.locations | newline_to_br | split: '<br />' %}
              {% for location in locations %}
                {% assign location_text = location | strip %}
                {% if location_text != blank %}
                  <li>{{ location_text }}</li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Precious global sourcing",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Accessibility label", "default": "Global precious gemstone sourcing" },
    { "type": "text", "id": "background_image_url", "label": "Background image URL", "default": "https://cdn.shopify.com/s/files/1/1003/6353/4631/files/Precious-background-bottom.webp?v=1789367049" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sourced Globally" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Global Sourcing: Where Our Precious Gems Originate" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "From the world's most renowned regions, to your hands." }
  ],
  "blocks": [
    {
      "type": "origin_card",
      "name": "Origin card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Diamonds" },
        { "type": "text", "id": "image_url", "label": "Image URL", "default": "https://cdn.shopify.com/s/files/1/1003/6353/4631/files/Daimon-image-preceious-bottom.webp?v=1789366454" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Diamond" },
        { "type": "textarea", "id": "locations", "label": "Locations", "default": "South Africa\nBotswana\nRussia\nAustralia" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Precious global sourcing",
      "blocks": [
        { "type": "origin_card" },
        { "type": "origin_card", "settings": { "title": "Rubies", "image_url": "https://cdn.shopify.com/s/files/1/1003/6353/4631/files/Ruby-image-precious-bottom.webp?v=1789366454", "image_alt": "Ruby", "locations": "Myanmar (Burma)\nThailand\nMozambique\nSri Lanka" } },
        { "type": "origin_card", "settings": { "title": "Sapphires", "image_url": "https://cdn.shopify.com/s/files/1/1003/6353/4631/files/Blue-Shappire-precious-bottom.webp?v=1789366454", "image_alt": "Blue sapphire", "locations": "Sri Lanka (Ceylon)\nKashmir\nMyanmar\nMadagascar" } },
        { "type": "origin_card", "settings": { "title": "Emeralds", "image_url": "https://cdn.shopify.com/s/files/1/1003/6353/4631/files/Emerald-precious-bottom.webp?v=1789366454", "image_alt": "Emerald", "locations": "Colombia\nZambia\nBrazil" } }
      ]
    }
  ]
}
{% endschema %}
