{{ 'precious-page.css' | asset_url | stylesheet_tag }}

<section
  class="precious-faq"
  aria-label="{{ section.settings.aria_label | escape }}"
  data-precious-faq
>
  <div class="precious-faq__content" style="--precious-faq-bg: url('{{ section.settings.background_image_url }}');">
    <p class="precious-faq__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>

    <div class="precious-faq__list">
      {% for block in section.blocks %}
        <details class="precious-faq__item" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question }}</span>
          </summary>
          <div class="precious-faq__answer">
            {{ block.settings.answer }}
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (() => {
    document.querySelectorAll('[data-precious-faq]').forEach((faqSection) => {
      const faqItems = faqSection.querySelectorAll('.precious-faq__item');

      faqItems.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (!item.open) return;

          faqItems.forEach((otherItem) => {
            if (otherItem !== item) {
              otherItem.open = false;
            }
          });
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Precious FAQ",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Accessibility label", "default": "Precious stones frequently asked questions" },
    { "type": "text", "id": "background_image_url", "label": "Background image URL", "default": "https://cdn.shopify.com/s/files/1/1003/6353/4631/files/FAQ-preceious-bottom-banner.webp?v=1789367691" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Frequently Asked Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Learn More About Precious Stones" },
    { "type": "checkbox", "id": "open_first", "label": "Open first FAQ by default", "default": true }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Which gems are classified as precious stones?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>The definitive classification of Precious Stones includes four primary minerals: <strong>Diamond, Ruby, Sapphire, and Emerald.</strong></p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Precious FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "How is the value of a precious stone determined?", "answer": "<p>Market value is determined by precise mineralogical criteria known as the <strong>4 Cs</strong>: carat weight, color, clarity, and cut.</p>" } },
        { "type": "faq", "settings": { "question": "How are precious stones geologically formed?", "answer": "<p>Precious stones are minerals formed through intense geological processes over millions of years.</p>" } }
      ]
    }
  ]
}
{% endschema %}
