<section class="about-raza" id="about-raza-{{ section.id }}">
  <div class="about-raza__hero" aria-labelledby="about-raza-title-{{ section.id }}">
    <div class="about-raza__hero-media" aria-hidden="true">
      {% if section.settings.hero_image != blank %}
        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag:
            class: 'about-raza__hero-image',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750, 1100, 1500, 2000, 2400',
            sizes: '100vw',
            alt: section.settings.hero_image_alt
        }}
      {% elsif section.settings.hero_image_url != blank %}
        <img
          src="{{ section.settings.hero_image_url | escape }}"
          alt="{{ section.settings.hero_image_alt | escape }}"
          class="about-raza__hero-image"
          width="1905"
          height="640"
          loading="eager"
          fetchpriority="high"
        >
      {% endif %}
    </div>

    <div class="about-raza__hero-content">
     

      {% if section.settings.eyebrow != blank %}
        <p class="about-raza__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.hero_heading != blank %}
        <h1 id="about-raza-title-{{ section.id }}" class="about-raza__hero-heading">
          {{ section.settings.hero_heading }}
        </h1>
      {% endif %}

      {% if section.settings.hero_text != blank %}
        <div class="about-raza__hero-text">{{ section.settings.hero_text }}</div>
      {% endif %}

      <div class="about-raza__feature-row">
        {% for block in section.blocks %}
          {% if block.type == 'hero_feature' %}
            <div class="about-raza__feature" {{ block.shopify_attributes }}>
              <span class="about-raza__icon about-raza__icon--plain" aria-hidden="true">
                {% render 'about-raza-icon', icon: block.settings.icon %}
              </span>
              <strong>{{ block.settings.title }}</strong>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="about-raza__body">
    <section class="about-raza__story" aria-labelledby="about-raza-story-title-{{ section.id }}">
      <div class="about-raza__story-copy">
        {% if section.settings.story_eyebrow != blank %}
          <p class="about-raza__section-kicker">{{ section.settings.story_eyebrow }}</p>
        {% endif %}

        {% if section.settings.story_heading != blank %}
          <h2 id="about-raza-story-title-{{ section.id }}">{{ section.settings.story_heading }}</h2>
        {% endif %}

        {% if section.settings.story_text != blank %}
          <div class="about-raza__rte">{{ section.settings.story_text }}</div>
        {% endif %}

        {% if section.settings.quote_text != blank %}
          <figure class="about-raza__quote">
            <blockquote>{{ section.settings.quote_text }}</blockquote>
            {% if section.settings.quote_author != blank %}
              <figcaption>{{ section.settings.quote_author }}</figcaption>
            {% endif %}
          </figure>
        {% endif %}
      </div>

      <div class="about-raza__story-image-wrap">
        {% if section.settings.story_image != blank %}
          {{
            section.settings.story_image
            | image_url: width: 1000
            | image_tag:
              class: 'about-raza__story-image',
              loading: 'lazy',
              widths: '480, 720, 900, 1000',
              sizes: '(min-width: 990px) 44vw, 100vw',
              alt: section.settings.story_image_alt
          }}
        {% elsif section.settings.story_image_url != blank %}
          <img
            src="{{ section.settings.story_image_url | escape }}"
            alt="{{ section.settings.story_image_alt | escape }}"
            class="about-raza__story-image"
            width="900"
            height="620"
            loading="lazy"
          >
        {% endif %}
      </div>
    </section>

    <section class="about-raza__commitment" aria-labelledby="about-raza-commitment-title-{{ section.id }}">
      <div class="about-raza__center-head">
        {% if section.settings.commitment_eyebrow != blank %}
          <p class="about-raza__section-kicker">{{ section.settings.commitment_eyebrow }}</p>
        {% endif %}
        {% if section.settings.commitment_heading != blank %}
          <h2 id="about-raza-commitment-title-{{ section.id }}">{{ section.settings.commitment_heading }}</h2>
        {% endif %}
      </div>

      <div class="about-raza__commitment-grid">
        {% for block in section.blocks %}
          {% if block.type == 'commitment_card' %}
            <article class="about-raza__commitment-card" {{ block.shopify_attributes }}>
              <span class="about-raza__icon" aria-hidden="true">
                {% render 'about-raza-icon', icon: block.settings.icon %}
              </span>
              <h3>{{ block.settings.title }}</h3>
              <div>{{ block.settings.text }}</div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>

    <section class="about-raza__offerings" aria-labelledby="about-raza-offerings-title-{{ section.id }}">
      <div class="about-raza__offerings-head">
        {% if section.settings.offerings_eyebrow != blank %}
          <p class="about-raza__section-kicker">{{ section.settings.offerings_eyebrow }}</p>
        {% endif %}
        {% if section.settings.offerings_heading != blank %}
          <h2 id="about-raza-offerings-title-{{ section.id }}">{{ section.settings.offerings_heading }}</h2>
        {% endif %}
        {% if section.settings.offerings_text != blank %}
          <div class="about-raza__rte">{{ section.settings.offerings_text }}</div>
        {% endif %}
      </div>

      <div class="about-raza__offering-grid">
        {% for block in section.blocks %}
          {% if block.type == 'offering' %}
            <article class="about-raza__offering" {{ block.shopify_attributes }}>
              <div class="about-raza__offering-image-wrap">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 480
                    | image_tag:
                      class: 'about-raza__offering-image',
                      loading: 'lazy',
                      widths: '240, 360, 480',
                      sizes: '(min-width: 750px) 160px, 35vw',
                      alt: block.settings.image_alt
                  }}
                {% elsif block.settings.image_url != blank %}
                  <img src="{{ block.settings.image_url | escape }}" alt="{{ block.settings.image_alt | escape }}" class="about-raza__offering-image" width="320" height="220" loading="lazy">
                {% endif %}
              </div>
              <div>
                <h3>{{ block.settings.title }}</h3>
                <div class="about-raza__rte">{{ block.settings.text }}</div>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  </div>

  <section class="about-raza__quality" aria-labelledby="about-raza-quality-title-{{ section.id }}">
    <div class="about-raza__quality-inner">
      <div class="about-raza__quality-copy">
        {% if section.settings.quality_heading != blank %}
          <h2 id="about-raza-quality-title-{{ section.id }}">{{ section.settings.quality_heading }}</h2>
        {% endif %}
        {% if section.settings.quality_text != blank %}
          <div class="about-raza__rte">{{ section.settings.quality_text }}</div>
        {% endif %}
        {% if section.settings.contact_email != blank %}
          <a class="about-raza__email" href="mailto:{{ section.settings.contact_email | escape }}">
            {{ section.settings.contact_label }} {{ section.settings.contact_email }}
          </a>
        {% endif %}
      </div>

      <div class="about-raza__steps">
        {% for block in section.blocks %}
          {% if block.type == 'quality_step' %}
            <article class="about-raza__step" {{ block.shopify_attributes }}>
              <span class="about-raza__icon" aria-hidden="true">
                {% render 'about-raza-icon', icon: block.settings.icon %}
              </span>
              <div>
                <small>{{ block.settings.number }}</small>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
</section>

<style>
  .about-raza {
    --about-navy: #07172e;
    --about-gold: #b98612;
    --about-muted: #4f5664;
    --about-cream: #fffaf0;
    color: var(--about-navy);
    background: #fffdf8;
    font-family: Jost, sans-serif;
    overflow-x: hidden;
    overflow-wrap: break-word;
  }

  .about-raza *,
  .about-raza *::before,
  .about-raza *::after {
    box-sizing: border-box;
  }

  .about-raza__hero {
    position: relative;
    min-height: clamp(440px, 42vw, 650px);
    overflow: hidden;
    background: #f7f1e7;
  }

  .about-raza__hero-media {
    position: absolute;
    inset: 0;
  }

  .about-raza__hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .about-raza__hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(255, 253, 248, 0.98) 0%, rgba(255, 253, 248, 0.9) 39%, rgba(255, 253, 248, 0.36) 69%, rgba(255, 253, 248, 0.05) 100%);
  }

  .about-raza__hero-content,
  .about-raza__body,
  .about-raza__quality-inner {
    width: min(100%, 1420px);
    margin: 0 auto;
    padding-inline: clamp(18px, 5vw, 80px);
  }

  .about-raza__hero-content {
    position: relative;
    z-index: 2;
    min-height: inherit;
    padding-top: clamp(34px, 4.8vw, 72px);
    padding-bottom: clamp(38px, 5vw, 76px);
  }

  .about-raza__breadcrumb {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: clamp(32px, 4vw, 64px);
    color: #333947;
    font-size: 14px;
    font-weight: 500;
  }

  .about-raza__breadcrumb span:last-child,
  .about-raza__eyebrow,
  .about-raza__section-kicker {
    color: var(--about-gold);
  }

  .about-raza__eyebrow,
  .about-raza__section-kicker {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 14px;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.18em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .about-raza__eyebrow::before,
  .about-raza__section-kicker::after {
    content: "";
    width: 42px;
    height: 1px;
    background: currentColor;
  }

  .about-raza__hero-heading,
  .about-raza h2 {
    margin: 0;
    color: var(--about-navy);
    font-family: Jost, sans-serif;
    font-weight: 900;
    letter-spacing: 0;
  }

  .about-raza__hero-heading {
    max-width: 760px;
    font-size: clamp(56px, 7vw, 112px);
    line-height: 0.94;
  }

  .about-raza__hero-heading em,
  .about-raza h2 em {
    color: var(--about-gold);
    font-style: normal;
  }

  .about-raza__hero-text {
    max-width: 680px;
    margin-top: 18px;
    color: #1f2735;
    font-size: clamp(18px, 1.7vw, 26px);
    line-height: 1.38;
  }

  .about-raza__hero-text p,
  .about-raza__rte p,
  .about-raza__commitment-card p,
  .about-raza__step p {
    margin: 0;
  }

  .about-raza__feature-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(130px, 1fr));
    gap: 24px;
    max-width: 920px;
    margin-top: clamp(34px, 4vw, 60px);
  }

  .about-raza__feature {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    align-items: center;
    gap: 16px;
  }

  .about-raza__feature strong {
    max-width: 120px;
    color: var(--about-navy);
    font-size: 13px;
    font-weight: 900;
    line-height: 1.18;
  }

  .about-raza__icon {
    display: grid;
    place-items: center;
    width: 70px;
    height: 70px;
    color: var(--about-gold);
    background: #f7edda;
    border-radius: 50%;
  }

  .about-raza__icon--plain {
    width: 42px;
    height: 42px;
    background: transparent;
  }

  .about-raza__icon svg {
    width: 38px;
    height: 38px;
    fill: currentColor;
  }

  .about-raza__icon--plain svg {
    width: 38px;
    height: 38px;
  }

  .about-raza__body {
    padding-top: clamp(48px, 6vw, 82px);
    padding-bottom: clamp(42px, 5vw, 70px);
  }

  .about-raza__story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.9fr);
    gap: clamp(36px, 6vw, 86px);
    align-items: center;
  }

  .about-raza h2 {
    font-size: clamp(32px, 3.6vw, 54px);
    line-height: 1.04;
  }

  .about-raza__rte {
    color: var(--about-muted);
    font-size: clamp(15px, 1.1vw, 18px);
    line-height: 1.58;
  }

  .about-raza__story .about-raza__rte {
    max-width: 620px;
    margin-top: 20px;
  }

  .about-raza__quote {
    max-width: 600px;
    margin: 28px 0 0;
    padding: 28px 32px;
    background: #fffaf0;
    border-radius: 8px;
    box-shadow: 0 10px 26px rgba(57, 39, 10, 0.05);
  }

  .about-raza__quote blockquote {
    margin: 0;
    color: #08162d;
    font-size: 15px;
    font-style: italic;
    font-weight: 600;
    line-height: 1.7;
  }

  .about-raza__quote::before {
    content: "\201C";
    display: block;
    height: 20px;
    color: var(--about-gold);
    font-size: 60px;
    font-weight: 900;
    line-height: 0.5;
  }

  .about-raza__quote figcaption {
    margin-top: 14px;
    color: #08162d;
    font-size: 13px;
    font-weight: 900;
  }

  .about-raza__story-image-wrap,
  .about-raza__offering-image-wrap {
    overflow: hidden;
    background: #f3eadb;
    border-radius: 8px;
  }

  .about-raza__story-image {
    width: 100%;
    aspect-ratio: 1.34;
    object-fit: cover;
  }

  .about-raza__commitment {
    padding-top: clamp(56px, 7vw, 94px);
  }

  .about-raza__center-head {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .about-raza__center-head .about-raza__section-kicker {
    justify-content: center;
  }

  .about-raza__center-head .about-raza__section-kicker::before {
    content: "";
    width: 42px;
    height: 1px;
    background: currentColor;
  }

  .about-raza__commitment-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 30px;
  }

  .about-raza__commitment-card {
    min-height: 220px;
    padding: 34px 28px;
    text-align: center;
    background: #fffaf2;
    border: 1px solid #f1e8d9;
    border-radius: 8px;
    box-shadow: 0 14px 34px rgba(56, 37, 9, 0.05);
  }

  .about-raza__commitment-card .about-raza__icon {
    margin: 0 auto 18px;
  }

  .about-raza h3 {
    margin: 0 0 12px;
    color: var(--about-navy);
    font-family: Jost, sans-serif;
    font-size: 18px;
    font-weight: 900;
    line-height: 1.2;
  }

  .about-raza__commitment-card div {
    color: var(--about-muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .about-raza__offerings {
    padding-top: clamp(56px, 7vw, 88px);
  }

  .about-raza__offerings-head {
    max-width: 760px;
  }

  .about-raza__offerings-head .about-raza__rte {
    margin-top: 12px;
  }

  .about-raza__offering-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(30px, 8vw, 110px);
    margin-top: 30px;
  }

  .about-raza__offering {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    min-width: 0;
  }

  .about-raza__offering-image {
    width: 100%;
    aspect-ratio: 1.55;
    object-fit: cover;
  }

  .about-raza__offering ul {
    margin: 0;
    padding-left: 20px;
  }

  .about-raza__offering li::marker {
    color: var(--about-gold);
  }

  .about-raza__quality {
    background: linear-gradient(90deg, #fff8eb, #fffdf8);
  }

  .about-raza__quality-inner {
    display: grid;
    grid-template-columns: minmax(260px, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(32px, 5vw, 76px);
    align-items: center;
    padding-top: clamp(38px, 5vw, 60px);
    padding-bottom: clamp(38px, 5vw, 60px);
  }

  .about-raza__quality-copy h2 {
    max-width: 430px;
  }

  .about-raza__quality-copy .about-raza__rte {
    max-width: 520px;
    margin-top: 16px;
  }

  .about-raza__email {
    display: inline-flex;
    margin-top: 18px;
    color: var(--about-gold);
    font-size: 14px;
    font-weight: 900;
    text-decoration: none;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .about-raza__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .about-raza__step {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .about-raza__step small {
    display: block;
    margin-bottom: 4px;
    color: var(--about-gold);
    font-weight: 900;
  }

  .about-raza__step h3 {
    margin-bottom: 8px;
    font-size: 16px;
  }

  .about-raza__step p {
    color: var(--about-muted);
    font-size: 13px;
    line-height: 1.52;
  }

  @media screen and (max-width: 1100px) {
    .about-raza__feature-row,
    .about-raza__commitment-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .about-raza__offering-grid {
      gap: 34px;
    }

    .about-raza__story,
    .about-raza__quality-inner {
      grid-template-columns: 1fr;
    }

    .about-raza__steps {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .about-raza__hero {
      min-height: auto;
    }

    .about-raza__hero::before {
      background: linear-gradient(180deg, rgba(255, 253, 248, 0.98) 0%, rgba(255, 253, 248, 0.92) 58%, rgba(255, 253, 248, 0.68) 100%);
    }

    .about-raza__hero-content {
      padding-top: 28px;
      padding-bottom: 42px;
    }

    .about-raza__breadcrumb {
      flex-wrap: wrap;
      margin-bottom: 24px;
      font-size: 13px;
    }

    .about-raza__eyebrow,
    .about-raza__section-kicker {
      gap: 10px;
      font-size: 11px;
      letter-spacing: 0.12em;
    }

    .about-raza__hero-heading {
      font-size: clamp(42px, 14vw, 58px);
      line-height: 0.98;
    }

    .about-raza h2 {
      font-size: clamp(28px, 9vw, 38px);
    }

    .about-raza__hero-text {
      font-size: 17px;
    }

    .about-raza__body {
      padding-top: 40px;
      padding-bottom: 40px;
    }

    .about-raza__feature-row,
    .about-raza__commitment-grid,
    .about-raza__offering-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .about-raza__feature {
      grid-template-columns: 38px minmax(0, 1fr);
      gap: 14px;
    }

    .about-raza__feature strong {
      max-width: none;
    }

    .about-raza__offering {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .about-raza__offering-image-wrap {
      max-width: 220px;
    }

    .about-raza__quote {
      padding: 22px;
    }

    .about-raza__icon {
      width: 58px;
      height: 58px;
    }

    .about-raza__icon svg {
      width: 30px;
      height: 30px;
    }

    .about-raza__steps {
      gap: 18px;
    }

    .about-raza__step {
      grid-template-columns: 58px minmax(0, 1fr);
      gap: 14px;
    }

    .about-raza__commitment-card {
      min-height: auto;
      padding: 26px 20px;
    }
  }

  @media screen and (max-width: 420px) {
    .about-raza__hero-content,
    .about-raza__body,
    .about-raza__quality-inner {
      padding-inline: 16px;
    }

    .about-raza__hero-heading {
      font-size: 40px;
    }

    .about-raza__offering-image-wrap {
      max-width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "About Raza Gems",
  "settings": [
    { "type": "text", "id": "breadcrumb_home", "label": "Breadcrumb home", "default": "Home" },
    { "type": "text", "id": "breadcrumb_current", "label": "Breadcrumb current", "default": "About Us" },
    { "type": "text", "id": "eyebrow", "label": "Hero eyebrow", "default": "About us" },
    { "type": "textarea", "id": "hero_heading", "label": "Hero heading", "default": "Raza <em>Gems</em>" },
    { "type": "richtext", "id": "hero_text", "label": "Hero text", "default": "<p>A legacy of trust, craftsmanship and brilliance in the heart of Dubai's global gemstone trade.</p>" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_image_url", "label": "Hero fallback image URL" },
    { "type": "text", "id": "hero_image_alt", "label": "Hero image alt text", "default": "Colorful gemstones on a jewellery workbench" },
    { "type": "text", "id": "story_eyebrow", "label": "Story eyebrow", "default": "The Raza story" },
    { "type": "textarea", "id": "story_heading", "label": "Story heading", "default": "Mir Mohammad Raza: Expertise <em>Since 2005</em>" },
    { "type": "richtext", "id": "story_text", "label": "Story text", "default": "<p>Our founder, Mir Mohammad Raza, has been intrinsically involved in the world of gemstones since 2005. His expertise spans the entire value chain, from negotiating rough acquisitions at the source to overseeing the precise cutting needed to maximize a stone's intrinsic beauty.</p>" },
    { "type": "textarea", "id": "quote_text", "label": "Quote text", "default": "We believe in transparency, quality, and long-term relationships, ensuring every gemstone we deliver tells a story of trust." },
