

{% capture submit_button %}
  {% content_for 'block', type: 'contact-form-submit-button', id: 'submit-button' %}
{% endcapture %}

<div
  class="contact-form spacing-style size-style"
  style="
    {% render 'spacing-style', settings: block.settings %}
    {% render 'size-style', settings: block.settings %}
    {% if block.settings.background_color != blank %}background-color: {{ block.settings.background_color }};{% endif %}
    {% if block.settings.input_style == 'custom' %}
      {% render 'input-custom-styles', block_settings: block.settings %}
      --style-border-width-inputs: {{ block.settings.border_width }}px;
      --style-border-radius-inputs: {{ block.settings.border_radius }}px;
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  {% assign form_id = block.id | default: section.id | prepend: 'ContactForm-' %}
  {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
    <input
      name="contact[id]"
      type="hidden"
      value="{{ form_id }}"
    >

    {% liquid
      assign form_matches = false
      if form.id == form_id or form.id == blank
        assign form_matches = true
      endif
    %}

    {%- if form.errors and form_matches -%}
      <div
        class="contact-form__notice contact-form__notice--error"
        role="alert"
        tabindex="-1"
        autofocus
      >
        <span class="contact-form__notice-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M12 3.5 2.5 20h19L12 3.5Zm0 5.4c.41 0 .75.34.75.75v4.55a.75.75 0 0 1-1.5 0V9.65c0-.41.34-.75.75-.75Zm0 8.95a.95.95 0 1 1 0-1.9.95.95 0 0 1 0 1.9Z" />
          </svg>
        </span>
        <span class="contact-form__notice-copy">
          <strong>Message could not be sent</strong>
          <span>Please try again.</span>
        </span>
        <button class="contact-form__notice-close" type="button" aria-label="Dismiss notification">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="m13.06 12 5.22-5.22a.75.75 0 0 0-1.06-1.06L12 10.94 6.78 5.72a.75.75 0 1 0-1.06 1.06L10.94 12l-5.22 5.22a.75.75 0 1 0 1.06 1.06L12 13.06l5.22 5.22a.75.75 0 0 0 1.06-1.06L13.06 12Z" />
          </svg>
        </button>
      </div>
    {%- endif -%}

    {%- if form.posted_successfully? and form_matches -%}
      <div
        class="contact-form__notice contact-form__notice--success"
        role="status"
        tabindex="-1"
        autofocus
      >
        <span class="contact-form__notice-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="m9.55 15.35-3.1-3.1a.9.9 0 1 0-1.27 1.27l3.74 3.74c.35.35.92.35 1.27 0l8.63-8.63a.9.9 0 0 0-1.27-1.27l-8 7.99Z" />
          </svg>
        </span>
        <span class="contact-form__notice-copy">
          <strong>Message sent successfully</strong>
          <span>We will get back to you soon.</span>
        </span>
        <button class="contact-form__notice-close" type="button" aria-label="Dismiss notification">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="m13.06 12 5.22-5.22a.75.75 0 0 0-1.06-1.06L12 10.94 6.78 5.72a.75.75 0 1 0-1.06 1.06L10.94 12l-5.22 5.22a.75.75 0 1 0 1.06 1.06L12 13.06l5.22 5.22a.75.75 0 0 0 1.06-1.06L13.06 12Z" />
          </svg>
        </button>
      </div>
    {%- endif -%}

    <div class="contact-form__form-row">
      <label
        class="visually-hidden"
        for="ContactForm-name"
      >
        {{- 'blocks.contact_form.name' | t -}}
      </label>
      <input
        type="text"
        id="ContactForm-name"
        class="contact-form__input"
        autocomplete="name"
        name="contact[name]"
        value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        placeholder="{{ 'blocks.contact_form.name' | t }}"
      >

      <label
        class="visually-hidden"
        for="ContactForm-email"
      >
        {{- 'blocks.contact_form.email' | t -}}
        <span aria-hidden="true">*</span></label
      >
      <input
        type="email"
        id="ContactForm-email"
        class="contact-form__input"
        autocomplete="email"
        name="contact[email]"
        spellcheck="false"
        autocapitalize="off"
        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
        aria-required="true"
        {% if form.errors contains 'email' and form_matches %}
          aria-invalid="true"
          aria-describedby="ContactForm-email-error"
        {% endif %}
        placeholder="{{ 'blocks.contact_form.email' | t }}"
      >
    </div>

    <label
      class="visually-hidden"
      for="ContactForm-phone"
    >
      {{- 'blocks.contact_form.phone' | t -}}
    </label>
    <input
      type="tel"
      id="ContactForm-phone"
      class="contact-form__input"
      autocomplete="tel"
      name="contact[phone]"
      pattern="[0-9\-]*"
      value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
      placeholder="{{ 'blocks.contact_form.phone' | t }}"
    >

    <label
      class="visually-hidden"
      for="ContactForm-body"
    >
      {{- 'blocks.contact_form.comment' | t -}}
    </label>
    <textarea
      rows="10"
      id="ContactForm-body"
      class="contact-form__input contact-form__input--textarea"
      name="contact[body]"
      placeholder="{{ 'blocks.contact_form.comment' | t }}"
    >
      {{- form.body -}}
    </textarea>

    {{ submit_button }}
  {%- endform -%}
</div>

{% stylesheet %}
  .contact-form__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .contact-form__form-row {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);

    @media screen and (min-width: 750px) {
      flex-direction: row;
      align-items: center;
    }
  }

  .contact-form__input {
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    padding: var(--padding-lg) var(--padding-xl);
    border-radius: var(--style-border-radius-inputs);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    -webkit-font-smoothing: antialiased;
  }

  .contact-form__input--textarea {
    resize: vertical;
    min-height: var(--input-textarea-min-height);
  }

  .contact-form__notice {
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: 90;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 34px;
    gap: 16px;
    align-items: center;
    width: min(calc(100vw - 32px), 640px);
    min-height: 104px;
    margin: 0;
    padding: 18px 20px 18px 34px;
    overflow: hidden;
    border: 1px solid;
    border-left-width: 5px;
    border-radius: 12px;
    box-shadow: 0 22px 60px rgba(39, 30, 20, 0.2);
    transform: translate(-50%, -50%);
  }

  .contact-form__notice[hidden] {
    display: none;
  }

  .contact-form__notice--success {
    color: #1f3421;
    background: linear-gradient(90deg, #f2fff4 0%, #fbfffb 100%);
    border-color: #bfe8c5;
    border-left-color: #15853a;
  }

  .contact-form__notice--error {
    color: #361f1d;
    background: linear-gradient(90deg, #fff6f4 0%, #fffafa 100%);
    border-color: #ffc8c0;
    border-left-color: #d62519;
  }

  .contact-form__notice-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
  }

  .contact-form__notice--success .contact-form__notice-icon {
    color: #15853a;
    background: #98d99e;
  }

  .contact-form__notice--error .contact-form__notice-icon {
    color: #d62519;
    background: #ffc3bc;
  }

  .contact-form__notice-icon svg {
    width: 34px;
    height: 34px;
    fill: currentColor;
  }

  .contact-form__notice-copy {
    display: grid;
    gap: 6px;
    min-width: 0;
  }

  .contact-form__notice-copy strong {
    color: #211a17;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(22px, 2vw, 30px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: 0;
  }

  .contact-form__notice-copy span {
    color: #6b6864;
    font-size: clamp(15px, 1.25vw, 21px);
    line-height: 1.3;
  }

  .contact-form__notice-close {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    color: #33302d;
    background: transparent;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .contact-form__notice-close:hover {
    background: rgba(33, 26, 23, 0.07);
  }

  .contact-form__notice-close svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  @media screen and (max-width: 749px) {
    .contact-form__notice {
      grid-template-columns: 48px minmax(0, 1fr) 30px;
      gap: 12px;
      min-height: 86px;
      padding: 16px 14px 16px 18px;
      border-radius: 10px;
    }

    .contact-form__notice-icon {
      width: 48px;
      height: 48px;
    }

    .contact-form__notice-icon svg {
      width: 27px;
      height: 27px;
    }

    .contact-form__notice-copy strong {
      font-size: 20px;
    }

    .contact-form__notice-copy span {
      font-size: 14px;
    }
  }
{% endstylesheet %}

<script>
  document.querySelectorAll('.contact-form__notice--success').forEach((notice) => {
    window.setTimeout(() => {
      notice.hidden = true;
    }, 2000);
  });

  if (window.location.search.includes('contact_posted=true')) {
    const cleanUrl = `${window.location.pathname}${window.location.hash}`;
    window.history.replaceState({}, document.title, cleanUrl);
  }

  document.addEventListener('click', (event) => {
    const closeButton = event.target.closest('.contact-form__notice-close');
    if (!closeButton) return;

    const notice = closeButton.closest('.contact-form__notice');
    if (notice) notice.hidden = true;
  });
</script>

{% schema %}
{
  "name": "t:names.contact_form",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.input"
    },
    {
      "type": "select",
      "id": "input_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "info": "t:info.edit_input_field_in_theme_settings"
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.background }}",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.foreground }}",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:settings.border_width",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.contact_form",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
