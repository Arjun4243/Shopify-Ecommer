{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gemstone-benefits-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 6% 52px;
    background: #fbfaf7;
    color: #333333;
  }

  .ai-gemstone-benefits-{{ ai_gen_id }}__inner {
    max-width: 1680px;
    margin: 0 auto;
  }

  .ai-gemstone-benefits-{{ ai_gen_id }}__header {
    display: grid;
    grid-template-columns: minmax(140px, 1fr) auto minmax(140px, 1fr);
    align-items: center;
    gap: clamp(28px, 4vw, 80px);
    margin: 0 auto 8px;
    text-align: center;
  }

  .ai-gemstone-benefits-{{ ai_gen_id }}__line {
    display: block;
    width: 100%;
    height: 2px;
    background: #dfcfad;
  }

  .ai-gemstone-benefits-{{ ai_gen_id }}__heading {
    margin: 0;
    color: #050505;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(28px, 2.2vw, 38px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0;
    text-align: center;
  }

  .ai-gemstone-benefits-{{ ai_gen_id }}__subtitle {
    max-width: 760px;
    margin: 0 auto 44px;
    color: #4f4a43;
    font-size: clamp(14px, 1vw, 20px);
    line-height: 1.45;
    text-align: center;
  }

  .ai-gemstone-benefits-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(22px, 2.1vw, 40px);
  }

  .ai-gemstone-benefits-{{ ai_gen_id }}__card {
    display: flex;
    min-width: 0;
    overflow: hidden;
    flex-direction: column;
    padding: 0;
    border: 1px solid #eee7dc;
    border-radius: 2px;
    background: #ffffff;
    box-shadow: 0 12px 30px rgba(31, 24, 18, 0.05);
  }

  .ai-gemstone-benefits-{{ ai_gen_id }}__media {
    overflow: hidden;
    margin: 0;
    aspect-ratio: 16 / 5.2;
    background: #e9e9e9;
  }

  .ai-gemstone-benefits-{{ ai_gen_id }}__media img,
  .ai-gemstone-benefits-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .ai-gemstone-benefits-{{ ai_gen_id }}__tag {
    margin: clamp(26px, 1.9vw, 34px) clamp(22px, 1.8vw, 34px) 8px;
    color: #71685f;
    font-size: clamp(11px, 0.72vw, 13px);
    font-weight: 700;
    letter-spacing: 2.2px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .ai-gemstone-benefits-{{ ai_gen_id }}__title {
    margin: 0 clamp(22px, 1.8vw, 34px) 14px;
    color: #050505;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(24px, 1.65vw, 32px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .ai-gemstone-benefits-{{ ai_gen_id }}__text {
    margin: 0 clamp(22px, 1.8vw, 34px) 24px;
    color: #38332e;
    font-size: clamp(15px, 1.05vw, 20px);
    line-height: 1.45;
  }

  .ai-gemstone-benefits-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: auto clamp(22px, 1.8vw, 34px) clamp(28px, 2vw, 38px);
    color: #b5802a;
    font-size: clamp(14px, 0.9vw, 17px);
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }

  .ai-gemstone-benefits-{{ ai_gen_id }}__link:hover,
  .ai-gemstone-benefits-{{ ai_gen_id }}__link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media screen and (max-width: 989px) {
    .ai-gemstone-benefits-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
      max-width: 640px;
      margin: 0 auto;
    }

    .ai-gemstone-benefits-{{ ai_gen_id }}__header {
      grid-template-columns: minmax(60px, 1fr) auto minmax(60px, 1fr);
      gap: 18px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-gemstone-benefits-{{ ai_gen_id }} {
      width: 100%;
      padding: 52px 18px 38px;
    }

    .ai-gemstone-benefits-{{ ai_gen_id }}__header {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .ai-gemstone-benefits-{{ ai_gen_id }}__line {
      width: 120px;
      margin: 0 auto;
    }

    .ai-gemstone-benefits-{{ ai_gen_id }}__subtitle {
      margin-bottom: 28px;
    }

    .ai-gemstone-benefits-{{ ai_gen_id }}__grid {
      gap: 18px;
    }

    .ai-gemstone-benefits-{{ ai_gen_id }}__media {
      aspect-ratio: 16 / 7;
    }

    .ai-gemstone-benefits-{{ ai_gen_id }}__title {
      font-size: clamp(23px, 7vw, 28px);
    }
  }
{% endstyle %}

<section class="ai-gemstone-benefits-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-gemstone-benefits-{{ ai_gen_id }}__inner">
    <div class="ai-gemstone-benefits-{{ ai_gen_id }}__header">
      <span class="ai-gemstone-benefits-{{ ai_gen_id }}__line" aria-hidden="true"></span>
      <h2 class="ai-gemstone-benefits-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      <span class="ai-gemstone-benefits-{{ ai_gen_id }}__line" aria-hidden="true"></span>
    </div>

    <p class="ai-gemstone-benefits-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle | escape }}</p>

    <div class="ai-gemstone-benefits-{{ ai_gen_id }}__grid">
      {% for i in (1..3) %}
        {% assign image_key = 'image_' | append: i %}
        {% assign kicker_key = 'kicker_' | append: i %}
        {% assign title_key = 'title_' | append: i %}
        {% assign description_key = 'description_' | append: i %}
        {% assign link_label_key = 'link_label_' | append: i %}
        {% assign link_key = 'link_' | append: i %}

        <article class="ai-gemstone-benefits-{{ ai_gen_id }}__card">
          <div class="ai-gemstone-benefits-{{ ai_gen_id }}__media">
            {% if block.settings[image_key] != blank %}
              <img
                src="{{ block.settings[image_key] | image_url: width: 1000 }}"
                alt="{{ block.settings[image_key].alt | default: block.settings[title_key] | escape }}"
                loading="lazy"
                width="1000"
                height="325"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </div>

          <p class="ai-gemstone-benefits-{{ ai_gen_id }}__tag">{{ block.settings[kicker_key] | escape }}</p>
          <h3 class="ai-gemstone-benefits-{{ ai_gen_id }}__title">{{ block.settings[title_key] | escape }}</h3>
          <p class="ai-gemstone-benefits-{{ ai_gen_id }}__text">{{ block.settings[description_key] | escape }}</p>

          {% if block.settings[link_label_key] != blank %}
            <a class="ai-gemstone-benefits-{{ ai_gen_id }}__link" href="{{ block.settings[link_key] | default: '#' }}">
              {{ block.settings[link_label_key] | escape }} &rarr;
            </a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

