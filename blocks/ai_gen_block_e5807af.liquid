{% doc %}
  @prompt
    
     look at this image and write the good prompt  to create this type of desing for to explain teh shopify aI
    Create a custom Liquid section in Shopify (e.g., gemstone-benefits.liquid) for the active page template (templates/page.semi-precious.json). Do not edit theme.liquid or global headers/footers.
    
    Design & Layout Requirements
    
    Section Header: Centered serif heading reading "Gemstone Benefits" flanked by subtle horizontal accent lines, followed by a smaller subtitle: "Discover the beauty, meaning and positive energy of natural gemstones".
    
    Grid Layout: 3-column responsive card layout on desktop, stacking into a single column on mobile.
    
    Card Structure (Top to Bottom):
    
    High-resolution featured image (aspect ratio ~16:9 or 3:2) with slightly rounded top corners.
    
    Small uppercase category tag/kicker (e.g., GEMSTONE GUIDE, WELLNESS, BUYING GUIDE) in muted grey text.
    
    Bold serif title (e.g., "The Calming Power of Amethyst").
    
    Muted body paragraph describing the topic in 2–3 sentences.
    
    Text link reading "Read More →" at the bottom left with a hover effect.
    
    Styling & Theme: Clean off-white/light grey card background (#F9F9F9 or similar), subtle border radius, generous internal padding, and clean typography matching a luxury jewelry brand aesthetic. Include dynamic section settings/blocks in Liquid so titles, text, links, and images can be customized from the Shopify Theme Editor.
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-gemstone-benefits-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;padding:{{ block.settings.vertical_padding }}px 24px;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }}}
.ai-gemstone-benefits-{{ ai_gen_id }}__inner{max-width:1280px;margin:0 auto}.ai-gemstone-benefits-{{ ai_gen_id }}__header{display:flex;align-items:center;gap:24px;justify-content:center;margin-bottom:12px}.ai-gemstone-benefits-{{ ai_gen_id }}__line{height:1px;flex:1;max-width:150px;background:{{ block.settings.accent_color }};opacity:.65}.ai-gemstone-benefits-{{ ai_gen_id }}__heading{margin:0;color:{{ block.settings.heading_color }};font-family:Georgia,'Times New Roman',serif;font-size:clamp(28px,4vw,48px);font-weight:400;line-height:1.15;text-align:center}.ai-gemstone-benefits-{{ ai_gen_id }}__subtitle{max-width:620px;margin:0 auto 42px;color:{{ block.settings.muted_color }};font-size:15px;line-height:1.7;text-align:center}.ai-gemstone-benefits-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.ai-gemstone-benefits-{{ ai_gen_id }}__card{display:flex;flex-direction:column;min-width:0;padding:14px 14px 22px;background:{{ block.settings.card_color }};border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.card_radius }}px}.ai-gemstone-benefits-{{ ai_gen_id }}__media{aspect-ratio:16/10;overflow:hidden;margin:-14px -14px 22px;border-radius:{{ block.settings.card_radius }}px {{ block.settings.card_radius }}px 0 0;background:#e9e9e9}.ai-gemstone-benefits-{{ ai_gen_id }}__media img,.ai-gemstone-benefits-{{ ai_gen_id }}__media svg{display:block;width:100%;height:100%;object-fit:cover}.ai-gemstone-benefits-{{ ai_gen_id }}__tag{margin:0 0 10px;color:{{ block.settings.muted_color }};font-size:11px;font-weight:600;letter-spacing:.14em;line-height:1.4;text-transform:uppercase}.ai-gemstone-benefits-{{ ai_gen_id }}__title{margin:0 0 12px;color:{{ block.settings.heading_color }};font-family:Georgia,'Times New Roman',serif;font-size:25px;font-weight:400;line-height:1.25}.ai-gemstone-benefits-{{ ai_gen_id }}__text{margin:0 0 24px;color:{{ block.settings.text_color }};font-size:14px;line-height:1.7}.ai-gemstone-benefits-{{ ai_gen_id }}__link{margin-top:auto;color:{{ block.settings.link_color }};font-size:14px;font-weight:600;text-decoration:none}.ai-gemstone-benefits-{{ ai_gen_id }}__link:hover,.ai-gemstone-benefits-{{ ai_gen_id }}__link:focus-visible{text-decoration:underline;text-underline-offset:4px}@media screen and (max-width:749px){.ai-gemstone-benefits-{{ ai_gen_id }}{padding-right:18px;padding-left:18px}.ai-gemstone-benefits-{{ ai_gen_id }}__header{gap:12px}.ai-gemstone-benefits-{{ ai_gen_id }}__line{max-width:50px}.ai-gemstone-benefits-{{ ai_gen_id }}__subtitle{margin-bottom:28px}.ai-gemstone-benefits-{{ ai_gen_id }}__grid{grid-template-columns:1fr;gap:18px}}
{% endstyle %}
<section class="ai-gemstone-benefits-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-gemstone-benefits-{{ ai_gen_id }}__inner"><div class="ai-gemstone-benefits-{{ ai_gen_id }}__header"><span class="ai-gemstone-benefits-{{ ai_gen_id }}__line" aria-hidden="true"></span><h2 class="ai-gemstone-benefits-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2><span class="ai-gemstone-benefits-{{ ai_gen_id }}__line" aria-hidden="true"></span></div><p class="ai-gemstone-benefits-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle | escape }}</p><div class="ai-gemstone-benefits-{{ ai_gen_id }}__grid">{% for i in (1..3) %}{% assign image_key='image_' | append:i %}{% assign kicker_key='kicker_' | append:i %}{% assign title_key='title_' | append:i %}{% assign description_key='description_' | append:i %}{% assign link_label_key='link_label_' | append:i %}{% assign link_key='link_' | append:i %}<article class="ai-gemstone-benefits-{{ ai_gen_id }}__card"><div class="ai-gemstone-benefits-{{ ai_gen_id }}__media">{% if block.settings[image_key] != blank %}<img src="{{ block.settings[image_key] | image_url: width: 1000 }}" alt="{{ block.settings[image_key].alt | default: block.settings[title_key] | escape }}" loading="lazy" width="1000" height="625">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div><p class="ai-gemstone-benefits-{{ ai_gen_id }}__tag">{{ block.settings[kicker_key] | escape }}</p><h3 class="ai-gemstone-benefits-{{ ai_gen_id }}__title">{{ block.settings[title_key] | escape }}</h3><p class="ai-gemstone-benefits-{{ ai_gen_id }}__text">{{ block.settings[description_key] | escape }}</p>{% if block.settings[link_key] != blank %}<a class="ai-gemstone-benefits-{{ ai_gen_id }}__link" href="{{ block.settings[link_key] }}">{{ block.settings[link_label_key] | escape }} →</a>{% endif %}</article>{% endfor %}</div></div></section>
{% schema %}{"name":"Gemstone benefits","tag":null,"class":"gemstone-benefits-block","settings":[{"type":"text","id":"heading","label":"Heading","default":"Gemstone Benefits"},{"type":"textarea","id":"subtitle","label":"Subtitle","default":"Discover the beauty, meaning and positive energy of natural gemstones"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"vertical_padding","label":"Vertical spacing","min":20,"max":100,"step":5,"unit":"px","default":60},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":24,"step":2,"unit":"px","default":8},{"type":"color","id":"background_color","label":"Background","default":"#FFFFFF"},{"type":"color","id":"card_color","label":"Card background","default":"#F9F9F9"},{"type":"color","id":"heading_color","label":"Heading","default":"#171717"},{"type":"color","id":"text_color","label":"Text","default":"#333333"},{"type":"color","id":"muted_color","label":"Muted text","default":"#666666"},{"type":"color","id":"accent_color","label":"Accent","default":"#A88745"},{"type":"color","id":"link_color","label":"Link","default":"#6D5122"},{"type":"color","id":"border_color","label":"Border","default":"#E2E2E2"},{"type":"header","content":"Card 1"},{"type":"image_picker","id":"image_1","label":"Image"},{"type":"text","id":"kicker_1","label":"Category","default":"GEMSTONE GUIDE"},{"type":"text","id":"title_1","label":"Title","default":"The calming power of amethyst"},{"type":"textarea","id":"description_1","label":"Description","default":"Explore the natural beauty and enduring meaning behind this captivating gemstone."},{"type":"text","id":"link_label_1","label":"Link label","default":"Read more"},{"type":"url","id":"link_1","label":"Link"},{"type":"header","content":"Card 2"},{"type":"image_picker","id":"image_2","label":"Image"},{"type":"text","id":"kicker_2","label":"Category","default":"WELLNESS"},{"type":"text","id":"title_2","label":"Title","default":"The meaning of natural stones"},{"type":"textarea","id":"description_2","label":"Description","default":"Learn how color, texture and origin give every gemstone its distinctive character."},{"type":"text","id":"link_label_2","label":"Link label","default":"Read more"},{"type":"url","id":"link_2","label":"Link"},{"type":"header","content":"Card 3"},{"type":"image_picker","id":"image_3","label":"Image"},{"type":"text","id":"kicker_3","label":"Category","default":"BUYING GUIDE"},{"type":"text","id":"title_3","label":"Title","default":"Choosing your perfect gemstone"},{"type":"textarea","id":"description_3","label":"Description","default":"A considered guide to selecting a stone that feels personal, beautiful and enduring."},{"type":"text","id":"link_label_3","label":"Link label","default":"Read more"},{"type":"url","id":"link_3","label":"Link"}],"presets":[{"name":"Gemstone benefits"}]}{% endschema %}